---
const {
  role,
  personId,
  centerId = "northfield",
  centerScoped = true,
  mode = "navigation"
} = Astro.props;
const isSettings = mode === "settings";
---
{isSettings ? (
  <section
    class="center-language-setting"
    data-cognit-language-controls
    data-role={role}
    data-person-id={personId}
    data-center-id={centerId}
    data-center-scoped={String(centerScoped)}
    aria-labelledby={`language-${centerId}-settings-heading`}
  >
    <div class="setting-heading">
      <div>
        <p class="eyebrow" data-i18n="language.center.eyebrow">Local language setting</p>
        <h2 id={`language-${centerId}-settings-heading`} data-i18n="language.center.heading">Demo language availability</h2>
      </div>
      <span class="ownership-tag" data-i18n="language.center.ownership">Center setting</span>
    </div>
    <label class="language-toggle">
      <input type="checkbox" data-center-spanish-enable checked />
      <span data-i18n="language.center.spanish">Enable Spanish for this Center</span>
    </label>
    <p data-i18n="language.center.allowance">Spanish is the additional Demo language available for this Center.</p>
  </section>
) : (
  <div
    class="language-navigation-control"
    data-cognit-language-controls
    data-role={role}
    data-person-id={personId}
    data-center-id={centerId}
    data-center-scoped={String(centerScoped)}
  >
    <label>
      <span data-i18n="language.control.label">Language</span>
      <select data-language-select data-i18n-aria-label="language.control.label">
        <option value="en-US">English</option>
        <option value="es-US">Español</option>
      </select>
    </label>
    <p class="language-status" role="status" data-language-disabled-notice hidden data-i18n="language.disabledNotice">Spanish is saved, but this Center currently uses English.</p>
    <p class="language-status" role="status" data-language-fallback-notice hidden data-i18n="language.fallbackNotice">Some content is shown in English as a fallback.</p>
  </div>
)}
<script>
  import { initializeCognitLocalization } from "../../demo/cognit-localization.js";
  document.querySelectorAll("[data-cognit-language-controls]").forEach(initializeCognitLocalization);
</script>
<style>
  .language-navigation-control{position:relative;flex:0 0 auto}.language-navigation-control label{display:flex;align-items:center;gap:7px;color:var(--color-muted);font-size:.72rem;font-weight:950;text-transform:uppercase}.language-navigation-control select{min-width:108px;min-height:44px;padding:8px 32px 8px 10px;border:1px solid var(--color-border);border-radius:9px;background:#fff;color:var(--color-ink);font:inherit;font-size:.88rem;font-weight:850;text-transform:none}.language-navigation-control select:focus-visible{outline:3px solid var(--color-blue);outline-offset:2px}.language-status{position:absolute;right:0;top:calc(100% + 9px);z-index:30;width:min(320px,calc(100vw - 32px));margin:0;padding:9px 11px;border:1px solid #e5bd65;border-radius:8px;background:#fff8e8;box-shadow:var(--shadow-card);color:var(--color-ink);font-size:.76rem;font-weight:750;line-height:1.35;text-transform:none}.language-status+.language-status:not([hidden]){top:calc(100% + 72px)}.center-language-setting{display:grid;gap:14px;padding:24px;border:1px solid var(--color-border);border-radius:14px;background:#fff;box-shadow:var(--shadow-soft)}.setting-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.setting-heading h2{margin:4px 0 0;color:var(--ink)}.center-language-setting>p{margin:0;color:#536579;line-height:1.55}.language-toggle{display:flex;align-items:center;gap:10px;width:fit-content;min-height:44px;padding:9px 12px;border:1px solid var(--color-border);border-radius:9px;color:var(--ink);font-weight:900}.language-toggle input{width:20px;height:20px;accent-color:var(--ink)}.ownership-tag{display:inline-flex;width:fit-content;padding:6px 9px;border-radius:999px;background:#dff7ee;color:#08785f;font-size:.68rem;font-weight:950}.eyebrow{margin:0;color:var(--color-muted);font-size:.72rem;font-weight:950;text-transform:uppercase}@media(max-width:1080px){.language-navigation-control{margin-left:auto}}@media(max-width:600px){.language-navigation-control label>span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.language-navigation-control select{min-width:116px;min-height:48px}.setting-heading{flex-direction:column}}
</style>
