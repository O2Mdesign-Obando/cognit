---
import { getCreativeAppLabProgressionProjection } from "../../demo/cognit-curriculum-progression.js";

const { perspective, view } = Astro.props;
const routeKey = `${perspective}:${view}`;
const isCourse = routeKey === "center:courses/creative-app-lab";
const isCenterReport = routeKey === "center:context/northfield/reports/eli";
const isCapture = routeKey === "coach:capture";
const isAfterClass = routeKey === "coach:after-class";
const isStudent = routeKey === "student:lesson";
const isFamilyJourney = routeKey === "family:journey/eli";
const isMessages = routeKey === "family:messages";
const curriculum = getCreativeAppLabProgressionProjection(isStudent ? "student" : "center");
---
<section class="connected" data-connected-demo data-route-key={routeKey} data-i18n-preserve>
  <header class="connected-heading">
    <div><span class="eyebrow" data-copy="eyebrow">Connected class month</span><h2 data-copy={isCourse ? "courseHeading" : isCapture ? "captureHeading" : isAfterClass ? "reportHeading" : isCenterReport ? "centerHeading" : isStudent ? "studentHeading" : isFamilyJourney ? "familyHeading" : "messageHeading"}></h2></div>
    <span class="review-badge" data-copy="pendingReview">Japanese and Hindi copy is drafted and pending qualified language review.</span>
  </header>

  {isCourse && <>
    <p data-copy="courseIntro"></p>
    <div class="module-sequence" aria-labelledby="connected-sequence-heading">
      <h3 id="connected-sequence-heading" data-copy="sequence"></h3>
      <ol>
        {curriculum.modules.map((module) => <li class:list={[module.completed && "done", module.teachingPosition && "active", !module.available && "locked"]} aria-current={module.teachingPosition ? "step" : undefined}>
          <span data-copy={module.completed ? "completedReference" : module.teachingPosition ? "currentTeaching" : module.available ? "availableNext" : "futureLocked"}></span>
          <b data-copy={`module${module.sequence}`}></b><code>{module.id}</code>
          {!module.available && <small data-copy="lockedCopy"></small>}
        </li>)}
      </ol>
    </div>
    <div class="three-column">
      <article><h3 data-copy="objective"></h3><p data-copy="objectiveCopy"></p></article>
      <article><h3 data-copy="activity"></h3><p data-copy="activityCopy"></p></article>
      <article><h3 data-copy="evidence"></h3><p data-copy="evidenceCopy"></p></article>
    </div>
  </>}

  {isCapture && <>
    <form class="capture-workspace" data-capture-form>
      <div class="capture-setup">
        <label><span data-copy="target"></span><select name="target" required><option value="" data-copy="choose"></option><option value="demo-student-eli-morgan" data-copy="eli"></option><option value="demo-student-lena-chen" data-copy="lena"></option><option value="whole-class" data-copy="wholeClass"></option></select></label>
        <fieldset class="capture-types"><legend data-copy="captureType"></legend><div class="segmented-controls"><button type="button" data-capture-type="photo" aria-pressed="true" data-copy="photo"></button><button type="button" data-capture-type="video" aria-pressed="false" data-copy="video"></button><button type="button" data-capture-type="audio" aria-pressed="false" data-copy="audio"></button></div></fieldset>
        <label><span data-copy="note"></span><textarea name="note" rows="4"></textarea></label>
        <button type="submit" data-copy="saveNote"></button><p class="inline-status" role="status" data-note-status hidden></p>
      </div>
      <section class="audio-panel" aria-labelledby="connected-audio-heading" data-audio-panel>
        <h3 id="connected-audio-heading" data-copy="audio"></h3><p data-copy="localOnly"></p>
        <div class="button-row"><button type="button" data-record data-copy="record" disabled></button><button type="button" data-stop data-copy="stop" disabled></button></div>
        <p class="inline-status" role="status" data-audio-status hidden></p>
      </section>
    </form>
    <section class="recent-captures"><div class="section-title"><h3 data-copy="captures"></h3><p data-copy="captureExamples"></p></div><div class="capture-list" data-capture-list></div></section>
  </>}

  {isAfterClass && <>
    <div class="report-transition"><strong data-copy="observationSource"></strong><p data-copy="reportIntro"></p></div><p class="boundary" data-copy="unsupported"></p>
    <div class="evidence-list" data-evidence-list></div>
    <div class="button-row"><button type="button" data-create-report data-copy="createDraft"></button><button type="button" data-review-report data-copy="reviewDraft"></button><button type="button" data-submit-report data-copy="submit"></button></div>
    <article class="report-card" data-report-card></article><p class="inline-status" role="status" data-report-status hidden></p>
  </>}

  {isCenterReport && <>
    <div class="rule-card"><h3 data-copy="rule"></h3><p data-copy="routineRule"></p><p data-copy="manualRule"></p><strong data-copy="eligibility"></strong></div>
    <article class="report-card" data-report-card></article>
    <div class="button-row"><button type="button" data-center-accept data-copy="accept"></button><button type="button" data-center-manual data-copy="requireManual"></button></div>
    <section><h3 data-copy="history"></h3><ol class="history" data-decision-history></ol></section>
  </>}

  {isStudent && <>
    <article class="student-context" data-current-module-id="creative-prototype">
      <div><span data-copy="currentTeaching"></span><h3 data-copy="module2"></h3><code>creative-prototype</code></div>
      <p><strong data-copy="nextAction"></strong>: <span data-copy="nextActionCopy"></span></p>
      <small data-copy="studentProgressContext"></small>
    </article>
  </>}

  {isFamilyJourney && <><article class="family-report" data-family-report></article><p class="boundary" data-copy="privacy"></p></>}

  {isMessages && <article class="message-card" data-message-card>
    <dl><div><dt data-copy="sender"></dt><dd data-message-sender></dd></div><div><dt data-copy="recipient"></dt><dd data-message-recipient></dd></div><div><dt data-copy="status"></dt><dd data-copy="drafted"></dd></div></dl>
    <p data-message-translation></p><button type="button" data-view-original data-copy="viewOriginal"></button>
    <div class="original-message" data-original-message hidden><strong data-copy="original"></strong><p data-message-original></p></div>
    <p class="boundary" data-copy="preferenceSafe"></p>
  </article>}
</section>

<script>
  import { focusedExpansionCopy } from "../../demo/cognit-focused-expansion-copy.js";
  import { CONNECTED_STATE_KEY, readConnectedState, writeConnectedState, reduceConnectedState, saveAudioBlob, loadAudioRecord, validateAudioBlob } from "../../demo/cognit-focused-expansion-state.js";

  const roots = document.querySelectorAll("[data-connected-demo]");
  const copyFor = (root) => focusedExpansionCopy[document.documentElement.dataset.contentLocale || "en-US"] || focusedExpansionCopy["en-US"];
  const labelStatus = (copy, status) => copy[status] || status;
  const setStatus = (node, value) => { if (node) { const key = Object.values(focusedExpansionCopy).flatMap((copy) => Object.entries(copy)).find(([, translated]) => translated === value)?.[0]; if (key) node.dataset.connectedStatusKey = key; else delete node.dataset.connectedStatusKey; node.textContent = value; node.hidden = !value; if (value) node.setAttribute("tabindex", "-1"); } };

  roots.forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.connectedReady) return;
    root.dataset.connectedReady = "true";
    let state = readConnectedState();
    let mediaRecorder;
    let stream;
    let chunks = [];
    const editingTranscripts = new Set();
    const audioObjectUrls = new Map();

    const targetLabel = (copy, target) => target === "whole-class" ? copy.wholeClass : target === "demo-student-lena-chen" ? copy.lena : copy.eli;
    const probeAudio = async (blob) => {
      const audio = document.createElement("audio");
      const supported = Boolean(audio.canPlayType(blob.type));
      if (!supported) return { supported: false, durationSeconds: 0 };
      const metadataDuration = await new Promise((resolve) => {
        const url = URL.createObjectURL(blob); let settled = false;
        const finish = (duration = 0) => { if (settled) return; settled = true; window.clearTimeout(timeout); audio.removeAttribute("src"); audio.load(); URL.revokeObjectURL(url); resolve(duration); };
        const timeout = window.setTimeout(() => finish(), 1800);
        audio.preload = "metadata";
        audio.addEventListener("loadedmetadata", () => finish(audio.duration), { once: true });
        audio.addEventListener("error", () => finish(), { once: true });
        audio.src = url;
      });
      if (Number.isFinite(metadataDuration) && metadataDuration > 0) return { supported, durationSeconds: metadataDuration };
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) throw new Error(copyFor(root).metadataTimeout);
      const context = new AudioContextClass();
      try { const decoded = await context.decodeAudioData(await blob.arrayBuffer()); return { supported, durationSeconds: decoded.duration }; }
      catch { throw new Error(copyFor(root).unplayable); }
      finally { await context.close(); }
    };

    const update = (action) => {
      state = reduceConnectedState(readConnectedState(), action);
      try { writeConnectedState(state); render(); return true; }
      catch (error) { setStatus(root.querySelector("[data-audio-status], [data-note-status], [data-report-status]"), error.message); return false; }
    };

    const renderCopy = () => {
      const copy = copyFor(root);
      root.querySelectorAll("[data-copy]").forEach((node) => { node.textContent = copy[node.getAttribute("data-copy")] || node.getAttribute("data-copy"); });
      root.querySelectorAll("[data-connected-status-key]").forEach((node) => { node.textContent = copy[node.dataset.connectedStatusKey] || node.textContent; });
      return copy;
    };

    const renderCaptures = (copy) => {
      const list = root.querySelector("[data-capture-list]");
      if (!list) return;
      audioObjectUrls.forEach((url) => URL.revokeObjectURL(url)); audioObjectUrls.clear();
      list.replaceChildren();
      state.evidence.forEach((evidence) => {
        const article = document.createElement("article"); article.className = "capture-card seeded-capture"; article.dataset.captureKind = evidence.kind;
        const badge = document.createElement("span"); badge.className = "capture-origin"; badge.textContent = copy.demoExample;
        const heading = document.createElement("h4"); heading.textContent = `${evidence.id} · ${evidence.kind} · ${evidence.label}`;
        const detail = document.createElement("p"); detail.textContent = copy.seededCaptureDetail;
        article.append(badge, heading, detail); list.append(article);
      });
      state.captures.forEach((capture) => {
        const article = document.createElement("article"); article.className = "capture-card";
        const badge = document.createElement("span"); badge.className = "capture-origin device-capture"; badge.textContent = copy.savedOnDevice;
        const heading = document.createElement("h4"); heading.textContent = `${capture.id} · ${targetLabel(copy, capture.target)} · audio-v${capture.audioVersion}`;
        const metadata = document.createElement("p"); metadata.className = "capture-metadata"; metadata.textContent = `${capture.mimeType || copy.unknownType} · ${capture.size ?? 0} ${copy.bytes} · ${copy.loadingMetadata}`;
        const audio = document.createElement("audio"); audio.controls = true; audio.preload = "metadata"; audio.setAttribute("aria-label", `${copy.originalAudio}: ${capture.id}`); audio.hidden = true;
        const audioStatus = document.createElement("p"); audioStatus.className = "capture-status"; audioStatus.setAttribute("role", "status"); audioStatus.textContent = copy.loadingAudio;
        const reopen = document.createElement("button"); reopen.type = "button"; reopen.className = "capture-action secondary"; reopen.textContent = copy.reopen; reopen.disabled = true;
        const attachAudio = async (play = false) => {
          try {
            const record = await loadAudioRecord(capture.id); if (!record?.blob) throw new Error(copy.missingAudio);
            const result = await validateAudioBlob(record.blob, probeAudio);
            const previous = audioObjectUrls.get(capture.id); if (previous) URL.revokeObjectURL(previous);
            const url = URL.createObjectURL(record.blob); audioObjectUrls.set(capture.id, url); audio.src = url; audio.hidden = false; reopen.disabled = false;
            metadata.textContent = `${result.mimeType} · ${result.size} ${copy.bytes} · ${result.durationSeconds.toFixed(1)} ${copy.seconds}`;
            audioStatus.textContent = copy.audioReady;
            if (play) await audio.play();
          } catch (error) { audio.hidden = true; reopen.disabled = true; metadata.textContent = `${capture.mimeType || copy.unknownType} · ${capture.size ?? 0} ${copy.bytes}`; audioStatus.textContent = `${copy.unusableAudio}: ${error.message}`; article.dataset.audioUsable = "false"; }
        };
        reopen.addEventListener("click", () => attachAudio(true));
        const simulate = document.createElement("button"); simulate.type = "button"; simulate.className = "capture-action"; simulate.textContent = copy.simulate;
        simulate.addEventListener("click", () => {
          const audioVersion = capture.audioVersion;
          update({ type: "SAVE_TRANSCRIPT", captureId: capture.id, audioVersion, text: "Simulation pending…", status: "simulated-pending" });
          window.setTimeout(() => {
            const latest = readConnectedState().captures.find((item) => item.id === capture.id);
            if (latest?.audioVersion === audioVersion && latest.transcript?.status === "simulated-pending") {
              state = reduceConnectedState(readConnectedState(), { type: "SAVE_TRANSCRIPT", captureId: capture.id, audioVersion, text: capture.target === "whole-class" ? copyFor(root).wholeClassTranscript : capture.target === "demo-student-lena-chen" ? copyFor(root).lenaTranscript : copyFor(root).eliTranscript, status: "simulated-unreviewed" });
              writeConnectedState(state); render();
            }
          }, 700);
        });
        const transcript = capture.transcript;
        const pending = transcript?.status === "simulated-pending";
        const unreviewed = transcript?.status === "simulated-unreviewed";
        simulate.hidden = Boolean(transcript); simulate.disabled = pending;
        const controls = document.createElement("div"); controls.className = "button-row capture-actions"; controls.append(reopen, simulate);
        const transcriptRegion = document.createElement("section"); transcriptRegion.className = "transcript-region";
        const status = document.createElement("small"); status.className = "transcript-status"; status.textContent = transcript ? `${labelStatus(copy, transcript.status)} · audio-v${transcript.audioVersion}` : copy.noTranscript;
        if (pending) {
          const pendingText = document.createElement("p"); pendingText.textContent = copy.simulationPending; transcriptRegion.append(pendingText);
        } else if (editingTranscripts.has(capture.id)) {
          const label = document.createElement("label"); label.textContent = copy.transcriptLabel;
          const textarea = document.createElement("textarea"); textarea.value = transcript?.text || ""; textarea.rows = 3;
          const save = document.createElement("button"); save.type = "button"; save.className = "capture-action"; save.textContent = copy.save;
          save.addEventListener("click", () => { editingTranscripts.delete(capture.id); update({ type: "SAVE_TRANSCRIPT", captureId: capture.id, audioVersion: capture.audioVersion, text: textarea.value, status: textarea.value === transcript?.text ? "coach-reviewed" : "coach-corrected" }); });
          const cancel = document.createElement("button"); cancel.type = "button"; cancel.className = "capture-action secondary"; cancel.textContent = copy.cancel;
          cancel.addEventListener("click", () => { editingTranscripts.delete(capture.id); render(); });
          const transcriptActions = document.createElement("div"); transcriptActions.className = "button-row"; transcriptActions.append(save, cancel);
          label.append(textarea); transcriptRegion.append(label, transcriptActions);
        } else if (transcript) {
          const text = document.createElement("p"); text.className = "transcript-text"; text.textContent = transcript.text;
          const edit = document.createElement("button"); edit.type = "button"; edit.className = "capture-action secondary"; edit.textContent = copy.edit;
          edit.addEventListener("click", () => { editingTranscripts.add(capture.id); render(); });
          const transcriptActions = document.createElement("div"); transcriptActions.className = "button-row"; transcriptActions.append(edit);
          if (unreviewed) {
            const confirm = document.createElement("button"); confirm.type = "button"; confirm.className = "capture-action"; confirm.textContent = copy.confirm;
            confirm.addEventListener("click", () => update({ type: "SAVE_TRANSCRIPT", captureId: capture.id, audioVersion: capture.audioVersion, text: transcript.text, status: "coach-reviewed" })); transcriptActions.append(confirm);
          }
          transcriptRegion.append(text, transcriptActions);
        }
        transcriptRegion.append(status); article.append(badge, heading, metadata, audio, audioStatus, controls, transcriptRegion); list.append(article); attachAudio(false);
      });
    };

    const currentReport = () => state.reports.find((report) => report.id === state.currentReportId) || null;
    const renderReport = (copy) => {
      const card = root.querySelector("[data-report-card]"); if (!card) return;
      const report = currentReport(); card.replaceChildren();
      if (!report) { card.textContent = copy.noDraft; root.querySelectorAll("[data-review-report], [data-submit-report], [data-center-accept], [data-center-manual]").forEach((button) => { button.disabled = true; }); return; }
      const stale = report.sourceRevision !== state.sourceRevision;
      const h = document.createElement("h3"); h.textContent = `${report.id} · ${labelStatus(copy, report.status)}`;
      const p = document.createElement("p"); p.textContent = report.text;
      const sources = document.createElement("p"); sources.textContent = `${copy.sourceIds}: ${report.sourceIds.join(", ")}`;
      const meta = document.createElement("p"); meta.textContent = `${report.rule === "manual" ? copy.manual : copy.routine} · source-revision ${report.sourceRevision}`;
      card.append(h, p, sources, meta);
      if (stale) { const warning = document.createElement("strong"); warning.textContent = copy.stale; card.append(warning); }
      const reviewButton = root.querySelector("[data-review-report]"); if (reviewButton) reviewButton.disabled = report.coachReviewed;
      const submitButton = root.querySelector("[data-submit-report]"); if (submitButton) submitButton.disabled = !report.coachReviewed || report.submitted;
      root.querySelectorAll("[data-center-accept], [data-center-manual]").forEach((button) => { button.disabled = !report.submitted || stale; });
    };

    const renderEvidence = (copy) => {
      const list = root.querySelector("[data-evidence-list]"); if (!list) return;
      list.replaceChildren(...state.evidence.map((item) => {
        const row = document.createElement("div"); row.className = "evidence-row";
        const text = document.createElement("span"); text.textContent = `${item.id} · ${item.kind} · ${item.label}`;
        const button = document.createElement("button"); button.type = "button"; button.textContent = item.reviewed ? copy.reviewed : copy.confirm; button.disabled = item.reviewed; button.addEventListener("click", () => update({ type: "REVIEW_EVIDENCE", id: item.id }));
        row.append(text, button); return row;
      }));
    };

    const renderHistory = (copy) => {
      const history = root.querySelector("[data-decision-history]"); if (!history) return; history.replaceChildren();
      if (!state.decisionHistory.length) { const li = document.createElement("li"); li.textContent = copy.noHistory; history.append(li); return; }
      [...state.decisionHistory].reverse().forEach((decision) => { const li = document.createElement("li"); li.textContent = `${decision.reportId || "report"} · ${labelStatus(copy, decision.type)} · ${decision.reason}`; history.append(li); });
    };

    const renderFamily = (copy) => {
      const card = root.querySelector("[data-family-report]"); if (!card) return;
      const report = state.reports.find((item) => item.id === state.acceptedReportId && item.status === "accepted" && item.sourceRevision === state.sourceRevision);
      card.replaceChildren();
      const h = document.createElement("h3"); h.textContent = report ? `${copy.accepted}: ${report.id}` : copy.noAccepted;
      const p = document.createElement("p"); p.textContent = report ? report.text : copy.noAcceptedCopy;
      card.append(h, p); if (report) { const small = document.createElement("small"); small.textContent = copy.acceptedCopy; card.append(small); }
    };

    const renderMessage = (copy) => {
      const message = state.messages[0]; const locale = document.documentElement.dataset.contentLocale || "en-US";
      const translated = message.translations[locale] || message.originalText;
      const set = (selector, value) => { const node = root.querySelector(selector); if (node) node.textContent = value; };
      set("[data-message-sender]", message.sender); set("[data-message-recipient]", message.recipient); set("[data-message-translation]", translated); set("[data-message-original]", message.originalText);
    };

    const renderCaptureType = () => {
      root.querySelectorAll("[data-capture-type]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.captureType === state.selectedCaptureType)));
      const record = root.querySelector("[data-record]"); if (record) record.disabled = state.selectedCaptureType !== "audio";
      root.querySelector("[data-audio-panel]")?.classList.toggle("selected", state.selectedCaptureType === "audio");
      root.querySelectorAll("[data-capture-kind]").forEach((card) => card.classList.toggle("selected", card.dataset.captureKind === state.selectedCaptureType));
    };
    const syncCaptureForm = () => {
      const form = root.querySelector("[data-capture-form]"); if (!(form instanceof HTMLFormElement)) return;
      form.elements.namedItem("target").value = state.selectedTarget;
      form.elements.namedItem("note").value = state.selectedTarget ? state.draftsByTarget?.[state.selectedTarget] || "" : "";
    };
    const render = () => { state = readConnectedState(); const copy = renderCopy(); renderCaptures(copy); renderEvidence(copy); renderReport(copy); renderHistory(copy); renderFamily(copy); renderMessage(copy); renderCaptureType(); syncCaptureForm(); };

    const form = root.querySelector("[data-capture-form]");
    if (form instanceof HTMLFormElement) {
      form.elements.namedItem("target").value = state.selectedTarget;
      form.elements.namedItem("target")?.addEventListener("change", (event) => update({ type: "SELECT_TARGET", target: event.currentTarget.value }));
      form.elements.namedItem("note")?.addEventListener("input", (event) => { const target = String(form.elements.namedItem("target")?.value || ""); if (!target) return; state = reduceConnectedState(readConnectedState(), { type: "DRAFT_NOTE", target, note: event.currentTarget.value }); try { localStorage.setItem(CONNECTED_STATE_KEY, JSON.stringify(state)); } catch (error) { setStatus(root.querySelector("[data-note-status]"), error.message); } });
      form.addEventListener("submit", (event) => { event.preventDefault(); if (!form.reportValidity()) return; const values = new FormData(form); const target = String(values.get("target") || ""); const ok = update({ type: "SELECT_TARGET", target }) && update({ type: "SAVE_NOTE", target, note: String(values.get("note") || "") }); setStatus(root.querySelector("[data-note-status]"), ok ? copyFor(root).saved : copyFor(root).failed); });
    }
    root.querySelectorAll("[data-capture-type]").forEach((button) => button.addEventListener("click", () => { update({ type: "SELECT_CAPTURE_TYPE", captureType: button.dataset.captureType }); renderCaptureType(); }));
    root.querySelector("[data-record]")?.addEventListener("click", async () => {
      const form = root.querySelector("[data-capture-form]"); if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
      const target = String(new FormData(form).get("target") || ""); update({ type: "SELECT_TARGET", target });
      const status = root.querySelector("[data-audio-status]");
      try {
        if (!navigator.mediaDevices?.getUserMedia || !globalThis.MediaRecorder) throw new Error(copyFor(root).unavailable);
        stream = await navigator.mediaDevices.getUserMedia({ audio: true }); chunks = []; mediaRecorder = new MediaRecorder(stream);
        mediaRecorder.addEventListener("dataavailable", (event) => { if (event.data.size) chunks.push(event.data); });
        mediaRecorder.addEventListener("stop", async () => {
          try {
            const blob = new Blob(chunks, { type: mediaRecorder.mimeType || "audio/webm" });
            const metadata = await validateAudioBlob(blob, probeAudio);
            const id = `audio-${Date.now()}`; await saveAudioBlob(id, blob, metadata);
            update({ type: "ADD_CAPTURE", capture: { id, target, audioVersion: 1, ...metadata, savedAt: new Date().toISOString(), transcript: null } });
            setStatus(status, copyFor(root).saved);
          } catch (error) { setStatus(status, error.message); }
          stream?.getTracks().forEach((track) => track.stop());
        });
        mediaRecorder.start(250); root.querySelector("[data-record]").disabled = true; root.querySelector("[data-stop]").disabled = false; setStatus(status, `${copyFor(root).record}…`);
      } catch (error) { setStatus(status, error.message); }
    });
    root.querySelector("[data-stop]")?.addEventListener("click", () => { if (mediaRecorder?.state === "recording") mediaRecorder.stop(); root.querySelector("[data-record]").disabled = false; root.querySelector("[data-stop]").disabled = true; });
    root.querySelector("[data-create-report]")?.addEventListener("click", () => update({ type: "CREATE_REPORT", rule: "routine", text: "Eli completed Frame the problem and is now prototyping the core flow. The reviewed sketch and Coach note support this progress summary." }));
    root.querySelector("[data-review-report]")?.addEventListener("click", () => { const report = currentReport(); if (report) update({ type: "REVIEW_REPORT", id: report.id }); });
    root.querySelector("[data-submit-report]")?.addEventListener("click", () => { const report = currentReport(); if (report) update({ type: "SUBMIT_REPORT", id: report.id }); });
    root.querySelector("[data-center-accept]")?.addEventListener("click", () => { const report = currentReport(); if (report) update({ type: "CENTER_DECIDE", id: report.id, decision: "accepted", reason: "Routine rule passed; Center explicitly accepted this exact version." }); });
    root.querySelector("[data-center-manual]")?.addEventListener("click", () => { const report = currentReport(); if (report) update({ type: "CENTER_DECIDE", id: report.id, decision: "manual", reason: "Evidence exception requires manual Center review." }); });
    root.querySelector("[data-view-original]")?.addEventListener("click", (event) => { const original = root.querySelector("[data-original-message]"); if (!(original instanceof HTMLElement)) return; original.hidden = !original.hidden; event.currentTarget.textContent = original.hidden ? copyFor(root).viewOriginal : copyFor(root).hideOriginal; });
    document.addEventListener("cognit:language-changed", render);
    globalThis.addEventListener("cognit:connected-state-changed", render);
    render();
  });
</script>

<style>
