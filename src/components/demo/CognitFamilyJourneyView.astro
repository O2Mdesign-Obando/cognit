---
import DemoLoopNav from "./DemoLoopNav.astro";
import DemoImage from "./DemoImage.astro";
import { getCognitDemoPerspectiveModel } from "../../demo/cognit-demo-model.js";
import { getDemoFamilyImage, getDemoStudentImage } from "../../demo/cognit-demo-images.js";

const { view = "overview" } = Astro.props;
const model = getCognitDemoPerspectiveModel("family");
const active = view.startsWith("journey") ? "journey" : view === "messages" ? "messages" : ["attendance", "absence", "absence-confirmed", "makeup"].some((key) => view.startsWith(key)) ? "attendance" : view === "courses" ? "courses" : view === "billing" ? "billing" : view === "support" ? "support" : view === "account" ? "account" : "overview";
const studentImage = getDemoStudentImage(model.student.id);
const familyImage = getDemoFamilyImage(model.family.id);
const isJourneyDetail = view === "journey/eli";
const isAbsenceConfirmation = view === "absence-confirmed";
---

<div class="family-demo" data-family-demo>
  <DemoLoopNav role="family" active={active} />

  <aside class="publication-sync publication-sync--held" data-center-publication-held>
    <div><span class="eyebrow">Same-event publication status</span><strong>Eli’s newest Center-reviewed update is still held.</strong></div>
    <p>Family continues to see the previously published Journey until Northfield Studio releases the new story.</p>
  </aside>
  <aside class="publication-sync publication-sync--published" data-center-published-event hidden>
    <div><span class="eyebrow">Same-event publication status</span><strong>Eli’s newest Center-reviewed update is now published.</strong></div>
    <p>The Student and Family views now reflect the same demo-local release event.</p>
  </aside>

  {view === "overview" && <>
    <section class="welcome hero-grid">
      <div><span class="eyebrow">Family home</span><h1>Welcome back, Morgan Family.</h1><p>Here is what changed for Eli, what comes next, and whether you need to act.</p></div>
      <div class="identity"><DemoImage image={familyImage} size="profile-lg" loading="eager" /><div><small>Signed in as</small><strong>Rachel Morgan</strong><span>1 authorized learner</span></div></div>
    </section>
    <section class="context-strip" aria-label="Authorized learner context"><span>Viewing for</span><button class="pill active" type="button">Eli Morgan</button><small>Only learners linked to this Family are shown.</small></section>
    <section class="journey-feature">
      <DemoImage image={studentImage} size="narrative-card" loading="eager" />
      <div><span class="eyebrow">Latest published Learning Journey · Creative App Lab</span><h2>{model.publishedStory}</h2><p>{model.update}</p><blockquote>Jordan Ellis: “{model.update}”</blockquote><a class="button" href="/learninghub/demo/family/journey/eli">View full Journey →</a></div>
    </section>
    <section class="card-grid two">
      <article class="card"><span class="eyebrow">Class enrollment status</span><h2>Creative App Lab</h2><p>Eli Morgan · Coach Jordan Ellis</p><dl><div><dt>Schedule</dt><dd>Today · 4:00–5:30 PM</dd></div><div><dt>Status</dt><dd>Active</dd></div></dl></article>
      <article class="card action-card"><span class="status good">No action needed</span><h2>You’re up to date</h2><p>Eli’s latest story is published and today’s attendance is present.</p><a href="/learninghub/demo/family/attendance">Review attendance →</a></article>
    </section>
    <section><div class="section-title"><div><span class="eyebrow">Messages and announcements</span><h2>Stay in the loop</h2></div><a href="/learninghub/demo/family/messages">Open inbox →</a></div><div class="card-grid two"><article class="card"><strong>Jordan Ellis</strong><h3>Eli’s next design test</h3><p>See the published update and what Eli will try next.</p></article><article class="card"><strong>Northfield Studio</strong><h3>Family showcase reminder</h3><p>Project sharing begins Saturday at 11:30 AM. No response is required.</p></article></div></section>
    <section><span class="eyebrow">Quick actions</span><div class="quick-actions"><a href="/learninghub/demo/family/messages">Message Coach</a><a href="/learninghub/demo/family/messages?conversation=center">Message Center</a><a href="/learninghub/demo/family/absence">Report absence</a><a href="/learninghub/demo/family/support">Ask a question</a></div></section>
  </>}

  {view === "journey" && <>
    <section class="page-heading"><span class="eyebrow">Learning Journey</span><h1>Eli’s published learning story</h1><p>A small history of visible milestones—not internal Coach drafts or review mechanics.</p></section>
    <section class="record-list">
      <a class="record featured" href="/learninghub/demo/family/journey/eli"><DemoImage image={studentImage} size="avatar-md" /><div><small>Latest · Creative App Lab</small><h2>{model.publishedStory}</h2><p>{model.update}</p></div><b>Open →</b></a>
      <article class="record"><div><small>Prior milestone · Creative App Lab</small><h2>Navigation ready for testing</h2><p>Eli connected the primary screen and navigation into one working flow.</p></div></article>
      <article class="record"><div><small>Earlier milestone · Creative App Lab</small><h2>A habit idea becomes a screen plan</h2><p>Eli mapped the core habit flow before beginning the prototype.</p></div></article>
    </section>
  </>}

  {isJourneyDetail && <>
    <section class="journey-cover"><DemoImage image={studentImage} size="narrative-card" loading="eager" /><div><span class="eyebrow">Published Family story · Creative App Lab</span><h1>{model.publishedStory}</h1><p>Eli Morgan · Coach Jordan Ellis</p></div></section>
    <section class="story-card"><span class="eyebrow">A note from Jordan</span><h2>Testing turned a first flow into a clearer experience.</h2><p>{model.update}</p><blockquote>“Eli built the core navigation independently, then revised one interaction after testing it with a classmate.”</blockquote></section>
    <section><div class="section-title"><div><span class="eyebrow">Memories</span><h2>Evidence translated for Family</h2></div></div><div class="memory-grid"><div class="artifact"><strong>Habit</strong><b>Today</b><span>✓</span></div><article class="card"><h3>Habit Tracker — interaction flow prototype</h3><p>A project artifact connected to this published learning story.</p></article></div></section>
    <section class="card-grid two"><article class="card"><span class="eyebrow">Student voice</span><h2>No reflection was published with this story</h2><p>Private or unfinished Student reflections are not exposed to Family.</p></article><article class="card"><span class="eyebrow">Narrative arc</span><h2>Plan → build → test → revise</h2><p>Eli moved from a screen plan to a working interaction and used feedback to improve it.</p></article></section>
    <section class="next-card"><span class="eyebrow">What comes next</span><h2>{model.student.name} will test one interaction and revise a confusing step.</h2><p>The next step remains attached to Creative App Lab.</p></section>
  </>}

  {view === "messages" && <>
    <section class="page-heading"><span class="eyebrow">Family messages</span><h1>Conversations about Eli</h1><p>Local synthetic threads. Replies are never delivered.</p></section>
    <section class="inbox">
      <aside><button class="conversation active" data-conversation="coach"><strong>Jordan Ellis</strong><span>Eli · Creative App Lab</span><small>2:45 PM</small></button><button class="conversation" data-conversation="center"><strong>Maya Chen</strong><span>Morgan Family · Northfield Studio</span><small>Yesterday</small></button></aside>
      <article class="thread"><header><div><strong data-thread-name>Jordan Ellis</strong><span data-thread-context>Regarding Eli Morgan · Creative App Lab</span></div><span class="status good">Demo thread</span></header><div class="message"><p data-thread-message>Eli’s published story is ready. He built the first navigation flow and revised an interaction after testing.</p><div class="attachment"><div class="artifact mini"><b>Habit</b><span>✓</span></div><span>Habit Tracker — published evidence preview</span></div></div><form data-reply-form><label for="family-reply">Reply</label><textarea id="family-reply" required placeholder="Write a demo-local reply…"></textarea><button class="button" type="submit">Save demo reply</button><p class="notice" data-reply-notice hidden>Saved in this browser demo — not delivered.</p></form></article>
    </section>
  </>}

  {(view === "attendance" || view === "attendance/eli" || view === "attendance/sofia") && <>
    <section class="page-heading"><span class="eyebrow">Attendance and makeup</span><h1>Understand status without operational complexity</h1><p>Family can report, view, and request. Center policy still determines makeup eligibility.</p></section>
    <section class="card-grid two"><article class="card"><div class="compact"><DemoImage image={studentImage} size="avatar-md" /><div><span class="eyebrow">Morgan Family</span><h2>Eli Morgan</h2></div></div><p><span class="status good">Present today</span> · Creative App Lab</p><div class="button-row"><a class="button" href="/learninghub/demo/family/absence">Report an absence</a></div></article><article class="card"><div class="compact"><DemoImage image={getDemoStudentImage(model.secondary.student.id)} size="avatar-md" /><div><span class="eyebrow">Separate authorized example</span><h2>Reyes Family · Sofia Reyes</h2></div></div><p>Prior Robotics Studio absence · 1 makeup available.</p><a href="/learninghub/demo/family/makeup">Open Reyes Family example →</a></article></section>
  </>}

  {(view === "absence" || isAbsenceConfirmation) && <section class="form-shell" data-absence-shell>
    <div class="page-heading"><span class="eyebrow">Demo-local absence report</span><h1>{isAbsenceConfirmation ? "Absence report prepared" : "Report an absence"}</h1><p>No production attendance or Center records are changed.</p></div>
    <div data-absence-form-view hidden={isAbsenceConfirmation}>
      <div class="identity-row"><DemoImage image={studentImage} size="avatar-sm" /><div><strong>Eli Morgan</strong><span>Creative App Lab · Today · 4:00–5:30 PM</span></div></div>
      <form data-absence-form><fieldset><legend>When will Eli be absent?</legend><div class="choice-row"><label><input type="radio" name="date-mode" value="Today" checked /> Today</label><label><input type="radio" name="date-mode" value="Future date" /> Future date</label><label><input type="radio" name="date-mode" value="Date range" /> Date range</label></div></fieldset><fieldset><legend>Reason</legend><div class="choice-row"><label><input type="radio" name="reason" value="Sick" checked /> Sick</label><label><input type="radio" name="reason" value="Travel" /> Travel</label><label><input type="radio" name="reason" value="Appointment" /> Appointment</label><label><input type="radio" name="reason" value="Other" /> Other</label></div></fieldset><label>Optional note for Northfield Studio<textarea name="note" placeholder="Add a demo-local note (optional)"></textarea></label><div class="button-row"><button class="button" type="submit">Submit absence report</button><a href="/learninghub/demo/family/attendance">Cancel</a></div></form>
    </div>
    <div class="confirmation" data-absence-confirmation hidden={!isAbsenceConfirmation}><div class="success-mark">✓</div><h2>Absence reported in this demo</h2><dl><div><dt>Learner/session</dt><dd>Eli Morgan · Creative App Lab</dd></div><div><dt>Date and reason</dt><dd><span data-confirm-date>Today</span> · <span data-confirm-reason>Sick</span></dd></div><div><dt>Center</dt><dd>Northfield Studio notified in demo-local simulation</dd></div><div><dt>Attendance</dt><dd>Recorded only in this browser demo</dd></div><div><dt>Makeup</dt><dd>Eligibility pending according to Center policy</dd></div></dl><article class="future-notice" data-future-notice><strong>Upcoming absence notice</strong><p>Eli Morgan · Creative App Lab · Next Friday · Family travel</p><button type="button" data-cancel-notice>Cancel notice</button></article><p class="notice" data-cancelled-notice hidden>Future demo notice cancelled locally.</p><a class="button" href="/learninghub/demo/family/attendance">Done</a></div>
  </section>}

  {view === "makeup" && <>
    <section class="page-heading"><span class="eyebrow">Separate Reyes Family example</span><h1>Sofia has 1 available makeup</h1><p>This example is not linked to Morgan Family. No expiration policy or scheduling is implied.</p></section><section class="card"><div class="compact"><DemoImage image={getDemoStudentImage(model.secondary.student.id)} size="avatar-md" /><div><h2>Robotics Studio</h2><p>Originating missed session · prior session</p></div><span class="status good">Available</span></div><dl><div><dt>Status</dt><dd>Available</dd></div><div><dt>Expiration</dt><dd>None defined</dd></div><div><dt>Next step</dt><dd>Contact Center to discuss options</dd></div></dl></section>
  </>}

  {view === "courses" && <>
    <section class="page-heading"><span class="eyebrow">Course discovery · Eli Morgan</span><h1>Explore bounded demo courses</h1><p>Schedules, seats, and prices are illustrative—not offers or operational inventory.</p></section>
    <section class="filters"><label>Season<select data-course-filter data-filter-kind="season"><option value="all">All demo seasons</option><option value="current">Current</option><option value="upcoming">Upcoming</option></select></label><label>Category<select data-course-filter data-filter-kind="category"><option value="all">All categories</option><option value="creative">Creative technology</option><option value="robotics">Robotics</option><option value="story">Storytelling</option></select></label><label>Day/time<select data-course-filter data-filter-kind="time"><option value="all">All times</option><option value="weekday">Weekday</option><option value="weekend">Weekend</option></select></label></section>
    <section class="catalog-grid"><article class="course-card" data-course-card data-season="current" data-category="creative" data-time="weekday"><span class="status good">Enrolled</span><h2>Creative App Lab</h2><p>Today · 4:00–5:30 PM · ongoing</p><strong>Illustrative demo price · $180/month</strong></article><article class="course-card" data-course-card data-season="upcoming" data-category="robotics" data-time="weekday"><span class="status">4 demo seats</span><h2>Robotics Studio</h2><p>Weekdays · 8-week demo session</p><strong>Illustrative demo price · $190/month</strong><button class="button" type="button" data-register="Robotics Studio">Prepare request</button></article><article class="course-card" data-course-card data-season="upcoming" data-category="story" data-time="weekend"><span class="status">6 demo seats</span><h2>Digital Storytelling Lab</h2><p>Saturday · 8-week demo session</p><strong>Illustrative demo price · $175/month</strong><button class="button" type="button" data-register="Digital Storytelling Lab">Prepare request</button></article><article class="course-card" data-course-card data-season="upcoming" data-category="creative" data-time="weekday"><span class="status">Discovery</span><h2>Creative Computing Foundations</h2><p>Weekdays · 6-week demo session</p><strong>Illustrative demo price · $165/month</strong><button class="button" type="button" data-register="Creative Computing Foundations">Prepare request</button></article></section>
    <dialog data-registration-dialog><button class="dialog-close" type="button" data-close-dialog aria-label="Close">×</button><span class="eyebrow">Demo registration shell</span><h2>Registration request prepared</h2><p><strong data-registration-course></strong> for Eli Morgan.</p><p>No enrollment, seat hold, or payment was created.</p><button class="button" type="button" data-close-dialog>Done</button></dialog>
  </>}

  {view === "billing" && <>
    <section class="page-heading"><span class="eyebrow">Synthetic billing shell</span><h1>Tuition and billing</h1><p>Presentation-only demo data. No real transaction, invoice, or payment method exists.</p></section>
    <section class="summary-grid"><article class="card"><span class="status good">Demo account current</span><h2>$180 / illustrative month</h2><p>Creative App Lab · Eli Morgan</p></article><article class="card"><span class="eyebrow">Next demo cycle</span><h2>Date not scheduled</h2><p>Billing rules are not defined for this synthetic demo.</p></article><article class="card"><span class="eyebrow">Payment display</span><h2>DEMO •••• 0000</h2><p>Non-transactional placeholder</p><button type="button" data-payment-shell>Update payment display</button></article></section>
    <section class="card"><div class="section-title"><h2>Illustrative payment history</h2><button type="button" data-receipt-shell>Download demo receipt</button></div><div class="table-wrap"><table><thead><tr><th>Demo period</th><th>Description</th><th>Amount</th><th>Status</th></tr></thead><tbody><tr><td>Current</td><td>Creative App Lab</td><td>$180.00</td><td>Simulated paid</td></tr><tr><td>Prior</td><td>Creative App Lab</td><td>$180.00</td><td>Simulated paid</td></tr></tbody></table></div><p class="notice" data-billing-notice hidden>Demo shell only — no payment details changed and no file was created.</p></section>
  </>}

  {view === "account" && <>
    <section class="page-heading"><span class="eyebrow">Family account</span><h1>Preferences and safe account shells</h1><p>Values are neutral demo placeholders and changes remain local.</p></section>
    <section class="card settings"><h2>Security</h2><div class="setting-row"><span><strong>Password</strong><small>••••••••••</small></span><button type="button" data-account-shell>Password shell</button></div><div class="setting-row"><span><strong>Email</strong><small>rachel@example.invalid</small></span><button type="button" data-account-shell>Email shell</button></div></section>
    <section class="card settings"><h2>Notifications</h2><label class="toggle"><input type="checkbox" data-preference="reminders" checked /> Session reminders</label><label class="toggle"><input type="checkbox" data-preference="learningUpdates" checked /> Published learning updates</label><label class="toggle"><input type="checkbox" data-preference="announcements" /> Center announcements</label><label>Language<select><option>English (US)</option><option>Español (demo)</option></select></label><p class="notice" data-account-notice>Preferences are stored only for this page session.</p></section>
  </>}

  {view === "support" && <>
    <section class="page-heading"><span class="eyebrow">Family Support Center</span><h1>How can we help?</h1><p>Search common questions or prepare a local demo request.</p></section>
    <section class="card"><form data-support-form><div class="form-grid"><label>Problem type<select required><option value="">Select a problem type</option><option>Learning Journey</option><option>Attendance</option><option>Courses</option><option>Account</option><option>Technical issue</option></select></label><label>Subject<input required placeholder="What do you need help with?" /></label></div><label>Message<textarea required placeholder="Describe the issue in this demo…"></textarea></label><button class="button" type="submit">Prepare support request</button><p class="notice" data-support-notice hidden>Request prepared locally — no ticket was sent.</p></form></section>
    <section><div class="section-title"><div><span class="eyebrow">Frequently asked questions</span><h2>Quick answers</h2></div><input class="faq-search" type="search" data-faq-search placeholder="Search FAQs…" /></div><div class="faq-list"><details data-faq><summary>How do I view Eli’s published Learning Journey?</summary><p>Open Learning Journey and select a published story. Drafts remain private.</p></details><details data-faq><summary>What happens after I report an absence?</summary><p>The demo confirms the report locally. Center policy separately determines makeup eligibility.</p></details><details data-faq><summary>Can I message Eli’s Coach?</summary><p>Yes, the demo inbox shows a local reply interaction that does not deliver a real message.</p></details><details data-faq><summary>How do I contact Northfield Studio?</summary><p>Use Message Center in Family Home. In this demo, no message leaves the browser.</p></details></div></section>
  </>}
</div>

<script>
  import { createFamilyDemoState, reduceFamilyDemo } from "../../demo/cognit-family-interaction.js";
  import { applyCenterPublicationState } from "../../demo/cognit-publication-sync.js";
  let familyState = createFamilyDemoState();
  const root = document.querySelector("[data-family-demo]");
  if (root instanceof HTMLElement) {
    applyCenterPublicationState(root);
    root.querySelectorAll("[data-conversation]").forEach((button) => button.addEventListener("click", () => {
      root.querySelectorAll("[data-conversation]").forEach((item) => item.classList.remove("active")); button.classList.add("active");
      const center = button.getAttribute("data-conversation") === "center";
      const name = root.querySelector("[data-thread-name]"); const context = root.querySelector("[data-thread-context]"); const message = root.querySelector("[data-thread-message]");
      if (name) name.textContent = center ? "Maya Chen" : "Jordan Ellis";
      if (context) context.textContent = center ? "Regarding Morgan Family · Northfield Studio" : "Regarding Eli Morgan · Creative App Lab";
      if (message) message.textContent = center ? "Family showcase begins Saturday at 11:30 AM. No response is required." : "Eli’s published story is ready. He built the first navigation flow and revised an interaction after testing.";
    }));
    root.querySelector("[data-reply-form]")?.addEventListener("submit", (event) => { event.preventDefault(); familyState = reduceFamilyDemo(familyState, { type: "SEND_REPLY" }); const notice = root.querySelector("[data-reply-notice]"); if (notice instanceof HTMLElement) notice.hidden = false; });
    root.querySelector("[data-absence-form]")?.addEventListener("submit", (event) => { event.preventDefault(); familyState = reduceFamilyDemo(familyState, { type: "SUBMIT_ABSENCE" }); const form = event.currentTarget; if (!(form instanceof HTMLFormElement)) return; const values = new FormData(form); const formView = root.querySelector("[data-absence-form-view]"); const confirmation = root.querySelector("[data-absence-confirmation]"); if (formView instanceof HTMLElement) formView.hidden = true; if (confirmation instanceof HTMLElement) confirmation.hidden = false; root.querySelector("[data-confirm-date]").textContent = String(values.get("date-mode")); root.querySelector("[data-confirm-reason]").textContent = String(values.get("reason")); history.pushState({}, "", "/learninghub/demo/family/absence-confirmed"); });
    root.querySelector("[data-cancel-notice]")?.addEventListener("click", () => { familyState = reduceFamilyDemo(familyState, { type: "CANCEL_FUTURE_NOTICE" }); const notice = root.querySelector("[data-future-notice]"); const cancelled = root.querySelector("[data-cancelled-notice]"); if (notice instanceof HTMLElement) notice.hidden = true; if (cancelled instanceof HTMLElement) cancelled.hidden = false; });
    root.querySelectorAll("[data-course-filter]").forEach((filter) => filter.addEventListener("change", () => {
      familyState = reduceFamilyDemo(familyState, { type: "SET_COURSE_FILTER", key: filter.getAttribute("data-filter-kind"), value: filter.value });
      root.querySelectorAll("[data-course-card]").forEach((card) => { if (card instanceof HTMLElement) card.hidden = Object.entries(familyState.courseFilters).some(([kind, value]) => value !== "all" && card.dataset[kind] !== value); });
    }));
    const dialog = root.querySelector("[data-registration-dialog]"); let registrationTrigger;
    root.querySelectorAll("[data-register]").forEach((button) => button.addEventListener("click", () => { familyState = reduceFamilyDemo(familyState, { type: "PREPARE_REGISTRATION" }); registrationTrigger = button; const title = root.querySelector("[data-registration-course]"); if (title) title.textContent = button.getAttribute("data-register") || "Selected course"; if (dialog instanceof HTMLDialogElement) dialog.showModal(); }));
    root.querySelectorAll("[data-close-dialog]").forEach((button) => button.addEventListener("click", () => { if (dialog instanceof HTMLDialogElement) dialog.close(); if (registrationTrigger instanceof HTMLElement) registrationTrigger.focus(); }));
    root.querySelectorAll("[data-payment-shell], [data-receipt-shell]").forEach((button) => button.addEventListener("click", () => { const notice = root.querySelector("[data-billing-notice]"); if (notice instanceof HTMLElement) notice.hidden = false; }));
    root.querySelectorAll("[data-account-shell]").forEach((button) => button.addEventListener("click", () => { const notice = root.querySelector("[data-account-notice]"); if (notice) notice.textContent = "Demo shell opened conceptually — no credential or contact value changed."; }));
    root.querySelector("[data-support-form]")?.addEventListener("submit", (event) => { event.preventDefault(); familyState = reduceFamilyDemo(familyState, { type: "PREPARE_SUPPORT" }); const notice = root.querySelector("[data-support-notice]"); if (notice instanceof HTMLElement) notice.hidden = false; });
    root.querySelector("[data-faq-search]")?.addEventListener("input", (event) => { const term = event.target.value.toLowerCase(); root.querySelectorAll("[data-faq]").forEach((item) => { if (item instanceof HTMLElement) item.hidden = !item.textContent.toLowerCase().includes(term); }); });
  }
</script>

<style>
  .family-demo{display:grid;gap:clamp(28px,5vw,54px);--family-accent:#f6ac2c}.family-demo [hidden]{display:none!important}.publication-sync{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 18px;border:1px solid var(--color-border);border-left:5px solid var(--family-accent);border-radius:12px;background:#fff7e8}.publication-sync--published{border-left-color:#20aaa5;background:#eaf8f5}.publication-sync div{display:grid;gap:4px}.publication-sync p{max-width:62ch;margin:0}.family-demo :is(h1,h2,h3,p){overflow-wrap:anywhere}.family-demo h1{margin:.3rem 0 .8rem;font-size:clamp(2.5rem,6vw,5rem);line-height:.95}.family-demo h2{margin:.35rem 0 .65rem}.family-demo p{line-height:1.6}.page-heading{max-width:780px}.eyebrow{color:var(--color-muted);font-size:.74rem;font-weight:950;letter-spacing:.04em;text-transform:uppercase}.hero-grid,.journey-feature,.journey-cover{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);align-items:center;gap:30px}.identity,.compact,.identity-row,.record{display:flex;align-items:center;gap:16px}.identity{justify-self:end}.identity>div,.identity-row>div{display:grid;gap:4px}.context-strip,.quick-actions,.button-row,.choice-row,.section-title,.setting-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.context-strip{padding:12px 16px;border:1px solid var(--color-border);border-radius:12px;background:#fff}.context-strip small{margin-left:auto}.pill,.choice-row label{padding:9px 14px;border:1px solid var(--color-border);border-radius:999px;background:#fff;font-weight:850}.pill.active{background:var(--family-accent)}.journey-feature,.journey-cover,.story-card,.next-card,.card,.form-shell,.inbox,.filters,.course-card,.record{padding:clamp(20px,4vw,34px);border:1px solid var(--color-border);border-radius:18px;background:#fff;box-shadow:var(--shadow-soft)}.journey-feature{background:linear-gradient(135deg,#edf8fb,#fff)}.journey-feature :global(.narrative-card),.journey-cover :global(.narrative-