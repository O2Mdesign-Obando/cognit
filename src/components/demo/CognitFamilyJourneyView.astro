---
import DemoLoopNav from "./DemoLoopNav.astro";
import DemoImage from "./DemoImage.astro";
import { getCognitDemoPerspectiveModel } from "../../demo/cognit-demo-model.js";
import { getDemoFamilyImage, getDemoStudentImage } from "../../demo/cognit-demo-images.js";
import { SYNTHETIC_COGNIT_DEMO as d } from "../../demo/cognit-demo-data.js";

const { view = "overview" } = Astro.props;
const model = getCognitDemoPerspectiveModel("family");
const active = view.startsWith("journey") ? "journey" : view === "messages" ? "messages" : ["attendance", "absence", "absence-confirmed", "makeup"].some((key) => view.startsWith(key)) ? "attendance" : view === "courses" ? "courses" : view === "billing" ? "billing" : view === "support" ? "support" : view === "account" ? "account" : "overview";
const studentImage = getDemoStudentImage(model.student.id);
const familyImage = getDemoFamilyImage(model.family.id);
const isJourneyDetail = view === "journey/eli";
const isAbsenceConfirmation = view === "absence-confirmed";
const familyBilling = d.financials.accounts.find((account) => account.familyId === "demo-family-morgan");
const formatMoney = (value) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);
---

<div class="family-demo" data-family-demo>
  <DemoLoopNav role="family" active={active} />

  <aside class="publication-sync publication-sync--held" data-center-publication-held>
    <div><span class="eyebrow">Same-event publication status</span><strong>Eli’s newest Center-reviewed update is still held.</strong></div>
    <p>Family continues to see the previously published Journey until Northfield Studio releases the new story.</p>
  </aside>
  <aside class="publication-sync publication-sync--published" data-center-published-event hidden>
    <div><span class="eyebrow">Same-event publication status</span><strong>Eli’s newest Center-reviewed update is now published.</strong></div>
    <p>The Student and Family views now reflect the same published release.</p>
  </aside>

  {view === "overview" && <>
    <section class="welcome hero-grid">
      <div><span class="eyebrow">Family home</span><h1>Welcome back, Morgan Family.</h1><p>Here is what changed for Eli, what comes next, and whether you need to act.</p></div>
      <div class="identity"><DemoImage image={familyImage} size="profile-lg" loading="eager" /><div><small>Signed in as</small><strong>Rachel Morgan</strong><span>1 authorized learner</span></div></div>
    </section>
    <section class="context-strip" aria-label="Authorized learner context"><span>Viewing for</span><button class="pill active" type="button">Eli Morgan</button><small>Only learners linked to this Family are shown.</small></section>
    <section class="journey-feature">
      <DemoImage image={studentImage} size="narrative-card" loading="eager" />
      <div><span class="eyebrow">Latest published Learning Journey · Creative App Lab</span><h2>{model.publishedStory}</h2><p>{model.update}</p><blockquote>Jordan Ellis: “{model.update}”</blockquote><a class="button" href="/learninghub/demo/family/journey/eli">View full Journey →</a></div>
    </section>
    <section class="card-grid two">
      <article class="card"><span class="eyebrow">Class enrollment status</span><h2>Creative App Lab</h2><p>Eli Morgan · Coach Jordan Ellis</p><dl><div><dt>Schedule</dt><dd>Today · 4:00–5:30 PM</dd></div><div><dt>Status</dt><dd>Active</dd></div></dl></article>
      <article class="card action-card"><span class="status good">No action needed</span><h2>You’re up to date</h2><p>Eli’s latest story is published and today’s attendance is present.</p><a href="/learninghub/demo/family/attendance">Review attendance →</a></article>
    </section>
    <section><div class="section-title"><div><span class="eyebrow">Messages and announcements</span><h2>Stay in the loop</h2></div><a href="/learninghub/demo/family/messages">Open inbox →</a></div><div class="card-grid two"><article class="card"><strong>Jordan Ellis</strong><h3>Eli’s next design test</h3><p>See the published update and what Eli will try next.</p></article><article class="card"><strong>Northfield Studio</strong><h3>Family showcase reminder</h3><p>Project sharing begins Saturday at 11:30 AM. No response is required.</p></article></div></section>
    <section><span class="eyebrow">Quick actions</span><div class="quick-actions"><a href="/learninghub/demo/family/messages">Message Coach</a><a href="/learninghub/demo/family/messages?conversation=center">Message Center</a><a href="/learninghub/demo/family/absence">Report absence</a><a href="/learninghub/demo/family/support">Ask a question</a></div></section>
  </>}

  {view === "journey" && <>
    <section class="page-heading"><span class="eyebrow">Learning Journey</span><h1>Eli’s published learning story</h1><p>A small history of visible milestones—not internal Coach drafts or review mechanics.</p></section>
    <section class="record-list">
      <a class="record featured" href="/learninghub/demo/family/journey/eli"><DemoImage image={studentImage} size="avatar-md" /><div><small>Latest · Creative App Lab</small><h2>{model.publishedStory}</h2><p>{model.update}</p></div><b>Open →</b></a>
      <article class="record"><div><small>Prior milestone · Creative App Lab</small><h2>Navigation ready for testing</h2><p>Eli connected the primary screen and navigation into one working flow.</p></div></article>
      <article class="record"><div><small>Earlier milestone · Creative App Lab</small><h2>A habit idea becomes a screen plan</h2><p>Eli mapped the core habit flow before beginning the prototype.</p></div></article>
    </section>
  </>}

  {isJourneyDetail && <>
    <section class="journey-cover"><DemoImage image={studentImage} size="narrative-card" loading="eager" /><div><span class="eyebrow">Published Family story · Creative App Lab</span><h1>{model.publishedStory}</h1><p>Eli Morgan · Coach Jordan Ellis</p></div></section>
    <section class="story-card"><span class="eyebrow">A note from Jordan</span><h2>{model.publishedStory}</h2><p>{model.update}</p><blockquote>“{model.observation}”</blockquote><ol class="published-spine"><li><span>Completed</span><strong>{model.completed}</strong></li><li><span>Learning focus</span><strong>{model.challenge}</strong></li><li><span>Coach observation</span><strong>{model.observation}</strong></li><li><span>What comes next</span><strong>{model.next}</strong></li></ol><p class="publication-boundary">Center-reviewed publication only. Private Student reflection and Coach drafts remain outside this Family story.</p></section>
    <section><div class="section-title"><div><span class="eyebrow">Memories</span><h2>Evidence translated for Family</h2></div></div><div class="memory-grid"><div class="artifact"><strong>Habit</strong><b>Today</b><span>✓</span></div><article class="card"><h3>{model.evidence.label}</h3><p>{model.evidence.type.replace("_", " ")} · {model.evidence.status}</p></article></div></section>
    <section class="card-grid two"><article class="card"><span class="eyebrow">Student voice</span><h2>No reflection was published with this story</h2><p>Private or unfinished Student reflections are not exposed to Family.</p></article><article class="card"><span class="eyebrow">Narrative arc</span><h2>Plan → build → test → revise</h2><p>Eli moved from a screen plan to a working interaction and used feedback to improve it.</p></article></section>
    <section class="next-card"><span class="eyebrow">What comes next</span><h2>{model.next}</h2><p>The next step remains attached to {model.course.name}.</p></section>
  </>}

  {view === "messages" && <>
    <section class="page-heading"><span class="eyebrow">Family messages</span><h1>Conversations about Eli</h1><p>Messages stay scoped to Eli and the authorized Family relationship.</p></section>
    <section class="inbox">
      <aside><button class="conversation active" data-conversation="coach"><strong>Jordan Ellis</strong><span>Eli · Creative App Lab</span><small>2:45 PM</small></button><button class="conversation" data-conversation="center"><strong>Maya Chen</strong><span>Morgan Family · Northfield Studio</span><small>Yesterday</small></button></aside>
      <article class="thread"><header><div><strong data-thread-name>Jordan Ellis</strong><span data-thread-context>Regarding Eli Morgan · Creative App Lab</span></div><span class="status good">Published</span></header><div class="message"><p data-thread-message>Eli’s published story is ready. He built the first navigation flow and revised an interaction after testing.</p><div class="attachment"><div class="artifact mini"><b>Habit</b><span>✓</span></div><span>Habit Tracker — published evidence preview</span></div></div><form data-reply-form><label for="family-reply">Reply</label><textarea id="family-reply" required placeholder="Write a reply…"></textarea><button class="button" type="submit">Save reply</button><p class="notice" data-reply-notice hidden>Reply saved.</p></form></article>
    </section>
  </>}

  {(view === "attendance" || view === "attendance/eli" || view === "attendance/sofia") && <>
    <section class="page-heading"><span class="eyebrow">Attendance &amp; Make-Ups</span><h1>Attendance and Make-Up Tokens</h1><p>Report an absence, see automatic Center policy results, and use available tokens from the Family account.</p></section>
    <section class="card-grid two"><article class="card"><div class="compact"><DemoImage image={studentImage} size="avatar-md" /><div><span class="eyebrow">Morgan Family</span><h2>Eli Morgan</h2></div></div><p><span class="status good">Present today</span> · Creative App Lab</p><div class="button-row"><a class="button" href="/learninghub/demo/family/absence">Report an absence</a></div></article><article class="card"><div class="compact"><DemoImage image={getDemoStudentImage(model.secondary.student.id)} size="avatar-md" /><div><span class="eyebrow">Authorized Family record</span><h2>Reyes Family · Sofia Reyes</h2></div></div><p>Prior Robotics Studio absence · 1 Make-Up Token available.</p><a href="/learninghub/demo/family/makeup">View and use Make-Up Token →</a></article></section>
  </>}

  {(view === "absence" || isAbsenceConfirmation) && <section class="form-shell" data-absence-shell>
    <div class="page-heading"><span class="eyebrow">Absence report</span><h1>{isAbsenceConfirmation ? "Absence reported" : "Report an absence"}</h1><p>Review the learner, session, date, and reason before confirming.</p></div>
    <div data-absence-form-view hidden={isAbsenceConfirmation}>
      <div class="identity-row"><DemoImage image={studentImage} size="avatar-sm" /><div><strong>Eli Morgan</strong><span>Creative App Lab · Today · 4:00–5:30 PM</span></div></div>
      <form data-absence-form><fieldset><legend>When will Eli be absent?</legend><div class="choice-row"><label><input type="radio" name="date-mode" value="Today" checked /> Today</label><label><input type="radio" name="date-mode" value="Future date" /> Future date</label><label><input type="radio" name="date-mode" value="Date range" /> Date range</label></div></fieldset><fieldset><legend>Reason</legend><div class="choice-row"><label><input type="radio" name="reason" value="Sick" checked /> Sick</label><label><input type="radio" name="reason" value="Travel" /> Travel</label><label><input type="radio" name="reason" value="Appointment" /> Appointment</label><label><input type="radio" name="reason" value="Other" /> Other</label></div></fieldset><label>Optional note for Northfield Studio<textarea name="note" placeholder="Add a note for Northfield Studio (optional)"></textarea></label><div class="button-row"><button class="button" type="submit">Submit absence report</button><a href="/learninghub/demo/family/attendance">Cancel</a></div></form>
    </div>
    <div class="confirmation" data-absence-confirmation hidden={!isAbsenceConfirmation}><div class="success-mark">✓</div><h2>Absence reported</h2><dl><div><dt>Student/class</dt><dd>Eli Morgan · Creative App Lab</dd></div><div><dt>Date and reason</dt><dd><span data-confirm-date>Today</span> · <span data-confirm-reason>Sick</span></dd></div><div><dt>Center</dt><dd>Northfield Studio received the report</dd></div><div><dt>Attendance</dt><dd>Reported</dd></div><div><dt>Make-Up Token</dt><dd>Center policy is checked automatically. A qualifying token is added to this Family account.</dd></div></dl><article class="future-notice" data-future-notice><strong>Upcoming absence notice</strong><p>Eli Morgan · Creative App Lab · Next Friday · Family travel</p><button class="button secondary" type="button" data-cancel-notice>Cancel notice</button></article><p class="notice" data-cancelled-notice hidden>Future absence notice cancelled.</p><a class="button" href="/learninghub/demo/family/attendance">Done</a></div>
  </section>}

  {view === "makeup" && <>
    <section class="page-heading"><span class="eyebrow">Reyes Family · Attendance &amp; Make-Ups</span><h1>Sofia has 1 available Make-Up Token</h1><p>The token is banked on the Family account. Choose when to use it before it expires.</p></section>
    <section class="card" data-family-token-card><div class="compact"><DemoImage image={getDemoStudentImage(model.secondary.student.id)} size="avatar-md" /><div><h2>Robotics Studio</h2><p>Added automatically after an appointment was reported before class</p></div><span class="status good" data-family-token-status>Available</span></div><dl><div><dt>Status</dt><dd data-family-token-status-text>Available</dd></div><div><dt>Issued</dt><dd>August 18, 2026</dd></div><div><dt>Expiration</dt><dd>October 2, 2026</dd></div><div><dt>Added because of</dt><dd>Robotics Studio appointment absence</dd></div></dl></section>
    <form class="card" data-token-use-form><span class="eyebrow">Use this Make-Up Token</span><h2>Choose a replacement session</h2><label>Available Robotics Studio session<select name="replacementSession" required><option value="Tuesday, September 1 · 5:45–7:15 PM">Tuesday, September 1 · 5:45–7:15 PM</option><option value="Tuesday, September 8 · 5:45–7:15 PM">Tuesday, September 8 · 5:45–7:15 PM</option></select></label><button class="button" type="submit">Use Make-Up Token</button><p class="notice" data-token-use-status>The Family selection is recorded in Make-Up Token history.</p></form>
    <section class="card-grid two" aria-label="Make-Up Token history"><article class="card"><span class="status">Used</span><h2>Prior Robotics Studio Make-Up Token</h2><p>Used for the September 1, 2026 replacement session.</p></article><article class="card"><span class="status">Expired</span><h2>Prior Robotics Studio Make-Up Token</h2><p>Expired July 26, 2026 without being used.</p></article></section>
  </>}

  {view === "courses" && <>
    <section class="page-heading"><span class="eyebrow">Course discovery · Eli Morgan</span><h1>Explore courses</h1><p>Review schedules, availability, and pricing.</p></section>
    <section class="filters"><label>Season<select data-course-filter data-filter-kind="season"><option value="all">All seasons</option><option value="current">Current</option><option value="upcoming">Upcoming</option></select></label><label>Category<select data-course-filter data-filter-kind="category"><option value="all">All categories</option><option value="creative">Creative technology</option><option value="robotics">Robotics</option><option value="story">Storytelling</option></select></label><label>Day/time<select data-course-filter data-filter-kind="time"><option value="all">All times</option><option value="weekday">Weekday</option><option value="weekend">Weekend</option></select></label></section>
    <section class="catalog-grid"><article class="course-card" data-course-card data-season="current" data-category="creative" data-time="weekday"><span class="status good">Enrolled</span><h2>Creative App Lab</h2><p>Today · 4:00–5:30 PM · ongoing</p><strong>Listed tuition · $180/month</strong></article><article class="course-card" data-course-card data-season="upcoming" data-category="robotics" data-time="weekday"><span class="status">4 seats shown</span><h2>Robotics Studio</h2><p>Weekdays · 8-week session</p><strong>Listed tuition · $190/month</strong><button class="button" type="button" data-register="Robotics Studio">View inquiry</button></article><article class="course-card" data-course-card data-season="upcoming" data-category="story" data-time="weekend"><span class="status">6 seats shown</span><h2>Digital Storytelling Lab</h2><p>Saturday · 8-week session</p><strong>Listed tuition · $175/month</strong><button class="button" type="button" data-register="Digital Storytelling Lab">View inquiry</button></article><article class="course-card" data-course-card data-season="upcoming" data-category="creative" data-time="weekday"><span class="status">Discovery</span><h2>Creative Computing Foundations</h2><p>Weekdays · 6-week session</p><strong>Listed tuition · $165/month</strong><button class="button" type="button" data-register="Creative Computing Foundations">View inquiry</button></article></section>
    <dialog data-registration-dialog><button class="dialog-close" type="button" data-close-dialog aria-label="Close">×</button><span class="eyebrow">Course inquiry</span><h2>Course inquiry ready</h2><p><strong data-registration-course></strong> for Eli Morgan.</p><p>This inquiry does not reserve a seat or create a payment.</p><button class="button" type="button" data-close-dialog>Done</button></dialog>
  </>}

  {view === "billing" && familyBilling && <>
    <section class="page-heading"><span class="eyebrow">Authorized Family billing</span><h1>Tuition and billing</h1><p>Review the Morgan Family account for Eli. Other Family accounts and Center financial metrics are not visible here.</p></section>
    <section class="summary-grid family-billing-summary"><article class="card"><span class="status good">Current</span><h2>{formatMoney(familyBilling.monthlyTuition)} / month</h2><p>Creative App Lab · Eli Morgan</p></article><article class="card"><span class="eyebrow">Balance and next payment</span><h2>{formatMoney(familyBilling.openBalance)} due</h2><p>{familyBilling.nextPayment}</p></article><article class="card"><span class="eyebrow">Payment method</span><h2 data-family-method>{familyBilling.paymentMethod.brand} ending {familyBilling.paymentMethod.last4}</h2><p data-family-expiration>Expires {familyBilling.paymentMethod.expiration} · Auto-pay {familyBilling.autoPay ? "on" : "off"}</p><button class="button secondary" type="button" data-family-method-open>Update payment method</button></article></section>
    <section class="card"><div class="section-title"><h2>Payment history</h2><button class="button secondary" type="button" data-receipt-shell>Receipt</button></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Status</th><th>Reference</th></tr></thead><tbody>{familyBilling.payments.map((payment)=><tr><td>{payment.date}</td><td>{payment.description}</td><td>{formatMoney(payment.amount)}</td><td>{payment.status === "paid" ? "Payment successful" : "Payment failed"}</td><td>{payment.reference}</td></tr>)}</tbody></table></div><p class="notice" data-billing-notice hidden>Receipt details are shown with the reference above.</p></section>
    <dialog data-family-method-dialog><form class="family-method-form" method="dialog" data-family-method-form><button class="dialog-close" value="cancel" aria-label="Close">×</button><span class="eyebrow">Payment method</span><h2>Update payment method</h2><p>No full card number or CVC is accepted or stored.</p><div class="form-grid"><label>Card brand<select name="brand"><option>Visa</option><option>Mastercard</option></select></label><label>Last four digits<input name="last4" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" value={familyBilling.paymentMethod.last4} required /></label><label>Expiration<input name="expiration" pattern="[0-9]{2}/[0-9]{2}" value={familyBilling.paymentMethod.expiration} required /></label><label>Cardholder name<input name="cardholder" value={familyBilling.paymentMethod.cardholder} required /></label><label>Billing ZIP<input name="zip" inputmode="numeric" pattern="[0-9]{5}" value={familyBilling.paymentMethod.zip} required /></label><label class="toggle"><input type="checkbox" name="autoPay" checked={familyBilling.autoPay} /> Auto-pay monthly tuition</label></div><div class="button-row"><button class="button secondary" value="cancel">Cancel</button><button class="button" value="default" data-family-method-save>Save method</button></div></form></dialog><p class="notice" role="status" tabindex="-1" data-family-method-status hidden></p>
  </>}

  {view === "account" && <>
    <section class="page-heading"><span class="eyebrow">Family account</span><h1>Preferences and account</h1><p>Review security and notification preferences for this Family account.</p></section>
    <section class="card settings"><h2>Security</h2><div class="setting-row"><span><strong>Password</strong><small>••••••••••</small></span><button class="button secondary" type="button" data-account-shell>Change password</button></div><div class="setting-row"><span><strong>Email</strong><small>rachel.morgan@family.example</small></span><button class="button secondary" type="button" data-account-shell>Change email</button></div></section>
    <section class="card settings"><h2>Notifications</h2><label class="toggle"><input type="checkbox" data-preference="reminders" checked /> Session reminders</label><label class="toggle"><input type="checkbox" data-preference="learningUpdates" checked /> Published learning updates</label><label class="toggle"><input type="checkbox" data-preference="announcements" /> Center announcements</label><label>Language<select><option>English (US)</option><option>Español</option></select></label><p class="notice" data-account-notice>Preferences are stored only for this page session.</p></section>
  </>}

  {view === "support" && <>
    <section class="page-heading"><span class="eyebrow">Family Support Center</span><h1>How can we help?</h1><p>Search common questions or prepare a support request.</p></section>
    <section class="card"><form data-support-form><div class="form-grid"><label>Problem type<select required><option value="">Select a problem type</option><option>Learning Journey</option><option>Attendance</option><option>Courses</option><option>Account</option><option>Technical issue</option></select></label><label>Subject<input required placeholder="What do you need help with?" /></label></div><label>Message<textarea required placeholder="Describe the issue"></textarea></label><button class="button" type="submit">Review request</button><p class="notice" data-support-notice hidden>Request ready for review.</p></form></section>
    <section><div class="section-title"><div><span class="eyebrow">Frequently asked questions</span><h2>Quick answers</h2></div><input class="faq-search" type="search" data-faq-search placeholder="Search FAQs…" /></div><div class="faq-list"><details data-faq><summary>How do I view Eli’s published Learning Journey?</summary><p>Open Learning Journey and select a published story. Drafts remain private.</p></details><details data-faq><summary>What happens after I report an absence?</summary><p>Center policy is checked automatically. If the absence qualifies, a Make-Up Token is added to your Family account.</p></details><details data-faq><summary>Can I message Eli’s Coach?</summary><p>Yes. Open Messages and choose Eli’s Coach conversation. The conversation stays connected to your authorized Family relationship.</p></details><details data-faq><summary>How do I contact Northfield Studio?</summary><p>Use Message Center in Family Home to open the Center conversation.</p></details></div></section>
  </>}
</div>

<script>
  import { createFamilyDemoState, reduceFamilyDemo } from "../../demo/cognit-family-interaction.js";
  import { applyCenterPublicationState } from "../../demo/cognit-publication-sync.js";
  let familyState = createFamilyDemoState();
  const root = document.querySelector("[data-family-demo]");
  if (root instanceof HTMLElement) {
    applyCenterPublicationState(root);
    root.querySelectorAll("[data-conversation]").forEach((button) => button.addEventListener("click", () => {
      root.querySelectorAll("[data-conversation]").forEach((item) => item.classList.remove("active")); button.classList.add("active");
      const center = button.getAttribute("data-conversation") === "center";
      const name = root.querySelector("[data-thread-name]"); const context = root.querySelector("[data-thread-context]"); const message = root.querySelector("[data-thread-message]");
      if (name) name.textContent = center ? "Maya Chen" : "Jordan Ellis";
      if (context) context.textContent = center ? "Regarding Morgan Family · Northfield Studio" : "Regarding Eli Morgan · Creative App Lab";
      if (message) message.textContent = center ? "Family showcase begins Saturday at 11:30 AM. No response is required." : "Eli’s published story is ready. He built the first navigation flow and revised an interaction after testing.";
    }));
    root.querySelector("[data-reply-form]")?.addEventListener("submit", (event) => { event.preventDefault(); familyState = reduceFamilyDemo(familyState, { type: "SEND_REPLY" }); const notice = root.querySelector("[data-reply-notice]"); if (notice instanceof HTMLElement) notice.hidden = false; });
    root.querySelector("[data-absence-form]")?.addEventListener("submit", (event) => { event.preventDefault(); familyState = reduceFamilyDemo(familyState, { type: "SUBMIT_ABSENCE" }); const form = event.currentTarget; if (!(form instanceof HTMLFormElement)) return; const values = new FormData(form); const formView = root.querySelector("[data-absence-form-view]"); const confirmation = root.querySelector("[data-absence-confirmation]"); if (formView instanceof HTMLElement) formView.hidden = true; if (confirmation instanceof HTMLElement) confirmation.hidden = false; root.querySelector("[data-confirm-date]").textContent = String(values.get("date-mode")); root.querySelector("[data-confirm-reason]").textContent = String(values.get("reason")); history.pushState({}, "", "/learninghub/demo/family/absence-confirmed"); });
    root.querySelector("[data-cancel-notice]")?.addEventListener("click", () => { familyState = reduceFamilyDemo(familyState, { type: "CANCEL_FUTURE_NOTICE" }); const notice = root.querySelector("[data-future-notice]"); const cancelled = root.querySelector("[data-cancelled-notice]"); if (notice instanceof HTMLElement) notice.hidden = true; if (cancelled instanceof HTMLElement) cancelled.hidden = false; });
    root.querySelector("[data-token-use-form]")?.addEventListener("submit", (event) => { event.preventDefault(); const form = event.currentTarget; if (!(form instanceof HTMLFormElement)) return; const select = form.elements.namedItem("replacementSession"); if (!(select instanceof HTMLSelectElement)) return; familyState = reduceFamilyDemo(familyState, { type: "USE_MAKEUP_TOKEN", replacementSession: select.selectedOptions[0]?.textContent?.trim() }); const centerStateKey = "cognit:center-demo-state:v2"; try { const centerState = JSON.parse(localStorage.getItem(centerStateKey) || "{}"); const consequences = centerState.consequences || {}; centerState.consequences = { ...consequences, entitlements: { ...(consequences.entitlements || {}), "demo-makeup-sofia-robotics": { status: "redeemed", redeemedAt: new Date().toISOString(), replacementSession: familyState.replacementSession, recordedBy: "Family" } } }; localStorage.setItem(centerStateKey, JSON.stringify(centerState)); } catch {} root.querySelectorAll("[data-family-token-status], [data-family-token-status-text]").forEach((node) => { node.textContent = "Used"; }); const button = form.querySelector("button"); if (button instanceof HTMLButtonElement) { button.disabled = true; button.textContent = "Make-Up Token used"; } const status = root.querySelector("[data-token-use-status]"); if (status) status.textContent = `Used for ${familyState.replacementSession}. This replacement session is now shown in the Family and Center history.`; });
    root.querySelectorAll("[data-course-filter]").forEach((filter) => filter.addEventListener("change", () => {
      familyState = reduceFamilyDemo(familyState, { type: "SET_COURSE_FILTER", key: filter.getAttribute("data-filter-kind"), value: filter.value });
      root.querySelectorAll("[data-course-card]").forEach((card) => { if (card instanceof HTMLElement) card.hidden = Object.entries(familyState.courseFilters).some(([kind, value]) => value !== "all" && card.dataset[kind] !== value); });
    }));
    const dialog = root.querySelector("[data-registration-dialog]"); let registrationTrigger;
    root.querySelectorAll("[data-register]").forEach((button) => button.addEventListener("click", () => { familyState = reduceFamilyDemo(familyState, { type: "PREPARE_REGISTRATION" }); registrationTrigger = button; const title = root.querySelector("[data-registration-course]"); if (title) title.textContent = button.getAttribute("data-register") || "Selected course"; if (dialog instanceof HTMLDialogElement) dialog.showModal(); }));
    root.querySelectorAll("[data-close-dialog]").forEach((button) => button.addEventListener("click", () => { if (dialog instanceof HTMLDialogElement) dialog.close(); if (registrationTrigger instanceof HTMLElement) registrationTrigger.focus(); }));
    root.querySelector("[data-receipt-shell]")?.addEventListener("click", () => { const notice = root.querySelector("[data-billing-notice]"); if (notice instanceof HTMLElement) notice.hidden = false; });
    const methodDialog = root.querySelector("[data-family-method-dialog]"); const methodTrigger = root.querySelector("[data-family-method-open]"); methodTrigger?.addEventListener("click", () => { if (methodDialog instanceof HTMLDialogElement) methodDialog.showModal(); });
    root.querySelector("[data-family-method-save]")?.addEventListener("click", (event) => { const form = root.querySelector("[data-family-method-form]"); if (!(form instanceof HTMLFormElement) || !form.reportValidity()) { event.preventDefault(); return; } const values = Object.fromEntries(new FormData(form)); const method = `${values.brand} ending ${values.last4}`; const expiration = `Expires ${values.expiration} · Auto-pay ${values.autoPay ? "on" : "off"}`; const methodNode = root.querySelector("[data-family-method]"), expirationNode = root.querySelector("[data-family-expiration]"), status = root.querySelector("[data-family-method-status]"); if (methodNode) methodNode.textContent = method; if (expirationNode) expirationNode.textContent = expiration; try { localStorage.setItem("cognit:family-billing-method:v1", JSON.stringify({ brand: values.brand, last4: values.last4, expiration: values.expiration, cardholder: values.cardholder, zip: values.zip, autoPay: Boolean(values.autoPay) })); } catch {} if (status instanceof HTMLElement) { status.hidden = false; status.textContent = "Payment method updated for this Family account."; window.setTimeout(() => status.focus(), 0); } });
    root.querySelectorAll("[data-account-shell]").forEach((button) => button.addEventListener("click", () => { const notice = root.querySelector("[data-account-notice]"); if (notice) notice.textContent = "Account changes are unavailable from this view."; }));
    root.querySelector("[data-support-form]")?.addEventListener("submit", (event) => { event.preventDefault(); familyState = reduceFamilyDemo(familyState, { type: "PREPARE_SUPPORT" }); const notice = root.querySelector("[data-support-notice]"); if (notice instanceof HTMLElement) notice.hidden = false; });
    root.querySelector("[data-faq-search]")?.addEventListener("input", (event) => { const term = event.target.value.toLowerCase(); root.querySelectorAll("[data-faq]").forEach((item) => { if (item instanceof HTMLElement) item.hidden = !item.textContent.toLowerCase().includes(term); }); });
  }
</script>

