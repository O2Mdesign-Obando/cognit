  .coach-journey form{display:grid;gap:16px}.coach-journey label{display:grid;gap:7px;color:var(--color-ink);font-weight:850}.coach-journey :is(input,select,textarea){width:100%;min-height:46px;padding:13px 14px;border:1px solid var(--color-border);border-radius:10px;background:#f7f9fb;color:var(--color-text);font:inherit}.coach-journey textarea{min-height:120px;resize:vertical}.coach-journey :is(input,select,textarea):focus-visible,.button:focus-visible{outline:3px solid var(--coach-accent);outline-offset:2px}
  .faq{display:grid;gap:12px}.faq .section-heading input{max-width:360px}.faq details{padding:18px;border:1px solid var(--color-border);border-radius:12px;background:#fff}.faq summary{cursor:pointer;color:var(--color-ink);font-weight:900}.faq details p{color:var(--color-muted);line-height:1.6}
  .evidence-empty{padding:20px;border:1px dashed var(--color-border);border-radius:12px;background:#f7f9fb}.evidence-empty strong{display:block;margin:8px 0}.evidence-empty p{margin:0;color:var(--color-muted)}
