---
import DemoLoopNav from "./DemoLoopNav.astro";
import DemoImage from "./DemoImage.astro";
import { getCognitDemoPerspectiveModel } from "../../demo/cognit-demo-model.js";
import { COGNIT_DEMO_IMAGES, getDemoCoachImage, getDemoStudentImage } from "../../demo/cognit-demo-images.js";

const { view = "today" } = Astro.props;
const model = getCognitDemoPerspectiveModel("coach");
const eli = model.primary.student;
const lena = model.roster.find((student) => student.id === "demo-student-lena-grant");
const workspaceTabByRoute = {
  "learners/eli": "overview",
  "learners/eli/progress": "progress",
  "learners/eli/evidence": "evidence",
  "learners/eli/observations": "observations",
  "progress/eli": "progress",
  "evidence/eli": "evidence",
  "observations/eli": "observations"
};
const workspaceTab = workspaceTabByRoute[view];
const isEliWorkspace = Boolean(workspaceTab);
const active = view === "home" || view === "readiness" || view === "live" || view === "capture" || view === "after-class" || view === "end-of-day" ? "today" : isEliWorkspace ? "learners" : view;
const journeyView = view.split("/")[0];
const releases = [
  { version: "v2.4.1", date: "August 26, 2026", title: "Faster observation capture and mobile improvements", summary: "Streamlined Coach notes, clearer reporting readiness, and more reliable evidence capture." },
  { version: "v2.4.0", date: "August 12, 2026", title: "Evidence review and schedule visibility", summary: "Captured moments remain connected to the right learner, class, and reporting queue." },
  { version: "v2.3.2", date: "July 29, 2026", title: "Mobile class switching and draft retention", summary: "Coaches can move between concurrent teaching tracks without losing their draft." }
];
---

<section class="coach-journey" data-coach-journey data-view={journeyView}>
  <DemoLoopNav role="coach" {active} />

  {journeyView === "today" && (
    <>
      <header class="journey-hero compact"><span class="eyebrow">Coach perspective</span><h1>Good afternoon, Jordan.</h1><p>Everything needed for today’s teaching is in one place.</p></header>
      <section class="primary-session card accent" aria-labelledby="next-class-title">
        <div class="identity"><DemoImage image={getDemoCoachImage(model.person.id)} size="avatar-md" loading="eager" /><div><span class="eyebrow">Next class · {model.context.name}</span><h2 id="next-class-title">{model.session.course.name} starts at 4:00 PM</h2><p>{model.session.learningFocus}</p></div></div>
        <div class="session-cta"><strong>{model.session.label}</strong><a class="button primary" href="/learninghub/demo/coach/readiness">Review readiness →</a></div>
      </section>
      <div class="two-column">
        <section class="card"><div class="section-heading"><div><span class="eyebrow">Today’s teaching</span><h2>Assigned classes</h2></div><a href="/learninghub/demo/coach/end-of-day">End-of-day review</a></div><div class="class-list"><article><div><strong>Creative App Lab</strong><span>4:00–5:30 PM · {eli.name}, {lena.name}</span></div><span class="status ready">Ready</span></article><article><div><strong>Digital Storytelling Lab</strong><span>Saturday · 10:00–11:30 AM · Mina Park, Ava Thompson</span></div><span class="status">Upcoming</span></article><article><div><strong>Harbor Academy · Creative App Lab</strong><span>Wednesday · 3:30–5:00 PM · Noah Bennett</span></div><span class="status">Upcoming</span></article></div></section>
        <section class="card"><span class="eyebrow">My learners</span><h2>Today’s roster</h2><div class="student-list"><a href="/learninghub/demo/coach/learners/eli"><DemoImage image={getDemoStudentImage(eli.id)} size="avatar-sm" /><span><strong>{eli.name}</strong><small>Creative App Lab · current focus ready</small></span></a><a href="/learninghub/demo/coach/progress/lena"><DemoImage image={getDemoStudentImage(lena.id)} size="avatar-sm" /><span><strong>{lena.name}</strong><small>Two active course paths</small></span></a></div></section>
      </div>
	      <section class="card communication"><div class="content-stack"><span class="eyebrow">Coach correspondence</span><h2>Keep each follow-up in the right relationship.</h2><p>Prepare a scoped note for the Center or Eli’s authorized Family without mixing recipients or inventing history.</p></div><div class="button-stack"><a class="button secondary" href="/learninghub/demo/coach/correspondence">Open correspondence</a><a class="button text" href="/learninghub/demo/coach/releases">What’s new</a></div></section>
    </>
  )}

  {journeyView === "readiness" && (
    <>
      <header class="journey-hero"><span class="eyebrow">Before class</span><h1>Creative App Lab is ready.</h1><p>Review the learning focus, expected outcome, continuity, and roster before starting the session.</p></header>
      <section class="card readiness-card">
        <div class="section-heading"><div><span class="eyebrow">Today · {model.session.label}</span><h2>{model.session.learningFocus}</h2></div><span class="status ready">Ready to start</span></div>
        <div class="fact-grid"><article><span>Objective</span><strong>Prototype the habit-tracking flow and explain one design change.</strong></article><article><span>Expected outcome</span><strong>A working primary screen, navigation, and one interaction test.</strong></article><article><span>Continuity</span><strong>{eli.name}: {model.primary.completed}</strong></article><article><span>Coach note</span><strong>Give both learners time to test a confusing step with a classmate.</strong></article></div>
        <div class="roster-row"><span>Roster</span><div><DemoImage image={getDemoStudentImage(eli.id)} size="avatar-sm" /><strong>{eli.name}</strong></div><div><DemoImage image={getDemoStudentImage(lena.id)} size="avatar-sm" /><strong>{lena.name}</strong></div></div>
        <div class="actions"><a class="button text" href="/learninghub/demo/coach/learning-plan">View learning plan</a><a class="button primary" href="/learninghub/demo/coach/live">Begin class →</a></div>
      </section>
    </>
  )}

  {journeyView === "live" && (
    <section class="live-mode" data-live-mode>
      <div class="live-toolbar"><div><span class="eyebrow">Active session</span><strong>Creative App Lab · Northfield Studio</strong></div><button type="button" data-class-switch aria-expanded="false">Switch class⌄</button></div>
      <div class="switch-panel" data-class-switch-panel hidden><button class="selected">Creative App Lab · 2 learners <span>In progress</span></button><button>Digital Storytelling Lab · 2 learners <span>Upcoming</span></button><button>Harbor Creative App Lab · 1 learner <span>Upcoming</span></button></div>
      <div class="live-grid">
        <section class="timer-card"><div class="timer-ring"><strong data-live-timer>00:00</strong><span>elapsed</span></div><h1>Creative App Lab</h1><p>2 learners present today</p><div class="active-roster" aria-label="Active class roster"><a href="/learninghub/demo/coach/learners/eli"><DemoImage image={getDemoStudentImage(eli.id)} size="avatar-sm" /><span>{eli.name}</span></a><a href="/learninghub/demo/coach/progress/lena"><DemoImage image={getDemoStudentImage(lena.id)} size="avatar-sm" /><span>{lena.name}</span></a></div><div class="actions center"><a class="button secondary" data-capture-link href="/learninghub/demo/coach/capture?learner=eli&return=live">Capture evidence</a><button class="button warning" type="button" data-open-end-class>End class</button></div></section>
        <section class="card quick-note"><span class="eyebrow">Quick note · optional</span><h2>Jot observations</h2><p class="note-boundary">Notes stay with the selected learner. Switching learners never carries text into another learner’s record.</p><div class="learner-pills"><button class="selected" type="button" data-note-learner="eli">{eli.name}</button><button type="button" data-note-learner="lena">{lena.name}</button><button type="button" data-note-learner="class">Whole class</button></div><textarea rows="6" data-quick-note aria-label="Quick observation note for Eli Morgan" placeholder="Capture a short moment without interrupting teaching."></textarea><p class="local-count" data-note-status role="status">Drafting for Eli Morgan.</p><div class="section-heading"><span class="local-count" data-note-count>0 notes captured this session</span><button class="button primary" type="button" data-save-note>Save note</button></div></section>
      </div>
      <div class="modal-backdrop" data-end-class-backdrop hidden></div><section class="release-modal end-class-dialog" data-end-class-dialog role="dialog" aria-modal="true" aria-labelledby="end-class-title" hidden><button class="modal-close" type="button" data-close-end-class aria-label="Keep class active">×</button><span class="eyebrow">End active class</span><h2 id="end-class-title">Move Creative App Lab to after-class reporting?</h2><p>The timer will stop. Saved learner notes and the current class context remain available for reporting.</p><div class="actions"><button class="button secondary" type="button" data-close-end-class>Keep class active</button><a class="button primary" href="/learninghub/demo/coach/after-class">End class & review</a></div></section>
    </section>
  )}

  {journeyView === "capture" && (
    <section class="capture-shell" data-capture-shell>
      <header class="capture-header"><div><span class="eyebrow">Evidence capture</span><h1>Connect a learning moment.</h1><p>Choose the evidence that best represents this learning moment.</p></div><a data-return-live href="/learninghub/demo/coach/live">Return to active class</a></header>
      <div class="capture-stage"><div class="capture-preview"><DemoImage image={COGNIT_DEMO_IMAGES.evidence.prototypePhoto} size="evidence-photo" loading="eager" /><div class="capture-controls"><button class="selected" type="button" data-capture-mode="Photo">Photo</button><button type="button" data-capture-mode="Video">Video</button><button class="shutter" type="button" data-capture-placeholder aria-label="Capture evidence"></button></div></div><aside><span class="eyebrow">Assign this capture to</span><div class="learner-pills"><button class="selected" type="button" data-capture-learner="eli">{eli.name}</button><button type="button" data-capture-learner="lena">{lena.name}</button><button type="button" data-capture-learner="class">Whole class</button></div><p class="note-boundary">Assignment stays attached while you return to the active class.</p><h2>Recent captures</h2><div class="capture-thumbs"><DemoImage image={COGNIT_DEMO_IMAGES.evidence.prototypePhoto} size="avatar-md" /><div class="screen-thumb">Habit<br/><strong>Today</strong></div><div class="video-thumb">▶</div></div><p class="local-count" data-capture-status>3 captures in this session.</p><button class="button secondary full" type="button" data-open-mobile-drawer>Switch class</button></aside></div>
      <div class="drawer-backdrop" data-drawer-backdrop hidden></div><section class="mobile-drawer" data-mobile-drawer hidden><div class="drawer-handle"></div><div class="section-heading"><h2>Switch class</h2><button type="button" data-close-mobile-drawer>Done</button></div><button class="selected">Creative App Lab <span>2 learners · In progress</span></button><button>Digital Storytelling Lab <span>2 learners · Upcoming</span></button><button>Harbor Creative App Lab <span>1 learner · Upcoming</span></button></section>
    </section>
  )}

  {journeyView === "after-class" && (
    <section class="reporting-flow" data-reporting-flow>
      <header class="journey-hero compact"><span class="eyebrow">Class complete · reporting</span><h1>Turn teaching moments into learning records.</h1><p>Complete each learner observation, then submit the class report.</p></header>
      <section class="pending-queue card"><div class="section-heading"><div><span class="eyebrow">Pending learner observations</span><h2>Creative App Lab</h2></div><strong data-report-progress>0 of 2 complete</strong></div><div class="queue-track"><span data-report-progress-bar></span></div><div class="learner-pills report-tabs"><button class="selected" type="button" data-report-learner="eli">{eli.name}</button><button type="button" data-report-learner="lena">{lena.name}</button></div></section>
      <section class="record-spine card" aria-labelledby="coach-record-spine-title">
        <div class="section-heading"><div><span class="eyebrow">Canonical source record · Eli Morgan</span><h2 id="coach-record-spine-title">One teaching event, one connected record</h2></div><span class="status ready">Coach source</span></div>
        <ol>
          <li><span>Learning focus</span><strong>{model.primary.challenge}</strong></li>
          <li><span>Completed</span><strong>{model.primary.completed}</strong></li>
          <li><span>Evidence</span><strong>{model.primary.evidence.label}</strong><small>{model.primary.evidence.type.replace("_", " ")} · {model.primary.evidence.status}</small></li>
          <li><span>What comes next</span><strong>{model.primary.next}</strong></li>
        </ol>
        <p class="record-boundary">The Coach authors the source record. Center review and publication remain separate decisions.</p>
      </section>
      <section class="card observation-editor">
        <div class="section-heading"><div><span class="eyebrow">Student feedback loop</span><h2>Observation for <span data-report-name>{eli.name}</span></h2></div><div class="report-portraits"><span data-report-portrait="eli"><DemoImage image={getDemoStudentImage(eli.id)} size="avatar-md" /></span><span data-report-portrait="lena" hidden><DemoImage image={getDemoStudentImage(lena.id)} size="avatar-md" /></span></div></div>
        <fieldset class="evidence-picker" data-report-evidence="eli"><legend>Evidence from class</legend><button type="button" aria-pressed="true"><div class="screen-thumb">Habit<br/><strong>Today</strong></div><span>Prototype screen</span></button><button type="button" aria-pressed="true"><DemoImage image={COGNIT_DEMO_IMAGES.evidence.prototypePhoto} size="avatar-md" /><span>Testing moment</span></button><button type="button" aria-pressed="false"><div class="video-thumb">▶</div><span>Short video</span></button></fieldset>
        <section class="evidence-empty" data-report-evidence="lena" hidden><span class="eyebrow">Evidence from class</span><strong>No capture is assigned to Lena.</strong><p>Her observation can still be saved without inheriting Eli’s evidence.</p></section>
        <label>What happened today?<textarea rows="6" data-report-observation>{model.primary.observation}</textarea></label>
        <div class="assist-row"><button class="button text" type="button" data-assist-writing>Refine wording</button><span data-assist-status>Suggested wording is ready; Coach remains the author.</span></div>
        <label>Skills demonstrated<div class="skill-pills"><button type="button" aria-pressed="true" data-report-skill>Interaction testing</button><button type="button" aria-pressed="true" data-report-skill>Independent building</button><button type="button" aria-pressed="false">+ Add skill</button></div></label>
        <label>Any roadblocks? <span>Optional</span><input type="text" data-roadblock placeholder="No roadblock recorded" /></label>
        <label>Where should learning continue?<input type="text" data-next-step value={model.primary.next} /></label>
        <div class="actions"><button class="button secondary" type="button" data-previous-student disabled>Previous learner</button><button class="button primary" type="button" data-save-next>Save & next learner</button></div>
      </section>
      <div class="two-column"><section class="card"><span class="eyebrow">Overall class observation · optional</span><h2>Capture the cohort dynamic</h2><textarea rows="5" placeholder="Describe how the learners worked together."></textarea></section><section class="card"><span class="eyebrow">Direct Center note</span><h2>Flag operational follow-up</h2><div class="skill-pills"><button type="button">Schedule</button><button type="button">Equipment</button><button type="button">Positive highlight</button></div><textarea rows="5" placeholder="Add operational follow-up for Center review."></textarea></section></div>
      <section class="submit-bar"><a class="button text" href="/learninghub/demo/coach/end-of-day">Save draft & pause</a><span data-submit-help>Complete both learner observations to submit.</span><button class="button primary" type="button" data-submit-class-report disabled>Submit all observations</button></section>
      <section class="submission-receipt card" data-class-receipt hidden tabindex="-1"><span class="eyebrow">Submission receipt</span><h2>Creative App Lab reporting complete.</h2><p>Two learner observations were submitted for Center review. Family publication remains separate.</p></section>
    </section>
  )}

  {isEliWorkspace && (
    <section class="learner-workspace" data-learner-workspace data-workspace-tab={workspaceTab}>
      <header class="workspace-identity card">
        <DemoImage image={getDemoStudentImage(eli.id)} size="profile-lg" loading="eager" />
        <div><span class="eyebrow">Coach learner workspace · Creative App Lab</span><h1>{eli.name}</h1><p>{model.primary.challenge}</p><span class="status ready" data-workspace-status>Coach record in progress</span></div>
      </header>
      <nav class="workspace-tabs" aria-label="Eli Morgan workspace sections">
        {[
          ["overview", "Overview", "/learninghub/demo/coach/learners/eli"],
          ["progress", "Progress", "/learninghub/demo/coach/learners/eli/progress"],
          ["evidence", "Evidence", "/learninghub/demo/coach/learners/eli/evidence"],
          ["observations", "Observations", "/learninghub/demo/coach/learners/eli/observations"]
        ].map(([tab, label, href]) => <a href={href} aria-current={workspaceTab === tab ? "page" : undefined}>{label}</a>)}
      </nav>

      {workspaceTab === "overview" && (
        <section class="workspace-panel" aria-labelledby="workspace-overview-title"><div class="section-heading"><div><span class="eyebrow">One learner · one course record</span><h2 id="workspace-overview-title">Current learning record</h2></div><strong>2 of 3 steps</strong></div><div class="fact-grid three"><article><span>Completed</span><strong>{model.primary.completed}</strong></article><article class="current"><span>Current</span><strong>{model.primary.challenge}</strong></article><article><span>Next</span><strong>{model.primary.next}</strong></article></div><div class="two-column supporting-records"><article class="inset"><span class="eyebrow">Latest Coach observation</span><p>{model.primary.observation}</p><a href="/learninghub/demo/coach/learners/eli/observations">Review observations →</a></article><article class="inset"><span class="eyebrow">Connected evidence</span><p><strong>{model.primary.evidence.label}</strong><br/>{model.primary.evidence.type.replace("_", " ")} · {model.primary.evidence.status}</p><a href="/learninghub/demo/coach/learners/eli/evidence">Inspect evidence →</a></article></div></section>
      )}

      {workspaceTab === "progress" && (
        <section class="workspace-panel" aria-labelledby="workspace-progress-title"><div class="section-heading"><div><span class="eyebrow">Course-scoped progression</span><h2 id="workspace-progress-title">Creative App Lab</h2></div><strong>2 of 3 steps</strong></div><div class="course-progress-track" role="progressbar" aria-label="Eli Morgan Creative App Lab progress" aria-valuemin="0" aria-valuemax="3" aria-valuenow="2"><span style="width:66.666%"></span></div><ol class="progress-steps"><li class="complete"><span>Completed</span><strong>{model.primary.completed}</strong></li><li class="current"><span>Current</span><strong>{model.primary.challenge}</strong></li><li><span>Next</span><strong>{model.primary.next}</strong></li></ol><p class="record-boundary">Progress remains attached to Eli and Creative App Lab. No other course path is changed here.</p></section>
      )}

      {workspaceTab === "evidence" && (
        <section class="workspace-panel" aria-labelledby="workspace-evidence-title"><div class="section-heading"><div><span class="eyebrow">Connected evidence</span><h2 id="workspace-evidence-title">{model.primary.evidence.label}</h2></div><span class="status ready" aria-label="Evidence status: available">Available</span></div><p>Evidence connected to Eli’s Creative App Lab record. Review the photo, screenshot, and video relationships below.</p><div class="evidence-gallery" aria-label="Evidence previews"><figure><DemoImage image={COGNIT_DEMO_IMAGES.evidence.prototypePhoto} size="evidence-photo" loading="eager" /><figcaption>Photo preview · interaction testing moment</figcaption></figure><figure><div class="screen-evidence">Habit<br/><strong>Today</strong><span aria-hidden="true">✓</span></div><figcaption>Screenshot preview · prototype state</figcaption></figure><figure><div class="video-evidence"><span aria-hidden="true">▶</span><strong>Interaction test</strong></div><figcaption>Video preview · learning clip</figcaption></figure></div><dl class="evidence-metadata"><div><dt>Type</dt><dd>{model.primary.evidence.type.replace("_", " ")}</dd></div><div><dt>Status</dt><dd>{model.primary.evidence.status}</dd></div><div><dt>Source</dt><dd>Creative App Lab teaching event</dd></div></dl></section>
      )}

      {workspaceTab === "observations" && (
        <section class="workspace-panel observations-panel" aria-labelledby="workspace-observations-title"><div class="section-heading"><div><span class="eyebrow">Coach-authored interpretation</span><h2 id="workspace-observations-title">Observation connected to the work</h2></div><span class="status">Draft source record</span></div><blockquote>{model.primary.observation}</blockquote><div class="fact-grid"><article><span>Evidence reference</span><strong>{model.primary.evidence.label}</strong></article><article><span>Where learning continues</span><strong>{model.primary.next}</strong></article></div><p class="record-boundary">Private quick-note drafts and learner reflections are not included in the Center submission package.</p></section>
      )}

      <section class="submission-panel" aria-labelledby="submit-center-title">
        <div class="submission-action card">
          <div class="submission-copy">
            <span class="eyebrow">Coach → Center handoff</span>
            <h2 id="submit-center-title">Submit this learning record to Center review</h2>
            <p>Submission sends this learning record into Center review. It does not publish to Student or Family.</p>
          </div>
          <div class="submission-readiness" aria-labelledby="report-readiness-title">
            <h3 id="report-readiness-title">Report readiness</h3>
            <ul class="readiness-list">
              <li><span class="readiness-icon" aria-hidden="true">✓</span><span>Course Progress and Next Step</span></li>
              <li><span class="readiness-icon" aria-hidden="true">✓</span><span>Coach Observation</span></li>
              <li><span class="readiness-icon" aria-hidden="true">✓</span><span>Connected Evidence Reference</span></li>
              <li><span class="readiness-icon" aria-hidden="true">✓</span><span>Private reflections and unsaved quick-note drafts excluded</span></li>
            </ul>
          </div>
          <div class="submission-action-row">
            <p class="record-boundary">After submission, the report is locked while Center reviews it.</p>
            <button class="button primary" type="button" data-open-center-submit>Submit to Center</button>
          </div>
        </div>
        <div class="submission-lifecycle-block card">
          <span class="lifecycle-label">Report status</span>
          <ol class="submission-lifecycle" aria-label="Learning record lifecycle">
            <li class="complete"><span class="lifecycle-marker" aria-hidden="true">✓</span><span class="lifecycle-copy"><strong>Coach draft</strong><small>Complete</small></span></li>
            <li class="next"><span class="lifecycle-marker" aria-hidden="true">2</span><span class="lifecycle-copy"><strong>Center review</strong><small>Next after submission</small></span></li>
            <li class="future"><span class="lifecycle-marker" aria-hidden="true">3</span><span class="lifecycle-copy"><strong>Center publication</strong><small>Future</small></span></li>
            <li class="future"><span class="lifecycle-marker" aria-hidden="true">4</span><span class="lifecycle-copy"><strong>Student &amp; Family visibility</strong><small>Future</small></span></li>
          </ol>
        </div>
        <section class="submission-receipt" data-center-submit-receipt hidden tabindex="-1"><span class="eyebrow">Submission receipt</span><h3>Submitted for Center review.</h3><p>Progress, evidence reference, observation, and next step were included. Student and Family visibility remains held until a separate Center publication decision.</p></section>
      </section>
      <div class="modal-backdrop" data-center-submit-backdrop hidden></div><section class="release-modal" data-center-submit-dialog role="dialog" aria-modal="true" aria-labelledby="center-submit-dialog-title" hidden><button class="modal-close" type="button" data-close-center-submit aria-label="Cancel submission">×</button><span class="eyebrow">Confirm Center handoff</span><h2 id="center-submit-dialog-title">Submit Eli’s Creative App Lab record?</h2><p>The Center will receive the scoped record for review. This action does not publish anything to the Student or Family views.</p><div class="actions"><button class="button secondary" type="button" data-close-center-submit>Cancel</button><button class="button primary" type="button" data-confirm-center-submit>Confirm submission</button></div></section>
    </section>
  )}

  {journeyView === "correspondence" && (
    <section class="correspondence" data-correspondence>
      <header class="journey-hero compact"><span class="eyebrow">Coach correspondence</span><h1>Send the right note to the right relationship.</h1><p>Center operations and authorized Family communication remain distinct. No prior message history is invented.</p></header>
      <div class="recipient-grid" role="group" aria-label="Choose correspondence recipient"><button class="recipient-card selected" type="button" data-correspondence-target="center" aria-pressed="true"><span class="eyebrow">Operational</span><strong>Northfield Studio Center team</strong><small>Creative App Lab · scheduling, equipment, or Center follow-up</small></button><button class="recipient-card" type="button" data-correspondence-target="family" aria-pressed="false"><span class="eyebrow">Authorized learner relationship</span><strong>Morgan Family</strong><small>Eli Morgan · Creative App Lab only</small></button></div>
      <section class="card correspondence-form"><form data-correspondence-form><div class="form-grid"><label>Recipient<input data-correspondence-recipient readonly value="Northfield Studio Center team" /></label><label>Context<input readonly value="Eli Morgan · Creative App Lab" /></label></div><label>Subject<input required data-correspondence-subject value="Creative App Lab follow-up" /></label><label>Message<textarea required rows="7" data-correspondence-message placeholder="Write a scoped Coach message."></textarea></label><p class="record-boundary" data-correspondence-boundary>Center correspondence is operational. It does not publish a learning story.</p><div class="form-status-row"><p data-correspondence-status role="status">Ready for a scoped note.</p><button class="button primary" type="submit">Save note</button></div></form></section>
    </section>
  )}

  {journeyView === "end-of-day" && (
    <>
      <header class="journey-hero compact"><span class="eyebrow">Pending deliverables</span><h1>End-of-day review</h1><p>Resume unfinished Coach reporting without losing the class relationship.</p></header>
      <section class="card eod-card"><article><div><strong>Creative App Lab</strong><span>Eli Morgan · Lena Grant</span><div class="queue-track"><span style="width:50%"></span></div></div><strong>1 of 2 complete</strong><a class="button secondary" href="/learninghub/demo/coach/after-class">Resume report</a></article><article><div><strong>Digital Storytelling Lab</strong><span>Mina Park · Ava Thompson</span><div class="queue-track"><span style="width:0%"></span></div></div><strong>0 of 2 complete</strong><a class="button secondary" href="/learninghub/demo/coach/after-class">Review queue</a></article><article><div><strong>Harbor Creative App Lab</strong><span>Noah Bennett</span><div class="queue-track"><span style="width:100%"></span></div></div><strong>Complete</strong><span class="status ready">Submitted</span></article></section>
      <a class="button primary" href="/learninghub/demo/coach/today">Return to today’s teaching</a>
    </>
  )}

  {journeyView === "releases" && (
    <section data-release-page>
      <header class="journey-hero compact"><span class="eyebrow">What’s new</span><h1>Coach release notes</h1><p>Release notes explain visible Coach-slice improvements without making deployment or operational claims.</p><button class="button primary" type="button" data-open-release>View current release</button></header>
      <div class="release-list">{releases.map((release, index) => <article class="card"><div><time>{release.date}</time>{index === 0 && <span class="status ready">Current</span>}</div><h2>{release.version} — {release.title}</h2><p>{release.summary}</p><details><summary>Read details</summary><ul><li>Audience: Coach</li><li>Area: Coach workflow</li></ul></details></article>)}</div>
      <div class="modal-backdrop" data-release-backdrop hidden></div><section class="release-modal" data-release-modal role="dialog" aria-modal="true" aria-labelledby="release-modal-title" hidden><button class="modal-close" type="button" data-close-release aria-label="Close release notes">×</button><span class="eyebrow">What’s new · available now</span><h2 id="release-modal-title">Faster Coach capture and reporting</h2><p>Move from preparation to live notes, connected evidence, and learner reporting with fewer detours.</p><ul><li><strong>During class</strong><span>Timer, class switching, quick notes, and evidence shell.</span></li><li><strong>After class</strong><span>Learner queue, evidence selection, observations, and gating.</span></li><li><strong>Recovery</strong><span>End-of-day pending deliverables and Support access.</span></li></ul><button class="button primary full" type="button" data-close-release>Got it</button></section>
    </section>
  )}

  {journeyView === "support" && (
    <section class="support-demo" data-support-demo>
      <header class="journey-hero compact"><span class="eyebrow">Coach support</span><h1>Find answers or prepare a request.</h1><p>Review common workflow guidance or prepare a support request.</p></header>
      <section class="card support-form"><form data-local-support-form><div class="form-grid"><label>Subject<input required name="subject" placeholder="What do you need help with?" /></label><label>Problem type<select required name="type"><option value="">Select a problem type</option><option>Classes</option><option>Evidence</option><option>Scheduling</option><option>Technical issue</option></select></label></div><label>Message<textarea required name="message" rows="6" placeholder="Describe what happened."></textarea></label><div class="form-status-row"><p data-support-status role="status">No request has been created.</p><button class="button primary" type="submit">Review request</button></div></form></section>
      <section class="faq"><div class="section-heading"><div><span class="eyebrow">Frequently asked questions</span><h2>Coach workflow help</h2></div><input type="search" placeholder="Search questions" data-faq-search /></div>{["How do I begin a class?","How do I capture evidence?","Can I pause reporting?","How do I switch classes?","What does Family see?"].map((question) => <details data-faq-item><summary>{question}</summary><p>The action stays connected to the learner, course, and class. Family visibility begins only after a separate publishing decision.</p></details>)}</section>
    </section>
  )}

  {journeyView === "profile" && (
    <><header class="journey-hero compact"><span class="eyebrow">Coach profile</span><h1>{model.person.name}</h1><p>{model.person.focus}</p></header><section class="card profile-card"><DemoImage image={getDemoCoachImage(model.person.id)} size="profile-lg" loading="eager" /><dl><div><dt>Primary context</dt><dd>{model.context.name}</dd></div><div><dt>Current course</dt><dd>{model.session.course.name}</dd></div><div><dt>Role</dt><dd>Coach · Creative App Lab</dd></div></dl></section></>
  )}
</section>

<script>
  document.querySelectorAll("[data-coach-journey]").forEach((root) => {
    const switchButton = root.querySelector("[data-class-switch]");
    const switchPanel = root.querySelector("[data-class-switch-panel]");
    switchButton?.addEventListener("click", () => { const open = switchButton.getAttribute("aria-expanded") === "true"; switchButton.setAttribute("aria-expanded", String(!open)); if (switchPanel instanceof HTMLElement) switchPanel.hidden = open; });
    const timer = root.querySelector("[data-live-timer]");
    if (timer) { const timerKey = "cognit:coach-live-start:v1"; const started = Number(sessionStorage.getItem(timerKey)) || Date.now(); sessionStorage.setItem(timerKey, String(started)); const renderTimer = () => { const seconds = Math.max(0, Math.floor((Date.now() - started) / 1000)); timer.textContent = `${String(Math.floor(seconds / 60)).padStart(2,"0")}:${String(seconds % 60).padStart(2,"0")}`; }; renderTimer(); window.setInterval(renderTimer, 1000); }
    const noteArea = root.querySelector("[data-quick-note]"); const noteStatus = root.querySelector("[data-note-status]"); const noteNames = { eli: "Eli Morgan", lena: "Lena Grant", class: "Whole class" }; const noteKey = "cognit:coach-live-notes:v1"; let noteLearner = "eli"; let noteDrafts = {}; try { noteDrafts = JSON.parse(sessionStorage.getItem(noteKey) || "{}"); } catch { noteDrafts = {}; }
    const persistNotes = () => sessionStorage.setItem(noteKey, JSON.stringify(noteDrafts)); const selectNoteLearner = (learner) => { if (noteArea) noteDrafts[noteLearner] = noteArea.value; noteLearner = learner; if (noteArea) { noteArea.value = noteDrafts[noteLearner] || ""; noteArea.setAttribute("aria-label", `Quick observation note for ${noteNames[noteLearner]}`); } root.querySelectorAll("[data-note-learner]").forEach((button) => button.classList.toggle("selected", button.getAttribute("data-note-learner") === noteLearner)); const captureLink = root.querySelector("[data-capture-link]"); if (captureLink) captureLink.setAttribute("href", `/learninghub/demo/coach/capture?learner=${noteLearner}&return=live`); if (noteStatus) noteStatus.textContent = `Drafting for ${noteNames[noteLearner]}.`; persistNotes(); };
    root.querySelectorAll("[data-note-learner]").forEach((button) => button.addEventListener("click", () => selectNoteLearner(button.getAttribute("data-note-learner")))); noteArea?.addEventListener("input", () => { noteDrafts[noteLearner] = noteArea.value; persistNotes(); }); selectNoteLearner("eli");
    root.querySelector("[data-save-note]")?.addEventListener("click", () => { const count = root.querySelector("[data-note-count]"); if (!count || !noteArea || !noteArea.value.trim()) { if (noteStatus) noteStatus.textContent = `Add a note for ${noteNames[noteLearner]} before saving.`; return; } const prior = Number(count.getAttribute("data-count") || 0) + 1; count.setAttribute("data-count", String(prior)); count.textContent = `${prior} note${prior === 1 ? "" : "s"} captured this session`; noteDrafts[noteLearner] = ""; noteArea.value = ""; persistNotes(); if (noteStatus) noteStatus.textContent = `Saved for ${noteNames[noteLearner]}.`; });
    const endDialog = root.querySelector("[data-end-class-dialog]"); const endBackdrop = root.querySelector("[data-end-class-backdrop]"); const endOpener = root.querySelector("[data-open-end-class]"); const setEndDialog = (open) => { if (endDialog instanceof HTMLElement) { endDialog.hidden = !open; if (open) endDialog.querySelector("button")?.focus(); else if (endOpener instanceof HTMLElement) endOpener.focus(); } if (endBackdrop instanceof HTMLElement) endBackdrop.hidden = !open; }; endOpener?.addEventListener("click", () => setEndDialog(true)); root.querySelectorAll("[data-close-end-class]").forEach((button) => button.addEventListener("click", () => setEndDialog(false))); endBackdrop?.addEventListener("click", () => setEndDialog(false));
    root.querySelectorAll("[data-capture-mode]").forEach((button) => button.addEventListener("click", () => { root.querySelectorAll("[data-capture-mode]").forEach((item) => item.classList.remove("selected")); button.classList.add("selected"); }));
    const captureParams = new URLSearchParams(window.location.search); const captureNames = { eli: "Eli Morgan", lena: "Lena Grant", class: "Whole class" }; let captureLearner = captureParams.get("learner") || "eli"; const renderCaptureLearner = () => { root.querySelectorAll("[data-capture-learner]").forEach((button) => button.classList.toggle("selected", button.getAttribute("data-capture-learner") === captureLearner)); const returnLink = root.querySelector("[data-return-live]"); if (returnLink) returnLink.setAttribute("href", `/learninghub/demo/coach/live?learner=${captureLearner}`); }; root.querySelectorAll("[data-capture-learner]").forEach((button) => button.addEventListener("click", () => { captureLearner = button.getAttribute("data-capture-learner"); renderCaptureLearner(); })); renderCaptureLearner();
    root.querySelector("[data-capture-placeholder]")?.addEventListener("click", () => { const status = root.querySelector("[data-capture-status]"); if (status) status.textContent = `Capture saved and assigned to ${captureNames[captureLearner]}.`; });
    const drawer = root.querySelector("[data-mobile-drawer]"); const drawerBackdrop = root.querySelector("[data-drawer-backdrop]"); const setDrawer = (open) => { if (drawer instanceof HTMLElement) drawer.hidden = !open; if (drawerBackdrop instanceof HTMLElement) drawerBackdrop.hidden = !open; };
    root.querySelector("[data-open-mobile-drawer]")?.addEventListener("click", () => setDrawer(true)); root.querySelector("[data-close-mobile-drawer]")?.addEventListener("click", () => setDrawer(false)); drawerBackdrop?.addEventListener("click", () => setDrawer(false));
    const reporting = root.querySelector("[data-reporting-flow]");
    if (reporting) {
      const drafts = { eli: { name: "Eli Morgan", observation: reporting.querySelector("[data-report-observation]")?.value || "", next: reporting.querySelector("[data-next-step]")?.value || "", complete: false }, lena: { name: "Lena Grant", observation: "", next: "Test the reusable component in two flows.", complete: false } }; let selected = "eli";
      const render = () => { const draft = drafts[selected]; reporting.querySelector("[data-report-name]").textContent = draft.name; reporting.querySelector("[data-report-observation]").value = draft.observation; reporting.querySelector("[data-next-step]").value = draft.next; reporting.querySelectorAll("[data-report-learner]").forEach((button) => button.classList.toggle("selected", button.getAttribute("data-report-learner") === selected)); reporting.querySelectorAll("[data-report-portrait]").forEach((portrait) => { portrait.hidden = portrait.getAttribute("data-report-portrait") !== selected; }); reporting.querySelectorAll("[data-report-evidence]").forEach((evidence) => { evidence.hidden = evidence.getAttribute("data-report-evidence") !== selected; }); reporting.querySelectorAll("[data-report-skill]").forEach((skill) => skill.setAttribute("aria-pressed", String(selected === "eli"))); reporting.querySelector("[data-previous-student]").disabled = selected === "eli"; const complete = Object.values(drafts).filter((draft) => draft.complete).length; reporting.querySelector("[data-report-progress]").textContent = `${complete} of 2 complete`; reporting.querySelector("[data-report-progress-bar]").style.width = `${complete * 50}%`; reporting.querySelector("[data-submit-class-report]").disabled = complete !== 2; };
      reporting.querySelectorAll("[data-report-learner]").forEach((button) => button.addEventListener("click", () => { selected = button.getAttribute("data-report-learner"); render(); }));
      reporting.querySelector("[data-report-observation]")?.addEventListener("input", (event) => { drafts[selected].observation = event.target.value; drafts[selected].complete = false; render(); }); reporting.querySelector("[data-next-step]")?.addEventListener("input", (event) => { drafts[selected].next = event.target.value; drafts[selected].complete = false; render(); });
      reporting.querySelector("[data-assist-writing]")?.addEventListener("click", () => { if (selected === "eli") drafts.eli.observation = "Eli independently built the core navigation, tested it with a classmate, and revised one confusing interaction."; reporting.querySelector("[data-assist-status]").textContent = selected === "eli" ? "Suggested wording placed in the Coach draft; review before saving." : "Add a Coach-authored observation before requesting wording help."; render(); });
      reporting.querySelector("[data-save-next]")?.addEventListener("click", () => { drafts[selected].complete = Boolean(drafts[selected].observation.trim() && drafts[selected].next.trim()); if (selected === "eli") selected = "lena"; render(); }); reporting.querySelector("[data-previous-student]")?.addEventListener("click", () => { selected = "eli"; render(); });
      reporting.querySelector("[data-submit-class-report]")?.addEventListener("click", () => { if (!Object.values(drafts).every((draft) => draft.complete)) return; reporting.querySelector("[data-submit-help]").textContent = "Submission complete."; const receipt = reporting.querySelector("[data-class-receipt]"); if (receipt instanceof HTMLElement) { receipt.hidden = false; receipt.focus(); } }); render();
    }
    root.querySelectorAll("[data-close-release]").forEach((button) => button.addEventListener("click", () => { const modal = root.querySelector("[data-release-modal]"); const backdrop = root.querySelector("[data-release-backdrop]"); if (modal instanceof HTMLElement) modal.hidden = true; if (backdrop instanceof HTMLElement) backdrop.hidden = true; })); root.querySelector("[data-open-release]")?.addEventListener("click", () => { const modal = root.querySelector("[data-release-modal]"); const backdrop = root.querySelector("[data-release-backdrop]"); if (modal instanceof HTMLElement) { modal.hidden = false; modal.querySelector("button")?.focus(); } if (backdrop instanceof HTMLElement) backdrop.hidden = false; });
    root.querySelector("[data-local-support-form]")?.addEventListener("submit", (event) => { event.preventDefault(); const form = event.currentTarget; const status = root.querySelector("[data-support-status]"); if (form.checkValidity()) status.textContent = "Request is ready for review."; else status.textContent = "Complete the required fields to review the request."; });
    const search = root.querySelector("[data-faq-search]"); search?.addEventListener("input", () => { const query = search.value.toLowerCase(); root.querySelectorAll("[data-faq-item]").forEach((item) => { item.hidden = !item.textContent.toLowerCase().includes(query); }); });
    const workspace = root.querySelector("[data-learner-workspace]");
    if (workspace) { const submitKey = "cognit:coach-eli-center-submission:v1"; const dialog = workspace.querySelector("[data-center-submit-dialog]"); const backdrop = workspace.querySelector("[data-center-submit-backdrop]"); const receipt = workspace.querySelector("[data-center-submit-receipt]"); const submitButton = workspace.querySelector("[data-open-center-submit]"); const setSubmitDialog = (open) => { if (dialog instanceof HTMLElement) { dialog.hidden = !open; if (open) dialog.querySelector("button")?.focus(); else if (submitButton instanceof HTMLElement) submitButton.focus(); } if (backdrop instanceof HTMLElement) backdrop.hidden = !open; }; submitButton?.addEventListener("click", () => setSubmitDialog(true)); workspace.addEventListener("keydown", (event) => { if (event.key === "Escape" && dialog instanceof HTMLElement && !dialog.hidden) setSubmitDialog(false); }); const renderSubmitted = () => { const submitted = localStorage.getItem(submitKey) === "submitted"; if (receipt instanceof HTMLElement) receipt.hidden = !submitted; if (submitButton instanceof HTMLButtonElement) { submitButton.disabled = submitted; submitButton.textContent = submitted ? "Submitted to Center" : "Submit to Center"; } const status = workspace.querySelector("[data-workspace-status]"); if (status) status.textContent = submitted ? "Submitted · awaiting Center review" : "Coach record in progress"; }; workspace.querySelectorAll("[data-close-center-submit]").forEach((button) => button.addEventListener("click", () => setSubmitDialog(false))); backdrop?.addEventListener("click", () => setSubmitDialog(false)); workspace.querySelector("[data-confirm-center-submit]")?.addEventListener("click", () => { localStorage.setItem(submitKey, "submitted"); setSubmitDialog(false); renderSubmitted(); if (receipt instanceof HTMLElement) receipt.focus(); }); renderSubmitted(); }
    const correspondence = root.querySelector("[data-correspondence]");
    if (correspondence) { const targets = { center: { recipient: "Northfield Studio Center team", subject: "Creative App Lab follow-up", boundary: "Center correspondence is operational. It does not publish a learning story." }, family: { recipient: "Authorized Morgan Family", subject: "Eli’s Creative App Lab update", boundary: "Family correspondence is scoped to Eli and Creative App Lab. It does not include other learners or private drafts." } }; const draftKey = "cognit:coach-correspondence-drafts:v1"; let drafts = {}; try { drafts = JSON.parse(sessionStorage.getItem(draftKey) || "{}"); } catch { drafts = {}; } let target = new URLSearchParams(window.location.search).get("recipient") === "family" ? "family" : "center"; const message = correspondence.querySelector("[data-correspondence-message]"); const subject = correspondence.querySelector("[data-correspondence-subject]"); const saveDraft = () => { drafts[target] = { message: message?.value || "", subject: subject?.value || "" }; sessionStorage.setItem(draftKey, JSON.stringify(drafts)); }; const renderTarget = () => { const config = targets[target]; correspondence.querySelectorAll("[data-correspondence-target]").forEach((button) => { const selected = button.getAttribute("data-correspondence-target") === target; button.classList.toggle("selected", selected); button.setAttribute("aria-pressed", String(selected)); }); correspondence.querySelector("[data-correspondence-recipient]").value = config.recipient; correspondence.querySelector("[data-correspondence-boundary]").textContent = config.boundary; if (subject) subject.value = drafts[target]?.subject || config.subject; if (message) message.value = drafts[target]?.message || ""; }; correspondence.querySelectorAll("[data-correspondence-target]").forEach((button) => button.addEventListener("click", () => { saveDraft(); target = button.getAttribute("data-correspondence-target"); renderTarget(); })); subject?.addEventListener("input", saveDraft); message?.addEventListener("input", saveDraft); correspondence.querySelector("[data-correspondence-form]")?.addEventListener("submit", (event) => { event.preventDefault(); const form = event.currentTarget; const status = correspondence.querySelector("[data-correspondence-status]"); if (!form.checkValidity()) { if (status) status.textContent = "Complete the subject and message before saving."; return; } if (status) status.textContent = `Note saved for ${targets[target].recipient}.`; drafts[target] = { message: "", subject: targets[target].subject }; sessionStorage.setItem(draftKey, JSON.stringify(drafts)); if (message) message.value = ""; }); renderTarget(); }
    root.addEventListener("keydown", (event) => { if (event.key === "Escape" && endDialog instanceof HTMLElement && !endDialog.hidden) setEndDialog(false); });
  });
</script>

<style>
  .coach-journey{display:grid;gap:clamp(28px,5vw,54px);min-width:0}.coach-journey>*{min-width:0}.coach-journey :is(h1,h2,h3,p,strong,span,a,label){overflow-wrap:anywhere}.learner-workspace{display:grid;min-width:0}.learner-workspace>*{min-width:0}
  .journey-hero{max-width:820px}.journey-hero h1{margin:.3rem 0 .8rem;font-size:clamp(2.7rem,6vw,5rem);line-height:.95;letter-spacing:-.045em}.journey-hero p{margin:0;color:var(--color-muted);font-size:1.05rem;line-height:1.6}.eyebrow{display:block;color:var(--color-muted);font-size:.72rem;font-weight:950;letter-spacing:.04em;text-transform:uppercase}
  .card{padding:clamp(20px,4vw,34px);border:1px solid var(--color-border);border-radius:18px;background:#fff;box-shadow:var(--shadow-soft)}.button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:11px 18px;border:1px solid transparent;border-radius:10px;background:var(--color-ink);color:#fff;font:inherit;font-weight:900;cursor:pointer;text-decoration:none}.button.secondary{border-color:var(--color-border);background:#fff;color:var(--color-ink)}
