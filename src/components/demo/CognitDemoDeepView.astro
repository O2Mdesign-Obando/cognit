---
import DemoLoopNav from "./DemoLoopNav.astro";
import DemoImage from "./DemoImage.astro";
import { getCognitDemoData, getCognitDemoPerspectiveModel } from "../../demo/cognit-demo-model.js";
import { COGNIT_DEMO_IMAGES, getDemoCoachImage, getDemoContextImage, getDemoFamilyImage, getDemoStudentImage } from "../../demo/cognit-demo-images.js";
import { parseCenterDemoView } from "../../demo/cognit-demo-routes.js";

const { role, view } = Astro.props;
const data = getCognitDemoData();
const roleModel = getCognitDemoPerspectiveModel(role);
const centerView = role === "center" ? parseCenterDemoView(view) : null;
const [roleSection, roleItem = ""] = view.split("/");
const section = centerView?.section ?? roleSection;
const item = centerView?.item ?? roleItem;
const studentMyWorkSections = new Set(["my-work", "artifact", "progress"]);
const active = role === "student" && studentMyWorkSections.has(section) ? "my-work" : section;
const contextKey = centerView?.context || "northfield";
const studentSlug = (studentId) => studentId.replace("demo-student-", "").split("-")[0];
const findStudent = (slug) => data.people.students.find((person) => studentSlug(person.id) === slug);
const findCourse = (id) => data.courses.find((course) => course.id === id);
const findCoach = (id) => data.people.coaches.find((coach) => coach.id === id);
const findContext = (id) => data.contexts.find((context) => context.id === id);
const findFamily = (slug) => data.people.families.find((family) => family.id.endsWith(`-${slug}`));
const familySlug = (familyId) => familyId.replace("demo-family-", "");
const selectedStudent = item && section === "students" ? findStudent(item) : null;
const selectedFamily = item && section === "families" ? findFamily(item) : null;
const selectedContext = role === "center" ? findContext(contextKey === "harbor" ? "demo-context-harbor-academy" : "demo-context-northfield-studio") : null;
const selectedContextEnrollments = selectedContext ? data.enrollments.filter((enrollment) => enrollment.contextId === selectedContext.id && enrollment.status === "active") : [];
const selectedContextStudentIds = new Set(selectedContextEnrollments.map((enrollment) => enrollment.studentId));
const selectedContextSessions = selectedContext ? data.sessions.filter((session) => session.contextId === selectedContext.id) : [];
const selectedContextStudents = data.people.students.filter((student) => selectedContextStudentIds.has(student.id));
const selectedContextFamilies = data.people.families.filter((family) => family.studentIds.some((studentId) => selectedContextStudentIds.has(studentId)));
const selectedContextAttendance = data.attendance.filter((record) => selectedContextEnrollments.some((enrollment) => enrollment.studentId === record.studentId && enrollment.courseId === record.courseId));
const selectedContextEvents = data.learningEvents.filter((event) => selectedContextEnrollments.some((enrollment) => enrollment.studentId === event.studentId && enrollment.courseId === event.courseId));
const selectedContextMessages = contextKey === "northfield" ? data.messages : [];

const meta = {
  center: {
    overview: ["Operating context", selectedContext?.name, selectedContext?.purpose],
    schedule: ["Schedule", `${selectedContext?.name} sessions`, "Inspect course, Coach, learner, time, and session status."],
    students: ["Students", selectedStudent ? selectedStudent.name : `${selectedContext?.name} learners`, selectedStudent ? "Current participation, attendance, and preserved enrollment history." : `${selectedContextStudents.length} learner${selectedContextStudents.length === 1 ? "" : "s"} in this operating context.`],
    families: ["Families", selectedFamily ? selectedFamily.name : `${selectedContext?.name} Family relationships`, "Scoped learning visibility relationships without fabricated contact details."],
    attendance: ["Attendance", item === "sofia" ? "Sofia Reyes · attendance and makeup" : item === "eli" ? "Eli Morgan · attendance" : `${selectedContext?.name} attendance`, "Attendance and makeup information scoped to the selected operating context."],
    reports: ["Reports", item === "sofia" ? "Sofia Reyes · review exception" : item === "eli" ? "Eli Morgan · processed report" : `${selectedContext?.name} reports`, "Learning reports scoped to the selected operating context."],
    messages: ["Messages", `${selectedContext?.name} operational conversations`, "Message threads scoped to the selected operating context."],
    settings: ["Settings", `${selectedContext?.name} context`, "Context metadata and shared policy for this learning operation."]
  },
  coach: {
    class: ["Class", "Creative App Lab learners", "Open a learner to see the current learning context."],
    learners: ["Learner", `${findStudent(item)?.name} · Creative App Lab`, "The current challenge, Coach observation, and course-specific progress."],
    "learning-plan": ["Learning Plan", "Habit-tracking app prototype", "A concrete learning sequence for today’s Creative App Lab."],
    progress: ["Progress", item === "lena" ? "Lena Grant · two course paths" : "Course progression", "Progress remains attached to the relevant learner and course."],
    observations: ["Observations", "Learning evidence and interpretation", "Concise observations stay connected to the learning work."],
    evidence: ["Evidence", "Habit Tracker — interaction flow prototype", "Evidence connected to Eli’s Creative App Lab learning record."],
    reporting: ["Reporting", "Learning update states", "See why one update flows normally and one returns for clarification."]
  },
  student: {
    "my-work": ["My Work", "Habit Tracker prototype", "See what you’ve finished, what you’re working on, and what comes next."],
    artifact: ["Latest work", "Habit Tracker — interaction flow prototype", "The project you worked on today."],
    progress: ["Progress", "Creative App Lab progress", "See what you’ve completed, what you’re doing now, and what comes next."],
    courses: ["Courses", item === "lena" ? "Lena Grant · two active courses" : "My active course", item === "lena" ? "One student can participate in separate courses." : "Keep learning in Creative App Lab or explore Lena’s separate course paths."],
    journey: ["Learning Journey", item === "eli" ? "A working first flow, improved through testing" : "Published learning stories", "An easy way to see what changed and what comes next."]
  },
  family: {
    journey: ["Learning Journey", item === "eli" ? "A working first flow, improved through testing" : "Published learning updates", "The Family-facing story translated from the same learning event."],
    attendance: ["Attendance", item === "sofia" ? "Sofia Reyes · makeup available" : item === "eli" ? "Eli Morgan · present" : "Attendance and makeup", "Clear current status and any Family action."],
    messages: ["Messages", "Family communication", "A private exchange about Sofia’s makeup option."],
    account: ["Account", "Learning visibility preferences", "Safe Family-level settings without fabricated personal contact information."]
  }
}[role][section];

const eliEvent = data.learningEvents.find((event) => event.id === "demo-event-eli-habit-flow");
const sofiaEvent = data.learningEvents.find((event) => event.id === "demo-event-sofia-sensor-test");
const learnerEnrollments = selectedStudent ? data.enrollments.filter((enrollment) => enrollment.studentId === selectedStudent.id) : [];
const learnerProgress = selectedStudent ? data.courseProgress.filter((progress) => progress.studentId === selectedStudent.id) : [];
const familyStudent = selectedFamily ? findStudent(studentSlug(selectedFamily.studentIds[0])) : null;
---

<DemoLoopNav role={role} active={active} context={contextKey} />
{role === "student" && studentMyWorkSections.has(section) && (
  <nav class="student-work-nav" aria-label="My Work sections">
    <a href="/learninghub/demo/student/my-work" aria-current={section === "my-work" ? "page" : undefined}>Overview</a>
    <a href="/learninghub/demo/student/artifact" aria-current={section === "artifact" ? "page" : undefined}>Latest work</a>
    <a href="/learninghub/demo/student/progress" aria-current={section === "progress" ? "page" : undefined}>Progress</a>
  </nav>
)}

<header class="deep-heading">
  <a href={`/learninghub/demo/${role}`}>{role[0].toUpperCase() + role.slice(1)} overview</a>
  <span>{meta[0]}</span>
  <h1>{meta[1]}</h1>
  <p>{meta[2]}</p>
</header>

<div class="deep-content" data-demo-view={`${role}/${view}`}>
  {role === "center" && section === "schedule" && !item && (
    selectedContextSessions.length ? <section class="record-list" aria-label={`${selectedContext.name} sessions`}>
      {selectedContextSessions.map((session) => {
        const course = findCourse(session.courseId); const coach = findCoach(session.coachId);
        return <article class="record-row"><div><span>{session.label}</span><h2>{course.name}</h2><p>{findContext(session.contextId).name}</p></div><div><strong>{coach.name}</strong><span>{session.studentIds.length} learners</span></div><span class={`state ${session.status}`}>{session.status.replaceAll("_", " ")}</span>{session.id === "demo-session-creative-today" ? <a href="/learninghub/demo/center/schedule/creative">Inspect session →</a> : <span>Scheduled context</span>}</article>;
      })}
    </section> : <section class="empty-state" aria-labelledby="empty-schedule"><span>Scoped schedule</span><h2 id="empty-schedule">No sessions in {selectedContext.name}</h2><p>This context has no scheduled sessions in the current view.</p></section>
  )}

  {role === "center" && section === "schedule" && item === "creative" && (
    <section class="detail-card"><span class="eyebrow">In progress · Northfield Studio</span><h2>Creative App Lab</h2><p>{data.sessions[0].learningFocus}</p><dl><div><dt>Coach</dt><dd>Jordan Ellis</dd></div><div><dt>Time</dt><dd>{data.sessions[0].label}</dd></div><div><dt>Learners</dt><dd>Eli Morgan · Lena Grant</dd></div></dl><a class="primary-link" href="/learninghub/demo/center/students/eli">Open Eli’s learner context →</a></section>
  )}

  {role === "center" && section === "students" && !item && (
    selectedContextStudents.length ? <section class="card-grid three" aria-label={`${selectedContext.name} learner roster`}>{selectedContextStudents.map((student) => { const activeEnrollments = selectedContextEnrollments.filter((entry) => entry.studentId === student.id); return <a class="entity-card" href={`/learninghub/demo/center/students/${studentSlug(student.id)}`}><DemoImage image={getDemoStudentImage(student.id)} size="avatar-md" /><span>Learner</span><h2>{student.name}</h2><p>{activeEnrollments.map((entry) => findCourse(entry.courseId).name).join(" · ")}</p><small>{selectedContext.name}</small><b>Open learner →</b></a>; })}</section> : <section class="empty-state" aria-labelledby="empty-students"><span>Scoped learners</span><h2 id="empty-students">No learners in {selectedContext.name}</h2><p>No active learner enrollments exist in this operating context.</p></section>
  )}

  {role === "center" && section === "students" && selectedStudent && (
    <section class="detail-stack"><article class="detail-card"><div class="profile-heading"><DemoImage image={getDemoStudentImage(selectedStudent.id)} size="profile-lg" loading="eager" /><div><span class="eyebrow">One learner identity</span><h2>{selectedStudent.name}</h2></div></div><div class="fact-grid">{learnerEnrollments.map((enrollment) => <div><span>{enrollment.status}</span><strong>{findCourse(enrollment.courseId).name}</strong><small>{findContext(enrollment.contextId).name} · {enrollment.source.replaceAll("_", " ")}</small></div>)}</div></article><article class="detail-card"><h2>Course-specific learning</h2>{learnerProgress.map((progress) => <div class="progress-record"><div><strong>{findCourse(progress.courseId).name}</strong><span>{progress.completed} of {progress.total} steps</span></div><p>Current: {progress.current}</p><small>Next: {progress.next}</small></div>)}</article></section>
  )}

  {role === "center" && section === "families" && !item && (
    selectedContextFamilies.length ? <section class="card-grid three">{selectedContextFamilies.map((family) => <a class="entity-card" href={`/learninghub/demo/center/families/${familySlug(family.id)}`}>{getDemoFamilyImage(family.id) && <DemoImage image={getDemoFamilyImage(family.id)} size="family-card" />}<span>Family</span><h2>{family.name}</h2><p>{family.guardian.name}</p><small>Linked learner: {findStudent(studentSlug(family.studentIds[0])).name}</small><b>Open Family →</b></a>)}</section> : <section class="empty-state" aria-labelledby="empty-families"><span>Scoped Families</span><h2 id="empty-families">No Family relationships in {selectedContext.name}</h2><p>No Family relationships are defined for learners in this context.</p></section>
  )}

  {role === "center" && section === "families" && selectedFamily && (
    <section class="detail-card"><div class="profile-heading">{getDemoFamilyImage(selectedFamily.id) && <DemoImage image={getDemoFamilyImage(selectedFamily.id)} size="profile-lg" loading="eager" />}<div><span class="eyebrow">Learning visibility</span><h2>{selectedFamily.name}</h2></div></div><dl><div><dt>Guardian relationship</dt><dd>{selectedFamily.guardian.name}</dd></div><div><dt>Linked learner</dt><dd>{familyStudent.name}</dd></div><div><dt>Visibility</dt><dd>Published learning updates and attendance</dd></div><div><dt>Current action</dt><dd>{selectedFamily.id === "demo-family-reyes" ? "1 makeup available" : "No action needed"}</dd></div></dl></section>
  )}

  {role === "center" && section === "attendance" && !item && (
    selectedContextAttendance.length ? <section class="record-list">{selectedContextAttendance.map((record) => <article class="record-row"><div><span>{findCourse(record.courseId).name}</span><h2>{findStudent(studentSlug(record.studentId)).name}</h2></div><span class={`state ${record.status}`}>{record.status}</span>{record.studentId === "demo-student-sofia-reyes" ? <a href="/learninghub/demo/center/attendance/sofia">Inspect makeup →</a> : <a href="/learninghub/demo/center/attendance/eli">Inspect attendance →</a>}</article>)}</section> : <section class="empty-state" aria-labelledby="empty-attendance"><span>Scoped attendance</span><h2 id="empty-attendance">No attendance records in {selectedContext.name}</h2><p>Attendance has not been recorded for this context in the view.</p></section>
  )}

  {role === "center" && section === "attendance" && item && (
    <section class="detail-card"><span class="eyebrow">Attendance record</span><h2>{item === "sofia" ? "Sofia Reyes" : "Eli Morgan"}</h2><div class="fact-grid">{data.attendance.filter((record) => record.studentId === (item === "sofia" ? "demo-student-sofia-reyes" : "demo-student-eli-morgan")).map((record) => <div><span>{record.status}</span><strong>{findCourse(record.courseId).name}</strong><small>{record.sessionId.includes("prior") ? "Prior session" : "Today"}</small></div>)}</div>{item === "sofia" && <aside class="notice"><strong>1 makeup available</strong><p>Created from the prior absence. No expiration policy is applied.</p></aside>}</section>
  )}

  {role === "center" && section === "reports" && !item && (
    selectedContextEvents.length ? <section class="record-list" aria-label={`${selectedContext.name} reports`}>{selectedContextEvents.map((event) => {
      const isSofia = event.id === "demo-event-sofia-sensor-test";
      return <a class="record-row" href={`/learninghub/demo/center/reports/${isSofia ? "sofia" : "eli"}`}><div><span>{isSofia ? "Needs clarification" : "No review required"}</span><h2>{findStudent(studentSlug(event.studentId)).name} · {findCourse(event.courseId).name}</h2><p>{isSofia ? event.report.reason : "Learning update processed without Center intervention."}</p></div><b>{isSofia ? "Open review →" : "Open report →"}</b></a>;
    })}</section> : <section class="empty-state" aria-labelledby="empty-reports"><span>Scoped reports</span><h2 id="empty-reports">No reports in {selectedContext.name}</h2><p>No learning reports are associated with this operating context in the view.</p></section>
  )}

  {role === "center" && section === "reports" && item && (
    <section class="detail-card"><span class="eyebrow">{item === "sofia" ? "Needs clarification" : "No review required"}</span><h2>{item === "sofia" ? "Sofia Reyes · Robotics Studio" : "Eli Morgan · Creative App Lab"}</h2><p>{item === "sofia" ? sofiaEvent.observation : eliEvent.observation}</p><dl><div><dt>Evidence</dt><dd>{item === "sofia" ? "Sensor trial record · unavailable" : eliEvent.evidence.label}</dd></div><div><dt>Review state</dt><dd>{item === "sofia" ? sofiaEvent.report.reason : "Policy checks satisfied; no Center action."}</dd></div></dl>{item === "sofia" && <a class="primary-link" href="/learninghub/demo/coach/reporting">View Coach clarification →</a>}</section>
  )}

  {role === "center" && section === "messages" && (
    selectedContextMessages.length ? <section class="detail-stack" aria-label={`${selectedContext.name} messages`}>{selectedContextMessages.map((message) => <details class="message-thread"><summary><span>{message.status.replaceAll("_", " ")}</span><strong>{message.subject}</strong><small>{message.preview}</small></summary><p>{message.response || "Priya still needs to attach the referenced evidence artifact."}</p></details>)}</section> : <section class="empty-state" aria-labelledby="empty-messages"><span>Scoped messages</span><h2 id="empty-messages">No messages in {selectedContext.name}</h2><p>No operational message threads are associated with this context in the view.</p></section>
  )}

  {role === "center" && section === "settings" && (
    <section class="detail-card"><h2>{selectedContext.name}</h2><p>{selectedContext.purpose}</p><dl><div><dt>Operating context</dt><dd>{selectedContext.name}</dd></div><div><dt>Learning period language</dt><dd>{data.settings.learningPeriodLabel}</dd></div><div><dt>Report handling</dt><dd>{data.settings.reviewMode}</dd></div><div><dt>Family visibility</dt><dd>{data.settings.familyPublishing}</dd></div></dl><p class="quiet-note">These shared policies apply to the selected operating context.</p></section>
  )}

  {role === "center" && section === "overview" && centerView?.explicitContext && (
    <section class="detail-stack"><article class="detail-card"><div class="profile-heading">{getDemoContextImage(selectedContext.id) && <DemoImage image={getDemoContextImage(selectedContext.id)} size="profile-lg" loading="eager" />}<div><span class="eyebrow">Scoped operating context</span><h2>{selectedContext.name}</h2><p>{selectedContext.purpose}</p></div></div><div class="fact-grid"><div><span>Learners</span><strong>{selectedContextStudentIds.size}</strong><small>{[...selectedContextStudentIds].map((id) => findStudent(studentSlug(id)).name).join(" · ") || "No active learners"}</small></div><div><span>Sessions</span><strong>{selectedContextSessions.length}</strong><small>{selectedContextSessions.map((entry) => findCourse(entry.courseId).name).join(" · ") || "No session scheduled in this snapshot"}</small></div></div></article>{contextKey === "harbor" && <article class="notice"><strong>Noah Bennett keeps one learner identity</strong><p>His Creative App Lab enrollment is scoped to Harbor Academy Program; switching context does not create another person.</p></article>}</section>
  )}

  {role === "coach" && section === "class" && (
    <section class="card-grid three">{roleModel.roster.map((learner) => <a class="entity-card" href={`/learninghub/demo/coach/learners/${studentSlug(learner.id)}`}><DemoImage image={getDemoStudentImage(learner.id)} size="avatar-md" /><span>{learner.status}</span><h2>{learner.name}</h2><p>{learner.current}</p><b>Open learner →</b></a>)}</section>
  )}

  {role === "coach" && section === "learners" && (
    <section class="detail-card"><div class="profile-heading"><DemoImage image={getDemoStudentImage(findStudent(item).id)} size="profile-lg" loading="eager" /><div><span class="eyebrow">Creative App Lab</span><h2>{findStudent(item).name}</h2></div></div>{item === "eli" ? <><p class="lead-fact">{eliEvent.challenge}</p><dl><div><dt>Completed</dt><dd>{eliEvent.completed}</dd></div><div><dt>Next</dt><dd>{eliEvent.next}</dd></div><div><dt>Observation</dt><dd>{eliEvent.observation}</dd></div></dl><a class="primary-link" href="/learninghub/demo/coach/evidence/eli">Inspect evidence →</a></> : <p>Continue the current Creative App Lab challenge. Progress remains attached to this learner and course.</p>}</section>
  )}

  {role === "coach" && section === "learning-plan" && (
    <section class="detail-stack"><article class="detail-card"><span class="eyebrow">Today’s focus</span><h2>{data.sessions[0].learningFocus}</h2><div class="sequence"><div><b>1</b><span>Map the core habit flow</span></div><div><b>2</b><span>Build the primary screen and navigation</span></div><div><b>3</b><span>Test one interaction and revise it</span></div></div></article><a class="primary-link" href="/learninghub/demo/coach/learners/eli">Open Eli in this plan →</a></section>
  )}

  {role === "coach" && section === "progress" && !item && (
    <section class="record-list">{data.courseProgress.filter((progress) => data.sessions[0].studentIds.includes(progress.studentId) && progress.courseId === data.sessions[0].courseId).map((progress) => <article class="record-row"><div class="record-identity"><DemoImage image={getDemoStudentImage(progress.studentId)} size="avatar-sm" /><div><span>{findCourse(progress.courseId).name}</span><h2>{findStudent(studentSlug(progress.studentId)).name}</h2><p>Current: {progress.current}</p></div></div><strong>{progress.completed} of {progress.total}</strong>{progress.studentId === "demo-student-lena-grant" ? <a href="/learninghub/demo/coach/progress/lena">Two-course view →</a> : <a href="/learninghub/demo/coach/learners/eli">Open learner →</a>}</article>)}</section>
  )}

  {role === "coach" && section === "progress" && item === "lena" && (
    <section class="detail-card"><div class="compact-identity"><DemoImage image={getDemoStudentImage("demo-student-lena-grant")} size="avatar-md" /><div><span class="eyebrow">One learner · separate progress</span><h2>Lena Grant</h2></div></div><div class="course-progress-grid">{data.courseProgress.filter((progress) => progress.studentId === "demo-student-lena-grant").map((progress) => <article class="course-progress-card"><div class="course-progress-heading"><strong>{findCourse(progress.courseId).name}</strong><span>{progress.completed} of {progress.total} steps</span></div><div class="course-progress-track" role="progressbar" aria-label={`${findCourse(progress.courseId).name}: ${progress.completed} of ${progress.total} steps complete`} aria-valuemin="0" aria-valuemax={progress.total} aria-valuenow={progress.completed}><span style={`width:${(progress.completed / progress.total) * 100}%`}></span></div><dl><div><dt>Current</dt><dd>{progress.current}</dd></div><div><dt>Next</dt><dd>{progress.next}</dd></div></dl></article>)}</div></section>
  )}

  {role === "coach" && section === "observations" && (
    <section class="card-grid two">{data.learningEvents.map((event) => <article class="detail-card"><div class="compact-identity"><DemoImage image={getDemoStudentImage(event.studentId)} size="avatar-sm" /><div><span class="eyebrow">{findCourse(event.courseId).name}</span><h2>{findStudent(studentSlug(event.studentId)).name}</h2></div></div><p>“{event.observation}”</p><small>Evidence: {event.evidence.label} · {event.evidence.status.replaceAll("_", " ")}</small>{event.studentId === "demo-student-eli-morgan" && <a class="primary-link" href="/learninghub/demo/coach/evidence/eli">Inspect evidence →</a>}</article>)}</section>
  )}

  {role === "coach" && section === "evidence" && (
    <section class="detail-stack"><article class="detail-card evidence-context"><span class="eyebrow">Connected evidence</span><h2>{eliEvent.evidence.label}</h2><dl><div><dt>Learner</dt><dd>Eli Morgan</dd></div><div><dt>Course</dt><dd>Creative App Lab</dd></div><div><dt>Learning focus</dt><dd>{eliEvent.challenge}</dd></div><div><dt>Status</dt><dd>Connected to learning record</dd></div></dl></article><div class="evidence-gallery" aria-label="Habit Tracker evidence media"><figure><div class="artifact-visual" role="img" aria-label="Screenshot of the Habit Tracker Today screen"><span>Habit</span><b>Today</b><i>✓</i></div><figcaption><strong>Prototype screen</strong><span>Screenshot</span></figcaption></figure><figure><DemoImage image={COGNIT_DEMO_IMAGES.evidence.prototypePhoto} size="evidence-photo" /><figcaption><strong>Prototype testing</strong><span>Photo</span></figcaption></figure><figure><div class="evidence-video" role="img" aria-label="Thumbnail for a short prototype test video"><span aria-hidden="true">▶</span><strong>Interaction test</strong></div><figcaption><strong>Interaction test</strong><span>Video</span></figcaption></figure></div></section>
  )}

  {role === "coach" && section === "reporting" && (
    <section class="card-grid two"><article class="detail-card positive-card"><span class="eyebrow">No review required</span><h2>Eli Morgan</h2><p>{eliEvent.observation}</p><small>Evidence available · update processed</small></article><article class="detail-card attention-card"><span class="eyebrow">Returned for clarification</span><h2>Sofia Reyes</h2><p>{sofiaEvent.report.reason}</p><small>Next: attach the sensor trial record, then resubmit.</small></article></section>
  )}

  {role === "student" && section === "my-work" && (
    <section class="student-project-overview"><figure class="narrative-figure"><DemoImage image={COGNIT_DEMO_IMAGES.narrative.robotics} size="narrative-card" loading="eager" /></figure><article class="detail-card"><span class="eyebrow">Current project</span><h2>{eliEvent.evidence.label}</h2><p>{eliEvent.challenge}</p><div class="sequence" aria-label="Project progress"><div class="complete"><span class="progress-marker" aria-hidden="true">✓</span><div><b>Done</b><span>{eliEvent.completed}</span></div></div><div class="current"><span class="progress-marker" aria-hidden="true">○</span><div><b>Now</b><span>{eliEvent.challenge}</span></div></div><div><span class="progress-marker" aria-hidden="true">–</span><div><b>Next</b><span>{eliEvent.next}</span></div></div></div><a class="primary-link" href="/learninghub/demo/student/artifact">Open my project →</a></article></section>
  )}

  {role === "student" && section === "artifact" && (
    <section class="artifact-detail"><div class="artifact-visual" aria-hidden="true"><span>Habit</span><b>Today</b><i>✓</i></div><div><span class="eyebrow">My latest work</span><h2>{eliEvent.evidence.label}</h2><p>You built the core navigation, tested an interaction, and improved one confusing step.</p><a class="primary-link" href="/learninghub/demo/student/progress">See what comes next →</a></div></section>
  )}

  {role === "student" && section === "progress" && (
