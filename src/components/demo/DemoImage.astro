---
const {
  image,
  size = "avatar-md",
  loading = "lazy",
  class: className = ""
} = Astro.props;
---

{image && (
  <img
    class:list={["demo-image", size, className]}
    src={image.src}
    alt={image.alt}
    width={image.width}
    height={image.height}
    loading={loading}
    decoding="async"
  />
)}

<style>
  .demo-image { display: block; flex: none; max-width: 100%; background: var(--cognit-surface-secondary); object-fit: cover; }
  .avatar-sm { width: 48px; height: 48px; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px var(--color-border); }
  .avatar-md { width: 72px; height: 72px; border: 3px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px var(--color-border); }
  .profile-lg { width: 132px; height: 132px; border: 1px solid var(--color-border); border-radius: 22px; object-fit: contain; }
  .family-card { width: 100%; height: 150px; border-radius: 12px; object-fit: contain; }
  .narrative-card { width: 100%; height: auto; border-radius: 14px; object-fit: contain; }
  .evidence-photo { width: 100%; height: 148px; border-radius: 10px; object-fit: cover; }

  @media (max-width: 460px) {
    .profile-lg { width: 104px; height: 104px; }
    .family-card { height: 132px; }
  }
</style>
