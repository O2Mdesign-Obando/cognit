    root.querySelectorAll("[data-alternative]").forEach(b=>b.addEventListener("click",()=>{const panel=root.querySelector("[data-alternative-panel]");if(!(panel instanceof HTMLElement))return;panel.hidden=false;const kind=b.getAttribute("data-alternative");panel.textContent=kind==="animated"?msg("Working silent animation: a full turn returns to Top; the remaining quarter-turn moves to Right.","Animación silenciosa funcional: una vuelta completa regresa Arriba; el cuarto restante se mueve a la Derecha."):kind==="illustrated"?msg("Frame 1: start at Top. Frame 2: one full turn returns to Top. Frame 3: one more quarter-turn ends at Right.","Cuadro 1: comienza Arriba. Cuadro 2: una vuelta completa regresa Arriba. Cuadro 3: otro cuarto de vuelta termina a la Derecha."):msg("Concise brief: 1¼ = 1 complete turn + ¼ turn. Complete turns preserve the start; the remaining clockwise quarter ends at Right.","Guía breve: 1¼ = 1 vuelta completa + ¼ de vuelta. Las vueltas completas conservan el inicio; el cuarto horario restante termina a la Derecha.");}));
    document.addEventListener("cognit:language-changed",()=>{setStatus("");const presenterResult=root.querySelector("[data-presenter-result]");if(presenterResult)presenterResult.textContent="";localize();render();renderEntryContext();});
    if (query.get("scenario") === "review") setStatus(msg("Prepared scenarios now load only from Presenter controls so existing visitor work cannot be replaced silently.","Los escenarios preparados ahora solo se cargan desde los controles del presentador para no reemplazar silenciosamente el trabajo existente."));
    const queryMoment=Number(query.get("moment"));show(queryMoment>=1&&queryMoment<=6?queryMoment:state.moment);
    renderEntryContext();
  }
</script>

