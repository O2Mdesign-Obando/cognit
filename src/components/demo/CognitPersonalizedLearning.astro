    const renderEntryContext=()=>{const node=root.querySelector("[data-entry-context]");if(!(node instanceof HTMLElement)||!entryRole)return;node.hidden=false;node.textContent=storedState?(locale()==="es"?"Se conservó tu trabajo existente en este navegador. Esta entrada no restableció ni reemplazó ningún estado.":"Your existing browser-local work was preserved. This entry did not reset or replace any state."):(locale()==="es"?"Contexto ficticio preparado para esta entrada. No existía trabajo previo en este navegador.":"Prepared fictional context for this entry. No prior browser-local work existed.");};
    function localize(){root.querySelectorAll("[data-copy]").forEach(n=>{const k=n.getAttribute("data-copy");n.textContent=locale()==="es"&&copy.es[k]?copy.es[k]:englishCopy.get(k)||n.textContent;});root.querySelectorAll("[data-copy-placeholder]").forEach(n=>{const k=n.getAttribute("data-copy-placeholder");if(n instanceof HTMLTextAreaElement)n.placeholder=locale()==="es"&&copy.es[k]?copy.es[k]:englishPlaceholders.get(k)||"";});const nav=root.querySelector("[data-copy-aria]");if(nav)nav.setAttribute("aria-label",locale()==="es"?copy.es.progress:"Six-moment personalized learning journey");const positions={Top:"Arriba",Right:"Derecha",Bottom:"Abajo",Left:"Izquierda"};root.querySelectorAll("[data-position]").forEach((n,index)=>{const value=n.getAttribute("data-position");n.textContent=`${index+1} · ${locale()==="es"?positions[value]:value}`;});}
    function show(moment){state.moment=Number(moment);save();root.querySelectorAll("[data-moment]").forEach(n=>n.toggleAttribute("hidden",n.getAttribute("data-moment")!==String(state.moment)));root.querySelectorAll("[data-step]").forEach(n=>{n.setAttribute("aria-current",n.getAttribute("data-step")===String(state.moment)?"step":"false")});const from=new URLSearchParams(location.search).get("from");const role=from||({1:"hq",2:"center",3:"coach",4:"student",5:"center",6:"family"})[state.moment];const a=root.querySelector("[data-return]");if(a instanceof HTMLAnchorElement)a.href=`/learninghub/demo/${role}`;render();root.querySelector("[data-moment]:not([hidden]) h2")?.scrollIntoView({block:"start"});}
    function attempt(){return state.attempts.robert.at(-1);}
    function render(){
      const at=attempt(), report=state.report;
      root.querySelectorAll("[data-position]").forEach(n=>n.setAttribute("aria-pressed",String(at?.current===n.getAttribute("data-position"))));
      const outcome=root.querySelector("[data-practice-outcome]");if(outcome instanceof HTMLElement)outcome.hidden=!at?.correct;
      const support=root.querySelector("[data-support-outcome]");if(support)support.textContent=at?.hintUsed?tr("supportedOutcome","Help used: yes—this remains supported practice."):"Help used: no help in this practice attempt.";
      const current=root.querySelector("[data-current-evidence]");if(current&&at?.submissions?.length)current.textContent=`${at.submissions.length} practice submission(s) preserved · latest ${at.correct?"correct":"incorrect"} · ${at.hintUsed?"supported":"no help"}. Not independent-understanding evidence.`;
      const cv=report.reviews.some(r=>r.role==="coach"&&r.version===report.version&&r.status==="reviewed"), ca=report.reviews.some(r=>r.role==="center"&&r.version===report.version&&r.status==="approved");
      const rv=root.querySelector("[data-report-version]");if(rv)rv.textContent=`MONTHLY REPORT · Exact version ${report.version} · ${report.status}`;
      const cn=root.querySelector("[data-coach-approval]");if(cn)cn.textContent=`Coach Marcus · ${cv?"reviewed this exact version":"review pending"}`;
      const cen=root.querySelector("[data-center-approval]");if(cen)cen.textContent=`Plainsboro Center · ${ca?"approved this exact version":"approval pending"}`;
      const next=root.querySelector('[data-action="report-next"]');if(next){next.textContent=!cv?"Coach Marcus · Review exact version":!ca?"Plainsboro Center · Approve exact version":"Share demo report with family";}
      const history=root.querySelector("[data-history]");if(history)history.innerHTML=report.history.map(h=>`<li>${h}</li>`).join("");
      const shared=report.status==="shared";const fu=root.querySelector("[data-family-unavailable]"),fr=root.querySelector("[data-family-report]");if(fu instanceof HTMLElement)fu.hidden=shared;if(fr instanceof HTMLElement)fr.hidden=!shared;
      const comments=state.comments.robert;const cc=root.querySelector("[data-coach-comment]");if(cc instanceof HTMLElement){cc.hidden=!comments.length;if(comments.length)cc.textContent=`New fictional Family response · Report ${comments.at(-1).reportVersion}: “${comments.at(-1).text}”`;}
      const dec=root.querySelector("[data-decision]");if(dec instanceof HTMLElement){dec.hidden=!state.decision;if(state.decision)dec.textContent=`Saved teaching decision: ${state.decision}. History retained (${state.decisionHistory.length}).`;}
      localize();
    }
    root.querySelectorAll("[data-step]").forEach(b=>b.addEventListener("click",()=>show(b.getAttribute("data-step"))));
    root.querySelectorAll("[data-position]").forEach(b=>b.addEventListener("click",()=>{let at=attempt();if(!at||at.correct){at={id:`robert-${Date.now()}`,original:null,current:null,revisions:[],hintUsed:false,submissions:[],correct:false};state.attempts.robert.push(at);}if(at.original===null)at.original=b.getAttribute("data-position");else if(at.current&&at.current!==b.getAttribute("data-position"))at.revisions.push(b.getAttribute("data-position"));at.current=b.getAttribute("data-position");save();render();}));
    root.addEventListener("click",(event)=>{const target=event.target instanceof Element?event.target.closest("button"):null;if(!target)return;const action=target.getAttribute("data-action");
      if(action==="make-available"){state.packageAvailable=true;save();setStatus("Package v1.0 is available to centers; no student assignment changed.");show(2);}
      if(action==="review-approach")show(3);
      if(["accept","adjust","dismiss"].includes(action)){state.decision=action==="accept"?"narrated example, then reduced prompting":action==="adjust"?"narrated example with one visual cue, then reduced prompting":"recommendation dismissed; no activity assigned";state.decisionHistory.push({action,value:state.decision,at:new Date().toISOString()});save();setStatus(`Teaching decision saved: ${state.decision}.`);if(action!=="dismiss")show(4);else render();}
      if(action==="play"||action==="replay"){const motor=root.querySelector("[data-motor]");motor?.classList.remove("animate");requestAnimationFrame(()=>motor?.classList.add("animate"));const cap=root.querySelector("[data-animation-caption]");if(cap)cap.textContent="One complete turn returns to Top. The extra half-turn ends at Bottom.";}
      if(action==="hint"){let at=attempt();if(!at){at={id:`robert-${Date.now()}`,original:null,current:null,revisions:[],hintUsed:true,submissions:[],correct:false};state.attempts.robert.push(at);}at.hintUsed=true;save();const f=root.querySelector("[data-feedback]");if(f instanceof HTMLElement){f.hidden=false;f.textContent="Hint: separate 1¼ into one complete turn and one remaining quarter-turn. Trace only the final quarter clockwise.";}render();}
      if(action==="run"){let at=attempt();const f=root.querySelector("[data-feedback]");if(!at?.current){if(f instanceof HTMLElement){f.hidden=false;f.textContent="Choose an end position before running the motor.";}return;}const explanation=root.querySelector("#pl-explanation");at.explanation=explanation instanceof HTMLTextAreaElement?explanation.value:"";at.correct=at.current==="Right";at.submissions.push({answer:at.current,correct:at.correct,hintUsed:at.hintUsed,explanation:at.explanation,at:new Date().toISOString()});save();if(f instanceof HTMLElement){f.hidden=false;f.classList.toggle("good",at.correct);f.textContent=at.correct?(at.hintUsed?"Correct. This is supported practice, not independent-understanding evidence.":"Correct. Practice completed without help; Coach review is still required."):"Not yet. One full turn returns to Top; the extra quarter-turn clockwise ends at Right. Your response is preserved—request a hint or revise and run again.";}render();}
      if(action==="monthly"){if(!state.report.history.length)state.report.history.push("Version 1 · draft created");save();show(5);}
      if(action==="report-next"){const r=state.report,cv=r.reviews.some(x=>x.role==="coach"&&x.version===r.version&&x.status==="reviewed"),ca=r.reviews.some(x=>x.role==="center"&&x.version===r.version&&x.status==="approved");if(!cv){r.reviews.push({role:"coach",version:r.version,status:"reviewed",at:new Date().toISOString()});r.history.push(`Version ${r.version} · reviewed by Coach Marcus`);}else if(!ca){r.reviews.push({role:"center",version:r.version,status:"approved",at:new Date().toISOString()});r.status="approved";r.history.push(`Version ${r.version} · exact-version approval by Plainsboro Center`);}else{r.status="shared";r.history.push(`Version ${r.version} · simulated browser-local share`);show(6);}save();render();}
      if(action==="edit-report"){const r=state.report;r.reviews=r.reviews.map(x=>x.version===r.version&&["reviewed","approved"].includes(x.status)?{...x,status:"invalidated",reason:"report content changed"}:x);r.history.push(`Version ${r.version} approvals invalidated · report content changed`);r.version+=1;r.status="draft";r.history.push(`Version ${r.version} · revised draft created; prior history retained`);save();render();setStatus("Affected approvals invalidated. Prior version and review history retained.");}
      if(action==="comment"){const input=root.querySelector("#pl-family-comment"),confirm=root.querySelector("[data-comment-confirm]");if(!(input instanceof HTMLTextAreaElement)||!input.value.trim()){if(confirm instanceof HTMLElement){confirm.hidden=false;confirm.textContent="Write a fictional comment before submitting.";}return;}state.comments.robert.push({text:input.value.trim(),reportVersion:state.report.version,at:new Date().toISOString(),simulated:true});save();if(confirm instanceof HTMLElement){confirm.hidden=false;confirm.textContent="✓ Saved in this browser and now visible in the Coach perspective.";}input.value="";render();}
      if(action==="coach-return")show(3);
      if(action==="load-robert"){state=defaults();state.packageAvailable=true;state.moment=5;state.decision="narrated example, then reduced prompting";state.decisionHistory=[{action:"modified",value:state.decision,at:new Date().toISOString()}];state.attempts.robert=[{id:"prepared-robert",original:"Left",current:"Right",revisions:["Right"],hintUsed:true,correct:true,submissions:[{answer:"Left",correct:false,hintUsed:false},{answer:"Right",correct:true,hintUsed:true}]}];save();show(5);}
      if(action==="load-lily"||action==="load-jake"){state.student=action.endsWith("lily")?"lily":"jake";save();const p=root.querySelector("[data-presenter-result]");if(p)p.textContent=`Optional ${state.student} case loaded separately. Robert’s records were not changed.`;}
      if(action==="reset"){localStorage.removeItem(STORAGE_KEY);state=defaults();const e=root.querySelector("#pl-explanation"),c=root.querySelector("#pl-family-comment");if(e instanceof HTMLTextAreaElement)e.value="";if(c instanceof HTMLTextAreaElement)c.value="";setStatus("Personalized-learning demo reset. All guided states are consistently empty.");show(1);}
    });
    root.querySelectorAll("[data-alternative]").forEach(b=>b.addEventListener("click",()=>{const panel=root.querySelector("[data-alternative-panel]");if(!(panel instanceof HTMLElement))return;panel.hidden=false;const kind=b.getAttribute("data-alternative");panel.textContent=kind==="animated"?"Working silent animation: a full turn returns to Top; the remaining quarter-turn moves to Right.":kind==="illustrated"?"Frame 1: start at Top. Frame 2: one full turn returns to Top. Frame 3: one more quarter-turn ends at Right.":"Concise brief: 1¼ = 1 complete turn + ¼ turn. Complete turns preserve the start; the remaining clockwise quarter ends at Right.";}));
    document.addEventListener("cognit:language-changed",()=>{localize();renderEntryContext();});
    if (query.get("scenario") === "review") {
      state=defaults();state.packageAvailable=true;state.decision="narrated example, then reduced prompting";state.decisionHistory=[{action:"accepted",value:state.decision,at:new Date().toISOString()}];state.attempts.robert=[{id:"presenter-review",original:"Left",current:"Right",revisions:["Right"],hintUsed:true,correct:true,submissions:[{answer:"Left",correct:false,hintUsed:false},{answer:"Right",correct:true,hintUsed:true}]}];state.report={version:2,status:"shared",history:["Version 1 · approvals invalidated; history retained","Version 2 · reviewed by Coach Marcus","Version 2 · exact-version approval by Plainsboro Center","Version 2 · simulated browser-local share"],reviews:[{role:"coach",version:2,status:"reviewed"},{role:"center",version:2,status:"approved"}]};state.comments.robert=[{text:"We noticed Robert counting complete turns while building at home.",reportVersion:2,simulated:true}];save();
    }
    const queryMoment=Number(query.get("moment"));show(queryMoment>=1&&queryMoment<=6?queryMoment:state.moment);
    renderEntryContext();
  }
</script>

<style>
  .pl-demo{display:grid;min-width:0;max-width:100%;gap:24px;color:#172b3e}.pl-demo :is(h1,h2,h3,h4,p,span,dd,button){overflow-wrap:anywhere}.pl-demo [hidden]{display:none!important}.pl-context{display:flex;min-width:0;align-items:flex-start;justify-content:space-between;gap:24px}.pl-context h1{margin:.25rem 0;font-size:clamp(2.2rem,5vw,4.5rem)}.pl-context p{margin:0;font-size:1.08rem}.pl-context a{min-height:44px;color:#0b4167;font-weight:900}.pl-kicker,.pl-heading>span,.pl-card>small{color:#52687a;font-size:.76rem;font-weight:950;letter-spacing:.045em;text-transform:uppercase}.pl-progress{display:grid;min-width:0;max-width:100%;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;padding:10px;border:1px solid #cfdae2;border-radius:18px;background:#fff}.pl-progress button{display:flex;min-width:0;min-height:52px;align-items:center;justify-content:center;gap:8px;padding:8px;border:0;border-radius:12px;background:#eef3f6;color:#16486c;font-weight:900}.pl-progress button b{display:grid;width:26px;height:26px;place-items:center;border-radius:50%;background:#d8e6f0}.pl-progress button[aria-current="step"]{background:#0b4167;color:#fff}.pl-live:empty{display:none}.pl-live{margin:0;padding:12px 16px;border-radius:10px;background:#e4f5ef;font-weight:850}.pl-entry-context{margin:0;padding:12px 16px;border-left:4px solid #177cab;border-radius:8px;background:#e6f2f7;color:#173f5a;font-weight:800}.pl-moment,.pl-grid,.pl-card,.pl-heading{min-width:0;max-width:100%}.pl-moment{display:grid;gap:20px}.pl-heading{max-width:880px}.pl-heading h2{margin:.4rem 0;font-size:clamp(2rem,4vw,3.4rem)}.pl-heading p{margin:0;font-size:1.05rem;line-height:1.6}.pl-grid{display:grid;gap:18px}.pl-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.pl-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.pl-card{padding:clamp(20px,3vw,30px);border:1px solid #cbd8e1;border-radius:18px;background:#fff;box-shadow:0 8px 25px #153b5710}.pl-card h3{margin:.45rem 0 1rem;font-size:clamp(1.35rem,2.3vw,1.8rem)}.pl-card p,.pl-card li{line-height:1.55}.pl-card li+li{margin-top:8px}.pl-info{margin-top:16px;padding:14px;border-radius:12px;background:#fff2d2}.pl-info.blue{background:#deebf4}.pl-format-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pl-format-grid div,.evidence{display:grid;gap:6px;padding:14px;border-radius:12px;background:#f2f6f8}.pl-format-grid span,.evidence span,.pl-muted{color:#566b7b;font-size:.9rem}.pl-primary,.pl-demo button{min-height:48px;padding:12px 18px;border:1px solid #0b4167;border-radius:999px;background:#fff;color:#0b4167;font:inherit;font-weight:900}.pl-primary{width:100%;border-color:#f6ac2c!important;background:#f6ac2c!important;color:#0b4167!important}.pl-actions{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px}.pl-actions.compact{grid-template-columns:repeat(3,1fr)}.pl-decision,.pl-comment-alert,.pl-version,.pl-approval{padding:15px 18px;border-radius:12px;background:#e4f5ef;font-weight:850}.pl-assessment{display:grid;gap:12px}.pl-assessment div{padding-top:10px;border-top:1px solid #d7e0e6}.pl-assessment dt{font-weight:900}.pl-assessment dd{margin:4px 0 0}.motor{position:relative;width:min(250px,70%);aspect-ratio:1;margin:34px auto;border:4px solid #0b4167;border-radius:50%;background:#eef6fb}.motor .needle{position:absolute;left:calc(50% - 3px);bottom:50%;width:6px;height:42%;border-radius:5px;background:#0b4167;transform-origin:50% 100%}.motor i{position:absolute;left:calc(50% - 10px);top:calc(50% - 10px);width:20px;height:20px;border-radius:50%;background:#f6ac2c}.motor-label{position:absolute;font-weight:850}.motor-label.top{top:-28px;left:45%}.motor-label.right{right:-42px;top:46%}.motor-label.bottom{bottom:-30px;left:42%}.motor-label.left{left:-35px;top:46%}.motor.animate .needle{animation:turn540 3s ease-in-out forwards}.pl-caption{min-height:48px;padding:12px;border-radius:10px;background:#dce9f4}.pl-card fieldset{min-width:0;padding:0;border:0}.pl-card legend,.pl-card label{display:block;margin:12px 0 8px;font-weight:900}.pl-choices{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pl-choices button[aria-pressed="true"]{background:#0b4167;color:#fff}.pl-card textarea{width:100%;min-height:80px;padding:12px;border:1px solid #aebfcb;border-radius:10px;font:inherit}.pl-feedback{margin-top:14px;padding:14px;border-radius:10px;background:#fff2d2}.pl-feedback.good{background:#e4f5ef}.pl-alternative{margin-top:14px;padding:16px;border-radius:12px;background:#deebf4;line-height:1.6}.evidence b{font-size:1.05rem}.pl-presenter{min-width:0;padding:18px;border:1px dashed #8aa1b1;border-radius:14px;background:#f8fafb}.pl-presenter summary,.pl-card summary{cursor:pointer;font-weight:900}.danger{border-color:#9c3030!important;color:#9c3030!important}
  @keyframes turn540{from{transform:rotate(0)}to{transform:rotate(540deg)}}
  @media(prefers-reduced-motion:reduce){.motor.animate .needle{animation:none;transform:rotate(180deg)}}
  @media(max-width:760px){.pl-context{flex-direction:column}.pl-progress{grid-template-columns:repeat(2,minmax(0,1fr))}.pl-grid.two,.pl-grid.three{grid-template-columns:1fr}.pl-actions,.pl-actions.compact{grid-template-columns:1fr}.pl-format-grid{grid-template-columns:1fr}.pl-card{padding:20px}.pl-progress button{flex-direction:column;gap:4px;font-size:.8rem}.pl-choices button{min-width:0;padding-inline:7px}}
