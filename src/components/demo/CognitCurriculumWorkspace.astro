---
import { getCreativeAppLabPresentation } from "../../demo/cognit-curriculum-content.js";
const { audience = "student", personId } = Astro.props;
const presentation = getCreativeAppLabPresentation(audience);
if (!presentation) throw new Error(`Unsupported curriculum presentation audience: ${audience}`);
const groups = presentation.activities.flatMap(activity => activity.groups.map(group => ({...group,activityId:activity.id,activityTitleKey:activity.titleKey})));
---
<section class="curriculum-workspace" data-curriculum-workspace data-audience={audience} data-person-id={personId} aria-labelledby={`curriculum-${audience}-title`}>
 <header class="workspace-intro"><div><span class="eyebrow" data-i18n={`workspace.role.${audience}`}></span><h2 id={`curriculum-${audience}-title`} data-i18n="workspace.heading">Prototype the core flow</h2><p data-i18n="progress.disclosure">Interactive Demo — simulated curriculum, language settings and browser-local progress.</p></div><span class="presentation-boundary" data-i18n="workspace.boundary">Presentation only · progress unchanged</span></header>
 <div class="curriculum-layout"><aside class="module-browser"><label for={`module-search-${audience}`} data-i18n="workspace.searchLabel"></label><input id={`module-search-${audience}`} type="search" data-module-search data-i18n-placeholder="workspace.searchPlaceholder" autocomplete="off"/><p data-search-status role="status"></p><ol>{presentation.modules.map(module=><li data-module-item class:list={[module.id===presentation.presentedModuleId&&"selected"]}><span data-i18n="progress.module" data-i18n-params={JSON.stringify({number:module.sequence})}></span><strong data-module-title data-i18n={module.titleKey}></strong><small data-i18n={module.summaryKey}></small>{module.id===presentation.presentedModuleId&&<em data-i18n="workspace.presented"></em>}</li>)}</ol><p data-search-empty hidden data-i18n="workspace.searchEmpty"></p></aside>
 <div class="guided-presentation"><section data-activity-overview><span class="eyebrow" data-i18n="workspace.overviewEyebrow"></span><h3 tabindex="-1" data-i18n="workspace.overviewHeading"></h3><p data-i18n="workspace.overviewCopy"></p><div class="activity-grid">{presentation.activities.map(activity=><article><span data-i18n="workspace.guidedGroups" data-i18n-params={JSON.stringify({count:activity.groups.length})}></span><h4 data-i18n={activity.titleKey}></h4><p data-i18n={activity.summaryKey}></p><button type="button" data-open-activity={activity.id} data-i18n="workspace.openActivity"></button></article>)}</div></section>
 {groups.map((group,index)=><section class="content-group" data-content-group data-group-index={index} data-activity-id={group.activityId} hidden><span class="eyebrow"><span data-i18n={group.activityTitleKey}></span>{group.partKey&&<> · <span data-i18n={group.partKey}></span></>}</span><h3 tabindex="-1" data-i18n={group.titleKey}></h3><div class="content-blocks">{group.blocks.map((block,blockIndex)=> block.type==="explanation"?<p data-i18n={block.key}></p>:block.type==="instruction"?<div class="instruction"><strong data-i18n="workspace.tryThis"></strong><p data-i18n={block.key}></p></div>:block.type==="list"?<ul>{block.keys.map(key=><li data-i18n={key}></li>)}</ul>:block.type==="callout"?<aside class:list={["callout",block.tone]}><strong data-i18n={block.titleKey}></strong><p data-i18n={block.key}></p></aside>:block.type==="code"?<div class="code-block"><span>{block.language}</span><pre tabindex="0"><code>{block.code}</code></pre></div>:block.type==="question"?<label class="reflection-question"><strong data-i18n="workspace.reflect"></strong><span data-i18n={block.key}></span><textarea rows="4" data-entered-work={`${group.id}:${blockIndex}`} data-i18n-placeholder="workspace.draftPlaceholder"></textarea></label>:block.type==="image"?<figure><button type="button" class="image-button" data-open-curriculum-image data-i18n-aria-label="workspace.enlargeLabel"><img src={block.src} data-i18n-alt="workspace.imageAlt" loading="lazy"/></button><figcaption><span data-i18n="workspace.imageCaption"></span> · <span data-i18n="workspace.selectEnlarge"></span></figcaption></figure>:null)}</div></section>)}
 <nav class="presentation-controls" data-presentation-controls hidden><button type="button" data-presentation-back></button><span data-presentation-position aria-live="polite"></span><button type="button" data-presentation-next></button></nav></div></div>
 <dialog class="image-dialog" data-curriculum-image-dialog><div class="dialog-heading"><h3 data-i18n="workspace.imageDialogTitle"></h3><button type="button" data-close-curriculum-image data-i18n-aria-label="workspace.closeImage">×</button></div><img src="/assets/cognit-demo/curriculum/habit-tracker-flow.svg" data-i18n-alt="workspace.imageAlt"/><p data-i18n="workspace.imageProvenance"></p></dialog>
</section>
<script>
 import { readBrowserLocalJson, translateKey, writeBrowserLocalJson } from "../../demo/cognit-localization.js";
 const localStorage = {
  getItem: (key) => JSON.stringify(readBrowserLocalJson(key, {})),
  setItem: (key, value) => writeBrowserLocalJson(key, JSON.parse(value))
 };
 document.querySelectorAll("[data-curriculum-workspace]").forEach(workspace=>{if(!(workspace instanceof HTMLElement)||workspace.dataset.ready==="true")return;workspace.dataset.ready="true";const groups=[...workspace.querySelectorAll("[data-content-group]")],overview=workspace.querySelector("[data-activity-overview]"),controls=workspace.querySelector("[data-presentation-controls]"),back=workspace.querySelector("[data-presentation-back]"),next=workspace.querySelector("[data-presentation-next]"),position=workspace.querySelector("[data-presentation-position]");const storageKey=`cognit:demo-curriculum-workspace:v1:${workspace.dataset.personId}`;let state={currentIndex:-1,drafts:{}};try{state={...state,...JSON.parse(localStorage.getItem(storageKey)||"{}")}}catch{}let currentIndex=Number.isInteger(state.currentIndex)?state.currentIndex:-1;const locale=()=>document.documentElement.dataset.contentLocale||"en-US",tr=(key,params={})=>translateKey(locale(),key,params).value,save=()=>{try{localStorage.setItem(storageKey,JSON.stringify({...state,currentIndex}))}catch{}};const focusPanel=panel=>{const heading=panel?.querySelector("h3");if(heading instanceof HTMLElement){heading.focus({preventScroll:true});heading.scrollIntoView({behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth",block:"start"})}};const render=(focus=false)=>{if(overview instanceof HTMLElement)overview.hidden=currentIndex>=0;groups.forEach((g,i)=>{if(g instanceof HTMLElement)g.hidden=i!==currentIndex});if(controls instanceof HTMLElement)controls.hidden=currentIndex<0;if(currentIndex>=0){if(position)position.textContent=tr("workspace.groupPosition",{current:currentIndex+1,total:groups.length});if(back)back.textContent=tr(currentIndex===0?"workspace.backOverview":"workspace.back");if(next)next.textContent=tr(currentIndex===groups.length-1?"workspace.returnOverview":"workspace.next");if(focus)focusPanel(groups[currentIndex])}save()};workspace.querySelectorAll("[data-open-activity]").forEach(button=>button.addEventListener("click",()=>{currentIndex=groups.findIndex(g=>g.getAttribute("data-activity-id")===button.getAttribute("data-open-activity"));render(true)}));back?.addEventListener("click",()=>{if(currentIndex<=0){currentIndex=-1;render();focusPanel(overview)}else{currentIndex--;render(true)}});next?.addEventListener("click",()=>{if(currentIndex>=groups.length-1){currentIndex=-1;render();focusPanel(overview)}else{currentIndex++;render(true)}});const search=workspace.querySelector("[data-module-search]"),items=[...workspace.querySelectorAll("[data-module-item]")],status=workspace.querySelector("[data-search-status]"),empty=workspace.querySelector("[data-search-empty]");const renderSearch=()=>{const query=search instanceof HTMLInputElement?search.value.trim().toLocaleLowerCase(locale()):"";let visible=0;items.forEach(item=>{const matches=!query||item.querySelector("[data-module-title]")?.textContent?.toLocaleLowerCase(locale()).includes(query);if(item instanceof HTMLElement)item.hidden=!matches;if(matches)visible++});if(status)status.textContent=tr("workspace.modulesShown",{count:visible,noun:tr(visible===1?"workspace.moduleSingular":"workspace.modulePlural")});if(empty instanceof HTMLElement)empty.hidden=visible!==0};search?.addEventListener("input",renderSearch);workspace.querySelectorAll("[data-entered-work]").forEach(field=>{if(field instanceof HTMLTextAreaElement){field.value=state.drafts[field.dataset.enteredWork]||"";field.addEventListener("input",()=>{state.drafts[field.dataset.enteredWork]=field.value;save()})}});const dialog=workspace.querySelector("[data-curriculum-image-dialog]");let trigger;workspace.querySelectorAll("[data-open-curriculum-image]").forEach(button=>button.addEventListener("click",()=>{trigger=button;if(dialog instanceof HTMLDialogElement)dialog.showModal()}));workspace.querySelector("[data-close-curriculum-image]")?.addEventListener("click",()=>{if(dialog instanceof HTMLDialogElement)dialog.close()});dialog?.addEventListener("close",()=>{if(trigger instanceof HTMLElement)trigger.focus()});document.addEventListener("cognit:language-changed",()=>{render();renderSearch()});render();renderSearch()});
</script>
<style>
 .curriculum-workspace{margin-top:28px;padding:clamp(20px,4vw,38px);border:1px solid var(--color-border);border-radius:18px;background:#fff;box-shadow:var(--shadow-soft);color:var(--color-ink);font-size:16px}.workspace-intro{display:flex;align-items:start;justify-content:space-between;gap:20px;margin-bottom:24px}.workspace-intro h2{margin:6px 0 8px;font-size:clamp(1.8rem,4vw,2.8rem)}.eyebrow{color:#60819a;font-weight:950;text-transform:uppercase}.presentation-boundary{padding:8px 11px;border-radius:999px;background:#edf7f3;color:#08746f;font-weight:900}.curriculum-layout{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.7fr);gap:24px}.module-browser{padding:20px;border-radius:14px;background:var(--cognit-surface-secondary)}.module-browser label{display:block;margin-bottom:8px;font-weight:900}.module-browser input,.reflection-question textarea{width:100%;box-sizing:border-box;min-height:44px;padding:10px 12px;border:1px solid var(--color-border);border-radius:9px;background:#fff;color:inherit;font-size:16px}.module-browser ol,.activity-grid,.content-blocks{display:grid;gap:12px;padding:0;list-style:none}.module-browser li,.activity-grid article{display:grid;gap:7px;padding:14px;border:1px solid var(--color-border);border-radius:11px;background:#fff}.module-browser li.selected{border:2px solid #08746f}.module-browser small,.module-browser em,.module-browser p{font-size:16px}.activity-grid button,.presentation-controls button{min-height:44px;padding:9px 14px;border:1px solid var(--color-ink);border-radius:9px;background:#fff;color:inherit;font-size:16px;font-weight:900}.instruction,.callout{padding:17px;border-radius:11px;background:#eef6fa}.callout.tip{border-left:5px solid #20aaa5}.callout.boundary{border-left:5px solid #f4b53f;background:#fff7e8}.code-block{overflow:auto;border-radius:12px;background:#0d3857;color:#d5fff5}.code-block span,.code-block pre{display:block;padding:12px 16px;margin:0}.reflection-question{display:grid;gap:8px}.image-button{display:block;width:100%;padding:0;border:1px solid var(--color-border);border-radius:12px;overflow:hidden}.image-button img,.image-dialog img{display:block;width:100%}.presentation-controls{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:24px}.image-dialog{width:min(920px,calc(100vw - 32px));padding:22px;border:0;border-radius:16px}.dialog-heading{display:flex;justify-content:space-between}.dialog-heading button{width:44px;height:44px;font-size:22px}[hidden]{display:none!important}@media(max-width:820px){.workspace-intro{display:grid}.curriculum-layout{grid-template-columns:1fr}}@media(max-width:560px){.curriculum-workspace{padding:18px}}
</style>
