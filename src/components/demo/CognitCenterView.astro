hedule-form="edit" data-session-id={selectedScheduleSession.id} data-course-capacity={courseById(selectedScheduleSession.courseId)?.capacity}><input type="hidden" name="courseId" value={selectedScheduleSession.courseId} /><label>Date<input name="date" type="date" value={selectedScheduleSession.date} required /></label><label>Recurrence<select name="recurrence"><option selected>{selectedScheduleSession.recurrence}</option><option>One-time session</option><option>Monday and Thursday</option><option>Tuesday and Friday</option><option>Saturday</option></select></label><label>Start time<input name="startTime" type="time" value={selectedScheduleSession.startTime} required /></label><label>End time<input name="endTime" type="time" value={selectedScheduleSession.endTime} required /></label><label>Room<select name="room">{contextRooms.map((room)=><option value={room} selected={room===selectedScheduleSession.room}>{room}</option>)}</select></label><label>Coach<select name="coachId"><option value="" selected={!selectedScheduleSession.coachId}>Unassigned</option>{contextCoaches.map((coach)=><option value={coach.id} selected={coach.id===selectedScheduleSession.coachId} disabled={coach.status!=="active"}>{coach.name} · {coach.status.replaceAll("_"," ")}</option>)}</select></label><label>Session capacity<input name="capacity" type="number" min="1" max={courseById(selectedScheduleSession.courseId)?.capacity} value={selectedScheduleSession.capacity} required /></label><label>Operating status<select name="status"><option value="draft" selected={selectedScheduleSession.status==="draft"}>Draft</option><option value="scheduled" selected={selectedScheduleSession.status==="scheduled"}>Scheduled</option><option value="paused" selected={selectedScheduleSession.status==="paused"}>Paused</option></select></label><label class="span-all">Local exception<input name="exception" value={selectedScheduleSession.exception || ""} /></label><label class="span-all schedule-ack"><input type="checkbox" name="acknowledgeSoft" /> Acknowledge soft warnings before activation.</label><div class="schedule-form-actions span-all"><button type="button" class="action action-secondary" data-schedule-save-draft>Save draft</button><button type="submit">Evaluate and save</button></div><section class="conflict-panel span-all" aria-live="polite" data-schedule-conflicts><strong>Conflict evaluation</strong><p>{selectedScheduleSession.conflicts.length ? selectedScheduleSession.conflicts.map((conflict)=>conflict.label).join(" · ") : "No unresolved conflicts."}</p></section><p class="span-all" role="status" data-schedule-form-status></p></form></details>{selectedScheduleSession.coachId ? null : <a class="button-link" href={href("scheduling",`staffing/${selectedScheduleSession.id.replace("demo-session-","")}`)}>Resolve Coach assignment</a>}</>}
