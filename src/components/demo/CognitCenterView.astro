---
import { SYNTHETIC_COGNIT_DEMO as d } from "../../demo/cognit-demo-data.js";
import { parseCenterDemoView } from "../../demo/cognit-demo-routes.js";
import { getDemoStudentImage, getDemoCoachImage } from "../../demo/cognit-demo-images.js";

const { view = "overview" } = Astro.props;
const parsed = parseCenterDemoView(view);
const aliases = { schedule: "scheduling", messages: "communication", settings: "configuration" };
const section = parsed.section === "configuration" && parsed.item === "modules" ? "module-control" : (aliases[parsed.section] || parsed.section);
const item = parsed.item;
const contextKey = parsed.context;
const context = contextKey === "harbor" ? d.contexts[1] : d.contexts[0];
const contextId = context.id;
const base = parsed.explicitContext ? `/learninghub/demo/center/context/${contextKey}` : "/learninghub/demo/center";
const href = (target, child = "") => parsed.explicitContext ? `${base}/${target}${child ? `/${child}` : ""}` : `/learninghub/demo/center/${target}${child ? `/${child}` : ""}`;
const homeHref = parsed.explicitContext ? base : "/learninghub/demo/center";
const switchHref = (key) => `/learninghub/demo/center/context/${key}${section === "overview" ? "" : `/${section}`}`;
const activeSection = section === "attendance" ? "classes" : section;
const nav = [
  ["overview", "Home", homeHref], ["classes", "Today’s Classes", href("classes")], ["communication", "Communication", href("communication")],
  ["coaches", "Coaches", href("coaches")], ["students", "Students", href("students")], ["families", "Families", href("families")], ["scheduling", "Scheduling", href("scheduling")],
  ["courses", "Courses", href("courses")], ["billing", "Tuition & Billing", href("billing")], ["reports", "Reports", href("reports")], ["whats-new", "What’s New", href("whats-new")]
];
const contextSessions = d.sessions.filter((s) => s.contextId === contextId);
const contextEnrollmentIds = new Set(d.enrollments.filter((e) => e.contextId === contextId && e.status === "active").map((e) => e.studentId));
const contextStudents = d.people.students.filter((s) => contextEnrollmentIds.has(s.id));
const contextFamilies = d.people.families.filter((family) => family.studentIds.some((studentId) => contextEnrollmentIds.has(studentId)));
const studentById = (id) => d.people.students.find((s) => s.id === id);
const coachById = (id) => d.people.coaches.find((c) => c.id === id);
const courseById = (id) => d.courses.find((c) => c.id === id);
const progressFor = (id) => d.courseProgress.filter((p) => p.studentId === id);
const selectedStudent = d.people.students.find((s) => s.id.endsWith(`-${item}`)) || d.people.students.find((s) => s.id.includes(item)) || d.people.students[0];
const selectedCoach = d.people.coaches.find((c) => c.id.endsWith(`-${item}`)) || d.people.coaches.find((c) => c.id.includes(item)) || d.people.coaches[0];
const selectedFamily = d.people.families.find((family) => family.id.endsWith(`-${item}`)) || d.people.families.find((family) => family.id.includes(item));
const selectedCourse = d.courses.find((c) => c.id.endsWith(item)) || d.courses[0];
const studentImage = (id) => getDemoStudentImage(id) || { src: "/assets/cognit-demo/student-generic.webp", alt: "", width: 640, height: 640 };
const coachImage = (id) => getDemoCoachImage(id) || { src: "/assets/cognit-demo/coach-placeholder.webp", alt: "", width: 640, height: 640 };
const title = contextKey === "harbor" ? "Harbor Academy Program" : "Northfield Studio";
---

<div class="center-shell" data-center-root data-context={contextKey} data-view={section} data-item={item}>
  <header class="center-topline">
    <div><strong>{title}</strong><span>Center Operations · Synthetic demo</span></div>
    <div class="top-actions">
      <div class="context-control"><span>Operating context</span><a href={switchHref("northfield")} aria-current={contextKey === "northfield" ? "page" : undefined}>Northfield</a><a href={switchHref("harbor")} aria-current={contextKey === "harbor" ? "page" : undefined}>Harbor</a></div>
      <details class="profile-menu"><summary><span>MC</span>Maya Chen</summary><nav><a href={href("support")}>Support</a><a href={href("configuration")}>Settings</a><button type="button" data-center-local-action="Signed out of the local demo. No real session changed.">Log out</button></nav></details>
    </div>
  </header>
  <nav class="center-nav" aria-label="Center demo sections">{nav.map(([id,label,url]) => <a href={url} aria-current={activeSection === id ? "page" : undefined}>{label}</a>)}</nav>

  {section === "overview" && <>
    <header class="center-hero"><p class="eyebrow">Center operations</p><h1>Run today’s learning operation.</h1><p>Review by exception across schedules, learners, reporting, communication, and operational continuity.</p></header>
    {contextKey === "harbor" ? <section class="empty-state"><span>Harbor Academy Program</span><h2>No Center actions need attention</h2><p>No reports, attendance exceptions, billing items, or Family records are available in this context. Noah’s school-program enrollment remains separate from Northfield.</p><a href={href("students")}>View Harbor learner roster →</a></section> : <>
      <section class="attention-list" aria-label="Center attention queue">
        <article><span>Review</span><div><h2>Sofia’s update needs clarification</h2><p>The referenced sensor trial record is unavailable.</p></div><a href={href("reports","sofia")}>Review report →</a></article>
        <article><span>Publish</span><div><h2>Eli’s Learning Journey is ready</h2><p>Approved observation, evidence, and course progression are ready for Center publication.</p></div><a href={href("reports","builder")}>Open builder →</a></article>
        <article><span>Reply</span><div><h2>Coach reply requested</h2><p>Priya asked what evidence is needed for Sofia’s update.</p></div><a href={href("communication","coach")}>Open thread →</a></article>
        <article data-unassigned-card><span>Coverage</span><div><h2>Digital Storytelling needs a Coach</h2><p>Saturday · 10:00–11:30 AM · two learners.</p></div><button type="button" data-assign-coach>Assign Jordan</button></article>
        <article><span>Attendance</span><div><h2>One attendance record is unresolved</h2><p>Confirm the arrival state without inferring attendance.</p></div><a href={href("classes","creative/attendance")}>Resolve →</a></article>
        <article><span>Billing</span><div><h2>Bounded demo billing view</h2><p>Illustrative account states only; no processor connection.</p></div><a href={href("billing")}>Review →</a></article>
      </section>
      <section class="clear-banner"><span>✓</span><strong>All clear:</strong> authorization boundaries · multi-context isolation · no real payment or delivery actions</section>
    </>}
  </>}

  {section === "classes" && item !== "creative/attendance" && <>
    <header class="page-heading"><p class="eyebrow">Today · {title}</p><h1>Today’s Classes</h1><p>Scheduled, active, completed, and coverage-exception states remain explicit.</p></header>
    {contextSessions.length ? <section class="session-list">
      {contextSessions.map((session, index) => { const course = courseById(session.courseId); const coach = coachById(session.coachId); return <article>
        <div><span>{session.label}</span><h2>{course.name}</h2><p>{session.learningFocus}</p><small>{session.studentIds.length} learners · {coach?.name || "Coach unassigned"}</small></div>
        <div class="session-actions"><b class={`status ${session.status}`}>{session.status.replace("_"," ")}</b><a href={index === 0 ? href("classes","creative/attendance") : href("classes","robotics")}>{index === 0 ? "Open attendance" : "Open class"} →</a></div>
      </article>})}
      <article class="needs-coverage" data-unassigned-session><div><span>Saturday · 10:00–11:30 AM</span><h2>Digital Storytelling Lab</h2><p>Coverage has not been confirmed.</p><small>Mina Park · Ava Thompson</small></div><div class="session-actions"><b class="status attention">Unassigned</b><button type="button" data-assign-coach>Assign Jordan</button></div></article>
    </section> : <section class="empty-state"><h2>No classes scheduled in this context</h2><p>Harbor has no sessions on today’s Northfield operating date.</p></section>}
  </>}

  {(section === "attendance" || (section === "classes" && item === "creative/attendance")) && <>
    <header class="page-heading"><p class="eyebrow">Attendance detail</p><h1>Creative App Lab</h1><p>Reported, inferred, and confirmed states are never collapsed into one another.</p></header>
    <section class="attendance-summary"><article><span>Expected</span><strong>4</strong></article><article><span>Present</span><strong data-count-present>1</strong></article><article><span>Late</span><strong data-count-late>1</strong></article><article><span>Reported absent</span><strong>1</strong></article><article><span>Needs review</span><strong data-count-review>1</strong></article></section>
    <section class="attendance-list">
      <article data-attendance-row data-attendance="unresolved"><img {...studentImage("demo-student-lena-grant")} /><div><h2>Lena Grant</h2><p>Expected · no check-in or Family notice recorded</p></div><fieldset><legend>Confirm state</legend><button type="button" data-attendance-action="present">Present</button><button type="button" data-attendance-action="late">Late</button><button type="button" data-attendance-action="absent">Absent</button></fieldset><b data-attendance-label>Needs review</b></article>
      <article><img {...studentImage("demo-student-eli-morgan")} /><div><h2>Eli Morgan</h2><p>Check-in confirmed at 3:58 PM</p></div><b class="confirmed">Present</b></article>
      <article><img {...studentImage("demo-student-sofia-reyes")} /><div><h2>Sofia Reyes</h2><p>Arrival confirmed at 6:02 PM</p></div><b class="late">Late</b></article>
      <article><img {...studentImage("demo-student-mina-park")} /><div><h2>Mina Park</h2><p>Family reported absence before class; confirmation remains distinct.</p></div><b class="reported">Reported absent</b></article>
    </section>
  </>}

  {section === "students" && !item && <>
    <header class="page-heading"><p class="eyebrow">Learner stewardship</p><h1>Students</h1><p>Search and filter within the selected operating context.</p></header>
    <section class="filters"><label>Search<input type="search" placeholder="Search learner" data-student-search /></label><label>Course<select data-student-course><option value="all">All courses</option>{d.courses.map(c => <option value={c.id}>{c.name}</option>)}</select></label><label>Status<select><option>Active</option><option>Historical</option></select></label></section>
    <section class="people-grid" data-student-grid>{contextStudents.map((student) => { const enrollments = d.enrollments.filter(e => e.studentId === student.id && e.contextId === contextId && e.status === "active"); return <a href={href("students",student.id.split("-").pop())} data-student-card data-name={student.name.toLowerCase()} data-courses={enrollments.map(e=>e.courseId).join(" ")}><img {...studentImage(student.id)} /><div><h2>{student.name}</h2><p>{enrollments.map(e=>courseById(e.courseId)?.name).join(" · ") || "No active course"}</p><small>{progressFor(student.id).length ? "Progress is course-scoped" : "No progress record in this context"}</small></div></a>})}</section>
  </>}

  {section === "students" && item && <>
    <a class="back-inline" href={href("students")}>← Student roster</a><header class="profile-heading"><img {...studentImage(selectedStudent.id)} /><div><p class="eyebrow">Student profile</p><h1>{selectedStudent.name}</h1><p>Safe demo fields only · one persistent identity across context-specific enrollments.</p></div></header>
    <div class="split"><section class="panel"><h2>Course enrollment and progression</h2>{progressFor(selectedStudent.id).map(p => <article class="progress-row"><div><strong>{courseById(p.courseId)?.name}</strong><p>Current: {p.current}</p><small>Next: {p.next}</small></div><b>{p.completed} of {p.total}</b></article>)}{!progressFor(selectedStudent.id).length && <p>No course progression exists in this context.</p>}</section><section class="panel"><h2>Context and attendance</h2><p><strong>Current context:</strong> {title}</p><p><strong>Attendance:</strong> {d.attendance.find(a=>a.studentId===selectedStudent.id)?.status || "No record"}</p><p><strong>Family access:</strong> {d.people.families.some(f=>f.studentIds.includes(selectedStudent.id)) ? "Authoritative demo relationship exists" : "No Family relationship in fixture"}</p></section></div>
  </>}

  {section === "families" && !item && <><header class="page-heading"><p class="eyebrow">Authoritative relationships</p><h1>Families</h1><p>Family visibility follows defined learner relationships within the selected context.</p></header>{contextFamilies.length ? <section class="people-grid">{contextFamilies.map((family) => { const learner = studentById(family.studentIds[0]); return <a href={href("families",family.id.split("-").pop())}><img {...studentImage(learner?.id)} /><div><h2>{family.name}</h2><p>{family.guardian.name}</p><small>Linked learner: {learner?.name}</small></div></a>})}</section> : <section class="empty-state"><h2>No Family relationships in this context</h2><p>No guardian relationship is fabricated to populate this view.</p></section>}</>}
  {section === "families" && item && selectedFamily && (() => { const learner = studentById(selectedFamily.studentIds[0]); return <><a class="back-inline" href={href("families")}>← Families</a><header class="profile-heading"><img {...studentImage(learner?.id)} /><div><p class="eyebrow">Family relationship</p><h1>{selectedFamily.name}</h1><p>Visibility is limited to the linked learner and published records.</p></div></header><div class="split"><section class="panel"><h2>Relationship</h2><div class="list-row"><span>Guardian</span><strong>{selectedFamily.guardian.name}</strong></div><div class="list-row"><span>Linked learner</span><strong>{learner?.name}</strong></div></section><section class="panel"><h2>Center-visible state</h2><p>Published learning updates and confirmed attendance can be visible to this Family.</p><p>No private contact details are exposed in the Center demo.</p></section></div></>})()}

  {section === "coaches" && !item && <><header class="page-heading"><p class="eyebrow">Staffing</p><h1>Coaches</h1><p>Course assignments and context scope stay visible.</p></header><section class="people-grid">{d.people.coaches.filter(c=>c.contextIds.includes(contextId)).map(coach => <a href={href("coaches",coach.id.split("-").slice(-2)[0])}><img {...coachImage(coach.id)} /><div><h2>{coach.name}</h2><p>{coach.focus}</p><small>{d.courses.filter(c=>c.coachId===coach.id).map(c=>c.name).join(" · ")}</small></div></a>)}</section></>}
  {section === "coaches" && item && <><a class="back-inline" href={href("coaches")}>← Coach roster</a><header class="profile-heading"><img {...coachImage(selectedCoach.id)} /><div><p class="eyebrow">Coach profile</p><h1>{selectedCoach.name}</h1><p>{selectedCoach.focus}</p></div></header><div class="split"><section class="panel"><h2>Assigned classes</h2>{d.sessions.filter(s=>s.coachId===selectedCoach.id && s.contextId===contextId).map(s=><div class="list-row"><span>{courseById(s.courseId)?.name}</span><strong>{s.label}</strong></div>)}</section><section class="panel"><h2>Context access</h2>{selectedCoach.contextIds.map(id=><div class="list-row"><span>{d.contexts.find(c=>c.id===id)?.name}</span><strong>Assigned</strong></div>)}<p class="boundary">Assignment grants context-specific work. It does not grant network or unrelated learner access.</p></section></div></>}

  {section === "communication" && <>
    <header class="page-heading"><p class="eyebrow">Communication</p><h1>{item === "compose" ? "Compose a demo message" : "Messages and announcements"}</h1><p>Browser-local demonstration only; nothing is delivered.</p></header>
    {item === "compose" ? <form class="panel form" data-local-form><label>Audience<select><option>Coach · Priya Nair</option><option>Family · Reyes Family</option><option>Center announcement</option></select></label><label>Subject<input required value="Follow-up on Sofia’s learning update" /></label><label>Message<textarea required rows="7">Please attach the referenced sensor trial record so the Center can complete review.</textarea></label><div class="form-actions"><button type="button" data-save-draft>Save local draft</button><button type="submit">Record demo send</button></div><p role="status" data-form-status></p></form> : <div class="message-layout"><aside class="panel"><a class={item==="coach"?"selected":""} href={href("communication","coach")}><strong>Priya Nair</strong><span>Evidence needed for Sofia</span></a><a class={item==="family"?"selected":""} href={href("communication","family")}><strong>Reyes Family</strong><span>Robotics Studio makeup</span></a><a href={href("communication")}><strong>Center announcement</strong><span>Weekend schedule reminder</span></a></aside><section class="panel thread"><div><span>{item === "family" ? "Family" : "Coach"}</span><h2>{item === "family" ? "Robotics Studio makeup" : "Evidence needed for Sofia’s update"}</h2></div><p>{item === "family" ? "Will Sofia’s missed session create a makeup option?" : "The referenced sensor trial record is not available for review. What should I attach?"}</p><p class="reply">{item === "family" ? "One makeup entitlement is available in this synthetic fixture." : "Attach the sensor trial record, then resubmit for Center review."}</p><a class="button-link" href={href("communication","compose")}>Compose reply →</a></section></div>}
  </>}

  {section === "scheduling" && <>
    <header class="page-heading"><p class="eyebrow">Scheduling</p><h1>{item === "cancel" ? "Cancel a session" : item === "cancel/confirmed" ? "Cancellation confirmed" : "Schedule"}</h1><p>Daily, weekly, monthly, and season views share one fixture and one context.</p></header>
    {item === "cancel/confirmed" ? <section class="receipt"><span>✓</span><h2>Robotics Studio cancellation recorded</h2><p>Families and Coaches are marked for local demo notification. No message was sent and no credit was issued by a live system.</p><a href={href("scheduling")}>Return to schedule →</a></section> : item === "cancel" ? <form class="panel form" action={href("scheduling","cancel/confirmed")}><div class="danger-note"><strong>Consequential demo action</strong><p>Review impact before confirming. This changes browser-local fixture state only.</p></div><label>Session<select><option>Robotics Studio · Today 5:45 PM</option></select></label><label>Reason<select><option>Center closure</option><option>Coach unavailable</option></select></label><label><input type="checkbox" required /> I reviewed affected learners and the synthetic makeup policy.</label><button type="submit">Confirm demo cancellation</button></form> : <><nav class="tabs"><a href={href("scheduling","daily")} aria-current={!item||item==="daily"?"page":undefined}>Daily</a><a href={href("scheduling","weekly")} aria-current={item==="weekly"?"page":undefined}>Weekly</a><a href={href("scheduling","monthly")} aria-current={item==="monthly"?"page":undefined}>Monthly</a><a href={href("scheduling","season")} aria-current={item==="season"?"page":undefined}>Season</a></nav><section class={`schedule-view ${item||"daily"}`}><h2>{item === "weekly" ? "Week of August 24" : item === "monthly" ? "August 2026" : item === "season" ? "Fall learning season" : "Today"}</h2>{contextSessions.map(s=><article><span>{s.label}</span><strong>{courseById(s.courseId)?.name}</strong><small>{coachById(s.coachId)?.name} · {s.studentIds.length} learners</small></article>)}{contextSessions.length===0&&<p>No scheduled sessions in this context.</p>}</section><a class="danger-link" href={href("scheduling","cancel")}>Cancel a session →</a></>}
  </>}

  {section === "courses" && !item && <><header class="page-heading"><p class="eyebrow">Academic</p><h1>Courses</h1><p>Curriculum visibility and local delivery remain separate responsibilities.</p></header><section class="course-grid">{d.courses.map(c=><a href={href("courses",c.id.replace("demo-course-",""))}><span>{d.enrollments.filter(e=>e.courseId===c.id&&e.contextId===contextId&&e.status==="active").length} active learners</span><h2>{c.name}</h2><p>{c.focus}</p><small>Coach: {coachById(c.coachId)?.name}</small></a>)}</section></>}
  {section === "courses" && item && <><a class="back-inline" href={href("courses")}>← Courses</a><header class="page-heading"><p class="eyebrow">Course detail</p><h1>{selectedCourse.name}</h1><p>{selectedCourse.focus}</p></header><div class="split"><section class="panel"><h2>Curriculum structure</h2><ol class="steps"><li>Discover the learning focus</li><li>Build and test one meaningful outcome</li><li>Reflect, document evidence, and identify what comes next</li></ol></section><section class="panel"><h2>Delivery</h2><p><strong>Coach:</strong> {coachById(selectedCourse.coachId)?.name}</p><p><strong>Active learners here:</strong> {d.enrollments.filter(e=>e.courseId===selectedCourse.id&&e.contextId===contextId&&e.status==="active").length}</p><p><strong>Completion:</strong> no completion state is invented by this view</p></section></div></>}

  {section === "reports" && !item && <><header class="page-heading"><p class="eyebrow">Center stewardship</p><h1>Reports and publication</h1><p>Coach submission → Center review → approval or clarification → publication possible.</p></header><section class="report-grid"><article><span>Ready for publication</span><h2>Eli Morgan</h2><p>Observation and evidence are available.</p><a href={href("reports","eli")}>Review →</a></article><article class="attention"><span>Needs clarification</span><h2>Sofia Reyes</h2><p>Evidence referenced in the report is missing.</p><a href={href("reports","sofia")}>Review →</a></article></section></>}
  {section === "reports" && (item === "eli" || item === "sofia") && (() => { const ev = d.learningEvents.find(e=>e.studentId.endsWith(item==="eli"?"eli-morgan":"sofia-reyes")); const student=studentById(ev.studentId); return <><a class="back-inline" href={href("reports")}>← Reports</a><header class="page-heading"><p class="eyebrow">Center review</p><h1>{student.name} · {courseById(ev.courseId)?.name}</h1><p>Review progression, observation, and evidence before a disposition.</p></header><section class="review-card"><div class="review-person"><img {...studentImage(student.id)} /><div><h2>{ev.challenge}</h2><p>{ev.observation}</p></div></div><div class="review-facts"><article><span>Progress</span><strong>{ev.progression.label}</strong></article><article><span>Evidence</span><strong>{ev.evidence.status.replace("_"," ")}</strong></article><article><span>Coach status</span><strong>{ev.report.label}</strong></article></div>{item==="sofia"&&<p class="warning">{ev.report.reason}</p>}<div class="form-actions"><button type="button" data-report-action="approve" data-report-student={item}>Approve</button><button type="button" class="secondary" data-report-action="clarify" data-report-student={item}>Request clarification</button></div><p role="status" data-report-status></p>{item==="eli"&&<a class="button-link" href={href("reports","builder")}>Continue to Journey builder →</a>}</section></>})()}
  {section === "reports" && item === "builder" && <><a class="back-inline" href={href("reports")}>← Reports</a><header class="page-heading"><p class="eyebrow">Learning Journey builder</p><h1>Prepare Eli’s published story</h1><p>Only an approved learner/course record can be selected.</p></header><section class="builder panel"><div class="builder-controls"><label>Learner<select><option>Eli Morgan</option></select></label><label>Course<select><option>Creative App Lab</option></select></label></div><article class="journey-preview"><span>Creative App Lab</span><h2>A working first flow, improved through testing</h2><p>Eli built the core navigation, tested one interaction with a classmate, and revised a confusing step.</p><div><strong>What comes next</strong><p>Test the interaction flow and revise one confusing step.</p></div></article><button type="button" data-publish-journey>Publish to Student and Family demo views</button><p role="status" data-publish-status></p></section></>}

  {section === "billing" && <><header class="page-heading"><p class="eyebrow">Bounded operations</p><h1>Tuition & Billing</h1><p>Illustrative account states only. No payment processor, card mutation, invoice delivery, or charge occurs.</p></header><section class="metric-grid"><article><span>Synthetic monthly total</span><strong>$350</strong></article><article><span>Accounts current</span><strong>2</strong></article><article><span>Needs attention</span><strong>0</strong></article></section><div class="split"><section class="panel"><h2>Demo account ledger</h2><div class="list-row"><span>Morgan Family · Creative App Lab</span><strong>$175 · Current</strong></div><div class="list-row"><span>Reyes Family · Robotics Studio</span><strong>$175 · Current</strong></div></section><section class="panel"><h2>Payment boundary</h2><p>•••• 8901 · illustrative token only</p><button type="button" data-center-local-action="Payment-method editing is disabled in this fixture-only demo.">Update payment method</button></section></div></>}

