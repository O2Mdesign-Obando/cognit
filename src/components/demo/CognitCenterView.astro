---
import { SYNTHETIC_COGNIT_DEMO as d } from "../../demo/cognit-demo-data.js";
import { parseCenterDemoView } from "../../demo/cognit-demo-routes.js";
import { getDemoStudentImage, getDemoCoachImage } from "../../demo/cognit-demo-images.js";
import CognitCenterCommunication from "./CognitCenterCommunication.astro";
import CognitCenterConfiguration from "./CognitCenterConfiguration.astro";
import CognitCenterCloseout from "./CognitCenterCloseout.astro";

const { view = "overview" } = Astro.props;
const parsed = parseCenterDemoView(view);
const aliases = { schedule: "scheduling", messages: "communication", settings: "configuration" };
const section = parsed.section === "configuration" && parsed.item === "modules" ? "module-control" : (aliases[parsed.section] || parsed.section);
const item = parsed.item;
const contextKey = parsed.context;
const context = contextKey === "harbor" ? d.contexts[1] : d.contexts[0];
const contextId = context.id;
const base = parsed.explicitContext ? `/learninghub/demo/center/context/${contextKey}` : "/learninghub/demo/center";
const href = (target, child = "") => parsed.explicitContext ? `${base}/${target}${child ? `/${child}` : ""}` : `/learninghub/demo/center/${target}${child ? `/${child}` : ""}`;
const formatDate = (value) => new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric" }).format(new Date(`${value}T12:00:00`));
const formatTime = (value) => new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(new Date(`2026-08-31T${value}:00`));
const sessionLabel = (session) => `${formatDate(session.date)} · ${formatTime(session.startTime)}–${formatTime(session.endTime)}`;
const homeHref = parsed.explicitContext ? base : "/learninghub/demo/center";
const switchHref = (key) => `/learninghub/demo/center/context/${key}${section === "overview" ? "" : `/${section}`}`;
const primarySection = section === "overview" ? "home"
  : ["classes", "attendance"].includes(section) ? "today"
  : section === "communication" ? "communication"
  : ["coaches", "students", "families"].includes(section) ? "rosters"
  : ["courses", "scheduling"].includes(section) ? "academics"
  : section === "reports" ? "reports"
  : section === "billing" ? "financials"
  : "";
const primaryNav = [
  ["home", "Home", homeHref], ["today", "Today", href("classes")], ["communication", "Communication", href("communication")],
  ["rosters", "Rosters", href("coaches")], ["academics", "Academics", href("courses")], ["reports", "Reports", href("reports")],
  ["financials", "Financials", href("billing")]
];
const secondaryNav = primarySection === "today"
  ? [["classes", "Today’s Classes", href("classes")], ["attendance", "Attendance & Make-Ups", href("attendance")]]
  : primarySection === "rosters"
    ? [["coaches", "Coaches", href("coaches")], ["students", "Students", href("students")], ["families", "Families", href("families")]]
    : primarySection === "academics"
      ? [["courses", "Courses", href("courses")], ["scheduling", "Scheduling", href("scheduling")]]
      : primarySection === "financials"
        ? [["billing", "Tuition & Billing", href("billing")], ["dashboard", "Financial Dashboard", href("billing", "dashboard")]]
        : [];
const contextSessions = d.sessions.filter((s) => s.contextId === contextId).map((session) => ({ ...session, label: sessionLabel(session) }));
const todaySessions = contextSessions.filter((session) => session.date === d.scheduling.operatingDate && session.status !== "draft");
const contextCourseIds = new Set([
  ...contextSessions.map((session) => session.courseId),
  ...d.enrollments.filter((enrollment) => enrollment.contextId === contextId).map((enrollment) => enrollment.courseId)
]);
const contextCourses = d.courses.filter((course) => contextCourseIds.has(course.id));
const contextEnrollmentIds = new Set(d.enrollments.filter((e) => e.contextId === contextId && e.status === "active").map((e) => e.studentId));
const contextStudents = d.people.students.filter((s) => contextEnrollmentIds.has(s.id));
const contextFamilies = d.people.families.filter((family) => family.studentIds.some((studentId) => contextEnrollmentIds.has(studentId)));
const studentById = (id) => d.people.students.find((s) => s.id === id);
const coachById = (id) => d.people.coaches.find((c) => c.id === id);
const courseById = (id) => d.courses.find((c) => c.id === id);
const progressFor = (id) => d.courseProgress.filter((p) => p.studentId === id);
const selectedStudent = d.people.students.find((s) => s.id.endsWith(`-${item}`)) || d.people.students.find((s) => s.id.includes(item)) || d.people.students[0];
const selectedCoach = d.people.coaches.find((c) => c.id.endsWith(`-${item}`)) || d.people.coaches.find((c) => c.id.includes(item)) || d.people.coaches[0];
const selectedFamily = d.people.families.find((family) => family.id.endsWith(`-${item}`)) || d.people.families.find((family) => family.id.includes(item));
const selectedCourse = item ? contextCourses.find((course) => course.id.endsWith(item)) : undefined;
const studentImage = (id) => getDemoStudentImage(id) || { src: "/assets/cognit-demo/student-generic.webp", alt: "", width: 640, height: 640 };
const coachImage = (id) => getDemoCoachImage(id) || { src: "/assets/cognit-demo/coach-placeholder.webp", alt: "", width: 640, height: 640 };
const title = contextKey === "harbor" ? "Harbor Academy Program" : "Northfield Studio";
const reportCategoryKeys = new Set(["attention", "ready", "all", "published"]);
const reportCategory = section === "reports" && reportCategoryKeys.has(item) ? item : (section === "reports" && !item ? "attention" : "");
const reportDisplayDates = {
  "demo-event-eli-habit-flow": { label: "Aug 27, 2026 · 4:38 PM", sort: "2026-08-27T16:38:00-04:00" },
  "demo-event-sofia-sensor-test": { label: "Aug 27, 2026 · 4:24 PM", sort: "2026-08-27T16:24:00-04:00" }
};
const evaluateReport = (event) => {
  const session = d.sessions.find((entry) => entry.id === event.sessionId);
  const student = studentById(event.studentId);
  const course = courseById(event.courseId);
  const coach = coachById(session?.coachId);
  const evidenceRequired = Boolean(event.evidence);
  const evidenceExists = !evidenceRequired || event.evidence.status !== "referenced_missing";
  const evidenceInspectable = !evidenceRequired || event.evidence.status === "available";
  const criteria = [
    { id: "observation", label: "Required Coach observation is present", passed: Boolean(event.observation?.trim()) },
    { id: "next", label: "Required next step is present", passed: Boolean(event.next?.trim()) },
    { id: "evidence", label: evidenceRequired ? "Referenced evidence exists and is inspectable" : "No evidence attachment is required", passed: evidenceExists && evidenceInspectable },
    { id: "relationships", label: "Student, course, Coach, session, and context relationships resolve", passed: Boolean(student && course && coach && session && session.contextId) },
    { id: "complete", label: "Submitted report contains the required learning record", passed: Boolean(event.challenge && event.completed && event.progression?.label) }
  ];
  return { criteria, passed: criteria.every((criterion) => criterion.passed), session, student, course, coach };
};
const reportRecords = d.learningEvents.map((event) => {
  const evaluation = evaluateReport(event);
  const date = reportDisplayDates[event.id] || { label: "Aug 27, 2026", sort: "2026-08-27T12:00:00-04:00" };
  return {
    id: event.studentId.includes("eli-") ? "eli" : "sofia",
    event,
    ...evaluation,
    submittedAt: date.label,
    sortDate: date.sort,
    rulesState: evaluation.passed ? "ready" : "needs_clarification",
    rulesLabel: evaluation.passed ? "Ready for publication" : "Needs clarification",
    publicationLabel: "Not published",
    reason: evaluation.passed ? "All required completeness and relationship checks passed." : "Referenced evidence is missing or cannot be inspected."
  };
}).filter((record) => record.session?.contextId === d.contexts[0].id);
const reportCounts = {
  attention: reportRecords.filter((record) => !record.passed).length,
  ready: reportRecords.filter((record) => record.passed).length,
  all: reportRecords.length,
  published: 0
};
const selectedReport = reportRecords.find((record) => record.id === item);
const scopedStudentEnrollments = d.enrollments.filter((entry) => entry.studentId === selectedStudent.id && entry.contextId === contextId);
const scopedStudentSessions = contextSessions.filter((entry) => entry.studentIds.includes(selectedStudent.id));
const scopedStudentEvent = d.learningEvents.find((entry) => entry.studentId === selectedStudent.id && scopedStudentSessions.some((session) => session.id === entry.sessionId));
const scopedStudentFamily = d.people.families.find((family) => family.studentIds.includes(selectedStudent.id));
const scopedCoachSessions = contextSessions.filter((entry) => entry.coachId === selectedCoach.id);
const scopedCoachLearnerIds = [...new Set(scopedCoachSessions.flatMap((entry) => entry.studentIds))];
const selectedCourseSessions = selectedCourse ? contextSessions.filter((entry) => entry.courseId === selectedCourse.id) : [];
const selectedCourseEnrollments = selectedCourse ? d.enrollments.filter((entry) => entry.courseId === selectedCourse.id && entry.contextId === contextId && entry.status === "active") : [];
const selectedCourseLearners = selectedCourseEnrollments.map((entry) => studentById(entry.studentId)).filter(Boolean);
const selectedCourseWaitlist = selectedCourse ? (selectedCourse.waitlistByContext?.[contextId] || []).map(studentById).filter(Boolean) : [];
const selectedCourseDelivery = selectedCourse?.deliveryByContext?.[contextId];
const selectedCourseCurrentModule = selectedCourse?.modules.find((module) => module.state === "current");
const contextCoaches = d.people.coaches.filter((coach) => coach.contextIds.includes(contextId));
const scheduleMode = ["daily", "weekly", "monthly", "season"].includes(item) ? item : "daily";
const scheduleSessionSlug = item.startsWith("session/") ? item.slice(8) : item.startsWith("staffing/") ? item.slice(9) : "";
const selectedScheduleSession = scheduleSessionSlug ? contextSessions.find((session) => session.id === `demo-session-${scheduleSessionSlug}` || session.id.endsWith(scheduleSessionSlug)) : undefined;
const contextRoomRecords = d.scheduling.roomsByContext[contextId] || [];
const contextRooms = contextRoomRecords.map((room) => room.name);
const contextHours = d.scheduling.workingHoursByContext[contextId];
const currentSeasonMilestones = d.scheduling.milestones.filter((entry) => entry.contextId === contextId);
const projectedSessions = scheduleMode === "daily" ? contextSessions.filter((session) => session.date === d.scheduling.operatingDate) : scheduleMode === "weekly" ? contextSessions.filter((session) => session.date >= "2026-08-31" && session.date <= "2026-09-06") : scheduleMode === "monthly" ? contextSessions.filter((session) => session.date.startsWith("2026-09")) : contextSessions;
const scheduleProjectionTitle = scheduleMode === "daily" ? "Monday, August 31" : scheduleMode === "weekly" ? "Week of August 31" : scheduleMode === "monthly" ? "September 2026" : d.scheduling.season.label;
const contextAttendance = d.attendance.filter((entry) => entry.contextId === contextId);
const contextEntitlements = d.makeupEntitlements.filter((entry) => entry.contextId === contextId);
const attendanceById = (id) => contextAttendance.find((entry) => entry.id === id);
const contextCancellation = d.cancellationConsequences.find((entry) => entry.contextId === contextId);
const selectedStudentAttendance = contextAttendance.filter((entry) => entry.studentId === selectedStudent.id);
const selectedStudentEntitlements = contextEntitlements.filter((entry) => entry.studentId === selectedStudent.id);
const entitlementStatusOrder = ["available", "redeemed", "expired"];
const tokenStatusLabel = (status) => status === "redeemed" ? "Used" : status === "available" ? "Available" : "Expired";
const tokenOriginLabel = (origin) => origin === "center_cancellation" ? "Class cancellation" : origin === "recognized_absence" ? "Reported absence" : origin === "authorized_override" ? "Center exception" : String(origin).replaceAll("_", " ");
const entitlementSlug = item.startsWith("makeup/") ? item.slice(7) : "";
const selectedEntitlement = entitlementSlug ? contextEntitlements.find((entry) => entry.id === `demo-makeup-${entitlementSlug}`) : undefined;
const formatMoney = (value) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);
const contextBillingAccounts = d.financials.accounts.filter((account) => account.contextId === contextId);
const billingPath = item.split("/").filter(Boolean);
const selectedBillingAccount = billingPath[0] === "account" ? contextBillingAccounts.find((account) => account.slug === billingPath[1]) : undefined;
const billingMode = item === "dashboard" ? "dashboard" : selectedBillingAccount ? (billingPath[2] === "method" ? "method" : "detail") : "overview";
const billingStudent = selectedBillingAccount ? studentById(selectedBillingAccount.studentId) : undefined;
const billingCourse = selectedBillingAccount ? courseById(selectedBillingAccount.courseId) : undefined;
const billingDashboard = d.financials.dashboardByContext[contextId];
const billingStatusLabel = (status) => status === "past_due" ? "Past due" : status === "action_required" ? "Action required" : "Current";
const billingStatusClass = (status) => status === "current" ? "ready" : status === "past_due" ? "clarification" : "attention";
const billingCounts = {
  current: contextBillingAccounts.filter((account) => account.status === "current").length,
  pastDue: contextBillingAccounts.filter((account) => account.status === "past_due").length,
  attention: contextBillingAccounts.filter((account) => account.status === "action_required").length,
  outstanding: contextBillingAccounts.reduce((sum, account) => sum + account.openBalance, 0)
};
---

<div class="center-shell" data-center-root data-context={contextKey} data-view={section} data-item={item} data-attendance-href={href("attendance")} data-schedule-base={JSON.stringify(contextSessions)} data-room-base={JSON.stringify(contextRoomRecords)} data-course-base={JSON.stringify(contextCourses.map((course)=>({id:course.id,name:course.name,capacity:course.capacity})))} data-coach-base={JSON.stringify(contextCoaches.map((coach)=>({id:coach.id,name:coach.name,status:coach.status})))}>
  <header class="center-topline">
    <div><strong data-center-display-name>{title}</strong><span>Center Operations</span></div>
    <div class="top-actions">
      <div class="context-control"><span>Operating context</span><a href={switchHref("northfield")} aria-current={contextKey === "northfield" ? "page" : undefined}>Northfield</a><a href={switchHref("harbor")} aria-current={contextKey === "harbor" ? "page" : undefined}>Harbor</a></div>
      <details class="profile-menu"><summary><span>MC</span>Maya Chen</summary><nav aria-label="User utilities"><a href={href("support")} aria-current={section === "support" ? "page" : undefined}>Support</a><a href={href("whats-new")} aria-current={section === "whats-new" ? "page" : undefined}>What’s New</a><a href={href("configuration")} aria-current={["configuration", "module-control", "migration"].includes(section) ? "page" : undefined}>Settings</a><button type="button" data-center-local-action="Signed out.">Sign out</button></nav></details>
    </div>
  </header>
  <div class="center-navigation">
    <nav class="center-nav center-nav-primary" aria-label="Center sections">{primaryNav.map(([id,label,url]) => <a href={url} aria-current={primarySection === id ? "page" : undefined}>{label}</a>)}</nav>
    {secondaryNav.length > 0 && <nav class={`center-nav center-nav-secondary secondary-${primarySection}`} aria-label={`${primaryNav.find(([id]) => id === primarySection)?.[1]} pages`}>{secondaryNav.map(([id,label,url]) => <a href={url} aria-current={id === "dashboard" ? billingMode === "dashboard" ? "page" : undefined : section === id && billingMode !== "dashboard" ? "page" : undefined}>{label}</a>)}</nav>}
  </div>

  {section === "overview" && <>
    <header class="center-hero"><p class="eyebrow">Center operations</p><h1>Run today’s learning operation.</h1><p>Review by exception across schedules, learners, reporting, communication, and operational continuity.</p></header>
    {contextKey === "harbor" ? <section class="empty-state"><span>Harbor Academy Program</span><h2>No Center actions need attention</h2><p>No reports, attendance exceptions, billing items, or Family records are available in this context. Noah’s school-program enrollment remains separate from Northfield.</p><a href={href("students")}>View Harbor learner roster →</a></section> : <>
      <section class="attention-list" aria-label="Center attention queue">
        <article><span>Review</span><div><h2>Sofia’s update needs clarification</h2><p>The referenced sensor trial record is unavailable.</p></div><a href={href("reports","sofia")}>Review report →</a></article>
        <article><span>Publish</span><div><h2>Eli’s Learning Journey is ready</h2><p>The submitted record passed the required checks and is ready for Center publication.</p></div><a href={href("reports","eli")}>Review and publish →</a></article>
        <article><span>Reply</span><div><h2>Coach reply requested</h2><p>Priya asked what evidence is needed for Sofia’s update.</p></div><a href={href("communication","thread/priya-evidence")}>Open thread →</a></article>
        <article data-unassigned-card><span>Coverage</span><div><h2>Digital Storytelling needs a Coach</h2><p>Saturday · 10:00–11:30 AM · two learners.</p></div><a href={href("scheduling","staffing/storytelling-today")}>Resolve staffing →</a></article>
        <article><span>Attendance</span><div><h2>Attendance and Make-Up Tokens</h2><p>See automatic policy results, available tokens, and the exceptions that need judgment.</p></div><a href={href("attendance")}>Open Attendance →</a></article>
        <article><span>Billing</span><div><h2>Billing accounts need review</h2><p>Review current balances, payment status, and Family follow-up.</p></div><a href={href("billing")}>Review →</a></article>
      </section>
    </>}
  </>}

  {section === "classes" && item !== "creative/attendance" && <>
    <header class="page-heading"><p class="eyebrow">Today · {title}</p><h1>Today’s Classes</h1><p>Scheduled, active, completed, and coverage-exception states remain explicit.</p></header>
    {todaySessions.length ? <section class="session-list" data-schedule-projection="today">
      {todaySessions.map((session, index) => { const course = courseById(session.courseId); const coach = coachById(session.coachId); return <article data-schedule-session={session.id} data-session-date={session.date} data-session-start={session.startTime} data-session-end={session.endTime} data-session-room={session.room} data-session-coach={session.coachId || ""} data-session-status={session.status}>
        <div><span>{sessionLabel(session)}</span><h2>{course.name}</h2><p>{session.learningFocus}</p><small><span data-session-roster>{session.studentIds.length}</span> learners · <span data-session-coach-name>{coach?.name || "Coach unassigned"}</span> · <span data-session-room-name>{session.room}</span></small></div>
        <div class="session-actions"><b class={`status ${session.status}`} data-session-status-label>{session.status.replaceAll("_"," ")}</b><a href={index === 0 ? href("classes","creative/attendance") : href("scheduling",`session/${session.id.replace("demo-session-","")}`)}>{index === 0 ? "Open attendance" : "Open session"} →</a></div>
      </article>})}
    </section> : <section class="empty-state"><h2>No classes scheduled in this context</h2><p>Harbor has no sessions on today’s Northfield operating date.</p></section>}
  </>}

  {section === "classes" && item === "creative/attendance" && <>
    <header class="page-heading"><p class="eyebrow">Attendance detail</p><h1>Creative App Lab</h1><p>Reported, inferred, and confirmed states are never collapsed into one another.</p></header>
    <section class="attendance-summary"><article><span>Expected</span><strong>2</strong></article><article><span>Present</span><strong data-count-present>1</strong></article><article><span>Late</span><strong data-count-late>0</strong></article><article><span>Absent</span><strong data-count-absent>0</strong></article><article><span>Needs review</span><strong data-count-review>1</strong></article></section>
    <section class="attendance-list">
      <article data-attendance-row data-attendance="unresolved"><img {...studentImage("demo-student-lena-grant")} /><div><h2>Lena Grant</h2><p>Expected · no check-in or Family notice recorded. Inactivity alone is not a confirmed absence.</p></div><fieldset><legend>Confirm or correct state</legend><button type="button" data-attendance-action="present">Present</button><button type="button" data-attendance-action="late">Late</button><button type="button" data-attendance-action="absent">Absent</button></fieldset><b data-attendance-label>Needs review</b></article>
      <article data-correctable-attendance><img {...studentImage("demo-student-eli-morgan")} /><div><h2>Eli Morgan</h2><p>Check-in confirmed at 3:58 PM · correction history is retained.</p></div><fieldset><legend>Manual correction</legend><button type="button" data-manual-correction="present">Present</button><button type="button" data-manual-correction="late">Late</button></fieldset><b class="confirmed" data-corrected-label>Present</b></article>
    </section>
    <p class="record-boundary">Attendance confirmation updates the record. A reported illness or appointment before class is checked against Center policy automatically; qualifying reports add a Make-Up Token to the Family account.</p>
    <div class="workflow-actions"><a class="button-link" href={href("attendance")}>Continue to Attendance &amp; Make-Ups →</a><a href={href("attendance","makeup")}>Open Make-Up Tokens</a></div>
  </>}

  {section === "attendance" && (!item || item === "eli" || item === "sofia") && <>
    <header class="page-heading"><p class="eyebrow">Attendance &amp; Make-Ups · {title}</p><h1>Attendance and Make-Up Tokens</h1><p>See what Center policy handled automatically and focus staff attention only on exceptions.</p></header>
    {contextKey === "harbor" ? <section class="empty-state"><h2>No attendance records in this context</h2><p>Northfield attendance and Make-Up Token records are not available in Harbor Academy Program.</p></section> : <>
      <section class="panel policy-card"><div><p class="eyebrow">Center policy</p><h2>{d.attendancePolicy.label}</h2></div><p>{d.attendancePolicy.rule}</p><strong data-config-expiry-copy>Make-Up Tokens expire {d.attendancePolicy.expiryDays} days after they are added.</strong><small>{d.attendancePolicy.financialBoundary}</small></section>
      <section class="attendance-summary consequence-summary"><article><span>Present</span><strong>{contextAttendance.filter((entry)=>entry.status==="present").length}</strong></article><article><span>Late</span><strong>{contextAttendance.filter((entry)=>entry.status==="late").length}</strong></article><article><span>Reported</span><strong>{contextAttendance.filter((entry)=>entry.status==="reported_absence").length}</strong></article><article><span>Needs review</span><strong>{contextAttendance.filter((entry)=>entry.status==="needs_review").length}</strong></article><article><span>Confirmed absent</span><strong>{contextAttendance.filter((entry)=>entry.status==="confirmed_absent").length}</strong></article></section>
      <div class="section-heading consequence-heading"><div><p class="eyebrow">What happened</p><h2>Automatic actions and exceptions</h2></div><a href={href("attendance","makeup")}>Make-Up Tokens →</a></div>
      <section class="consequence-grid">
        <article class="panel consequence-card"><span class="status-chip ready">Make-Up Token added automatically</span><h2>Mina Park · Digital Storytelling Lab</h2><p>Illness was reported before class. Center policy qualified the absence and added a token to the Park Family account.</p><a href={href("attendance","absence/mina-storytelling")}>View Make-Up Token status →</a></article>
        <article class="panel consequence-card"><span class="status-chip clarification">Exception available</span><h2>Ava Thompson · No Make-Up Token</h2><p>The standard Center policy did not add a token. Review the result only if staff judgment is needed.</p><a href={href("attendance","override/ava-storytelling")}>Review exception →</a></article>
        <article class="panel consequence-card"><span class="status-chip ready">2 Make-Up Tokens added</span><h2>Creative App Lab · weather closure</h2><p>Eli Morgan and Lena Grant automatically received tokens on their Family accounts.</p><a href={href("attendance","cancellation/creative-weather")}>See what happened →</a></article>
      </section>
      <div class="section-heading consequence-heading"><div><p class="eyebrow">Student history</p><h2>Make-Up Token status</h2></div></div>
      <section class="consequence-grid">
        <article class="panel consequence-card"><span class="status-chip ready">Make-Up Token available</span><h2>Sofia Reyes · Robotics Studio</h2><p>An appointment reported before class added one token automatically to the Reyes Family account.</p><a href={href("attendance","makeup/sofia-robotics")}>Open Make-Up Token →</a></article>
        <article class="panel consequence-card"><span class="status-chip neutral">Token history</span><h2>Make-Up Tokens</h2><p>Review Available, Used, and Expired tokens with their origin and dates.</p><a href={href("attendance","makeup")}>Open token management →</a></article>
      </section>
      <aside class="panel"><div class="section-heading"><div><p class="eyebrow">Family follow-up</p><h2>Prepare an attendance message</h2></div><a class="action action-secondary" href={href("communication","compose?attendance=mina-storytelling")}>Prepare Family message</a></div><p>Opens a draft with Mina, the Park Family, Digital Storytelling Lab, and the Make-Up Token result already connected. Review is required before Send.</p></aside>
    </>}
  </>}

