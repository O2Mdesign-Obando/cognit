ion.</label><div class="schedule-form-actions span-all"><button type="button" class="action action-secondary" data-schedule-save-draft>Save draft</button><button type="submit">Evaluate and activate</button></div><section class="conflict-panel span-all" aria-live="polite" data-schedule-conflicts><strong>Conflict evaluation</strong><p>Choose session details to evaluate room, Coach, and capacity constraints.</p></section><p class="span-all" role="status" data-schedule-form-status></p></form></section></>}
