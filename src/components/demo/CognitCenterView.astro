e})))}><div class="schedule-board-heading"><div><p class="eyebrow">{scheduleMode} projection</p><h2>{scheduleProjectionTitle}</h2></div><span>All views derive from the same session records</span></div>{projectedSessions.map((session)=>{const course=courseById(session.courseId);const coach=coachById(session.coachId);return <article class={`schedule-session ${session.conflicts.some((conflict)=>conflict.severity==="hard") ? "has-conflict" : ""}`} data-schedule-session={session.id} data-session-date={session.date} data-session-start={session.startTime} data-session-end={session.endTime} data-session-room={session.room} data-session-coach={session.coachId || ""} data-session-status={session.status}><div class="schedule-session-time"><strong>{formatTime(session.startTime)}</strong><small>{formatTime(session.endTime)}</small></div><div><span>{formatDate(session.date)} · {session.recurrence}</span><h3>{course?.name}</h3><p>{session.learningFocus}</p><small><span data-session-coach-name>{coach?.name || "Coach unassigned"}</span> · <span data-session-room-name>{session.room}</span> · <span data-session-roster>{session.studentIds.length}</span> learners</small>{session.exception && <em>{session.exception}</em>}</div><div class="session-actions"><b class={`status ${session.status}`} data-session-status-label>{session.status.replaceAll("_"," ")}</b>{session.conflicts.length ? <span class="conflict-count">{session.conflicts.length} unresolved</span> : null}<a href={href("scheduling",`session/${session.id.replace("demo-session-","")}`)}>Open session →</a></div></article>})}{!projectedSessions.length && <p>No sessions in this period for {title}.</p>}{scheduleMode !== "daily" && currentSeasonMilestones.map((milestone)=><article class={`schedule-milestone ${milestone.type}`}><div><span>{formatDate(milestone.date)}</span><h3>{milestone.label}</h3></div></article>)}</section><div class="schedule-footer-actions"><a class="danger-link" href={href("scheduling","cancel")}>Record a cancellation →</a><p>Notification delivery, attendance consequences, makeup, and credits remain outside this slice.</p></div></>}
