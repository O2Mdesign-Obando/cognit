---
import { SYNTHETIC_COGNIT_DEMO as d } from "../../demo/cognit-demo-data.js";
import { parseCenterDemoView } from "../../demo/cognit-demo-routes.js";
import { getDemoStudentImage, getDemoCoachImage } from "../../demo/cognit-demo-images.js";

const { view = "overview" } = Astro.props;
const parsed = parseCenterDemoView(view);
const aliases = { schedule: "scheduling", messages: "communication", settings: "configuration" };
const section = parsed.section === "configuration" && parsed.item === "modules" ? "module-control" : (aliases[parsed.section] || parsed.section);
const item = parsed.item;
const contextKey = parsed.context;
const context = contextKey === "harbor" ? d.contexts[1] : d.contexts[0];
const contextId = context.id;
const base = parsed.explicitContext ? `/learninghub/demo/center/context/${contextKey}` : "/learninghub/demo/center";
const href = (target, child = "") => parsed.explicitContext ? `${base}/${target}${child ? `/${child}` : ""}` : `/learninghub/demo/center/${target}${child ? `/${child}` : ""}`;
const formatDate = (value) => new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric" }).format(new Date(`${value}T12:00:00`));
const formatTime = (value) => new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(new Date(`2026-08-31T${value}:00`));
const sessionLabel = (session) => `${formatDate(session.date)} · ${formatTime(session.startTime)}–${formatTime(session.endTime)}`;
const homeHref = parsed.explicitContext ? base : "/learninghub/demo/center";
const switchHref = (key) => `/learninghub/demo/center/context/${key}${section === "overview" ? "" : `/${section}`}`;
const activeSection = section === "attendance" ? "classes" : section;
const nav = [
  ["overview", "Home", homeHref], ["classes", "Today’s Classes", href("classes")], ["communication", "Communication", href("communication")],
  ["coaches", "Coaches", href("coaches")], ["students", "Students", href("students")], ["families", "Families", href("families")], ["scheduling", "Scheduling", href("scheduling")],
  ["courses", "Courses", href("courses")], ["billing", "Tuition & Billing", href("billing")], ["reports", "Reports", href("reports")], ["whats-new", "What’s New", href("whats-new")]
];
const contextSessions = d.sessions.filter((s) => s.contextId === contextId).map((session) => ({ ...session, label: sessionLabel(session) }));
const todaySessions = contextSessions.filter((session) => session.date === d.scheduling.operatingDate && session.status !== "draft");
const contextCourseIds = new Set([
  ...contextSessions.map((session) => session.courseId),
  ...d.enrollments.filter((enrollment) => enrollment.contextId === contextId).map((enrollment) => enrollment.courseId)
]);
const contextCourses = d.courses.filter((course) => contextCourseIds.has(course.id));
const contextEnrollmentIds = new Set(d.enrollments.filter((e) => e.contextId === contextId && e.status === "active").map((e) => e.studentId));
const contextStudents = d.people.students.filter((s) => contextEnrollmentIds.has(s.id));
const contextFamilies = d.people.families.filter((family) => family.studentIds.some((studentId) => contextEnrollmentIds.has(studentId)));
const studentById = (id) => d.people.students.find((s) => s.id === id);
const coachById = (id) => d.people.coaches.find((c) => c.id === id);
const courseById = (id) => d.courses.find((c) => c.id === id);
const progressFor = (id) => d.courseProgress.filter((p) => p.studentId === id);
const selectedStudent = d.people.students.find((s) => s.id.endsWith(`-${item}`)) || d.people.students.find((s) => s.id.includes(item)) || d.people.students[0];
const selectedCoach = d.people.coaches.find((c) => c.id.endsWith(`-${item}`)) || d.people.coaches.find((c) => c.id.includes(item)) || d.people.coaches[0];
const selectedFamily = d.people.families.find((family) => family.id.endsWith(`-${item}`)) || d.people.families.find((family) => family.id.includes(item));
const selectedCourse = item ? contextCourses.find((course) => course.id.endsWith(item)) : undefined;
const studentImage = (id) => getDemoStudentImage(id) || { src: "/assets/cognit-demo/student-generic.webp", alt: "", width: 640, height: 640 };
const coachImage = (id) => getDemoCoachImage(id) || { src: "/assets/cognit-demo/coach-placeholder.webp", alt: "", width: 640, height: 640 };
const title = contextKey === "harbor" ? "Harbor Academy Program" : "Northfield Studio";
const reportCategoryKeys = new Set(["attention", "ready", "all", "published"]);
const reportCategory = section === "reports" && reportCategoryKeys.has(item) ? item : (section === "reports" && !item ? "attention" : "");
const reportDisplayDates = {
  "demo-event-eli-habit-flow": { label: "Aug 27, 2026 · 4:38 PM", sort: "2026-08-27T16:38:00-04:00" },
  "demo-event-sofia-sensor-test": { label: "Aug 27, 2026 · 4:24 PM", sort: "2026-08-27T16:24:00-04:00" }
};
const evaluateReport = (event) => {
  const session = d.sessions.find((entry) => entry.id === event.sessionId);
  const student = studentById(event.studentId);
  const course = courseById(event.courseId);
  const coach = coachById(session?.coachId);
  const evidenceRequired = Boolean(event.evidence);
  const evidenceExists = !evidenceRequired || event.evidence.status !== "referenced_missing";
  const evidenceInspectable = !evidenceRequired || event.evidence.status === "available";
  const criteria = [
    { id: "observation", label: "Required Coach observation is present", passed: Boolean(event.observation?.trim()) },
    { id: "next", label: "Required next step is present", passed: Boolean(event.next?.trim()) },
    { id: "evidence", label: evidenceRequired ? "Referenced evidence exists and is inspectable" : "No evidence attachment is required", passed: evidenceExists && evidenceInspectable },
    { id: "relationships", label: "Student, course, Coach, session, and context relationships resolve", passed: Boolean(student && course && coach && session && session.contextId) },
    { id: "complete", label: "Submitted report contains the required learning record", passed: Boolean(event.challenge && event.completed && event.progression?.label) }
  ];
  return { criteria, passed: criteria.every((criterion) => criterion.passed), session, student, course, coach };
};
const reportRecords = d.learningEvents.map((event) => {
  const evaluation = evaluateReport(event);
  const date = reportDisplayDates[event.id] || { label: "Aug 27, 2026", sort: "2026-08-27T12:00:00-04:00" };
  return {
    id: event.studentId.includes("eli-") ? "eli" : "sofia",
    event,
    ...evaluation,
    submittedAt: date.label,
    sortDate: date.sort,
    rulesState: evaluation.passed ? "ready" : "needs_clarification",
    rulesLabel: evaluation.passed ? "Ready for publication" : "Needs clarification",
    publicationLabel: "Not published",
    reason: evaluation.passed ? "All deterministic completeness and relationship checks passed." : "Referenced evidence is missing or cannot be inspected."
  };
}).filter((record) => record.session?.contextId === d.contexts[0].id);
const reportCounts = {
  attention: reportRecords.filter((record) => !record.passed).length,
  ready: reportRecords.filter((record) => record.passed).length,
  all: reportRecords.length,
  published: 0
};
const selectedReport = reportRecords.find((record) => record.id === item);
const scopedStudentEnrollments = d.enrollments.filter((entry) => entry.studentId === selectedStudent.id && entry.contextId === contextId);
const scopedStudentSessions = contextSessions.filter((entry) => entry.studentIds.includes(selectedStudent.id));
const scopedStudentEvent = d.learningEvents.find((entry) => entry.studentId === selectedStudent.id && scopedStudentSessions.some((session) => session.id === entry.sessionId));
const scopedStudentFamily = d.people.families.find((family) => family.studentIds.includes(selectedStudent.id));
const scopedCoachSessions = contextSessions.filter((entry) => entry.coachId === selectedCoach.id);
const scopedCoachLearnerIds = [...new Set(scopedCoachSessions.flatMap((entry) => entry.studentIds))];
const selectedCourseSessions = selectedCourse ? contextSessions.filter((entry) => entry.courseId === selectedCourse.id) : [];
const selectedCourseEnrollments = selectedCourse ? d.enrollments.filter((entry) => entry.courseId === selectedCourse.id && entry.contextId === contextId && entry.status === "active") : [];
const selectedCourseLearners = selectedCourseEnrollments.map((entry) => studentById(entry.studentId)).filter(Boolean);
const selectedCourseWaitlist = selectedCourse ? (selectedCourse.waitlistByContext?.[contextId] || []).map(studentById).filter(Boolean) : [];
const selectedCourseDelivery = selectedCourse?.deliveryByContext?.[contextId];
const selectedCourseCurrentModule = selectedCourse?.modules.find((module) => module.state === "current");
const contextCoaches = d.people.coaches.filter((coach) => coach.contextIds.includes(contextId));
const scheduleMode = ["daily", "weekly", "monthly", "season"].includes(item) ? item : "daily";
const scheduleSessionSlug = item.startsWith("session/") ? item.slice(8) : item.startsWith("staffing/") ? item.slice(9) : "";
const selectedScheduleSession = scheduleSessionSlug ? contextSessions.find((session) => session.id === `demo-session-${scheduleSessionSlug}` || session.id.endsWith(scheduleSessionSlug)) : undefined;
const contextRooms = d.scheduling.roomsByContext[contextId] || [];
const currentSeasonMilestones = d.scheduling.milestones.filter((entry) => entry.contextId === contextId);
const projectedSessions = scheduleMode === "daily" ? contextSessions.filter((session) => session.date === d.scheduling.operatingDate) : scheduleMode === "weekly" ? contextSessions.filter((session) => session.date >= "2026-08-31" && session.date <= "2026-09-06") : scheduleMode === "monthly" ? contextSessions.filter((session) => session.date.startsWith("2026-09")) : contextSessions;
const scheduleProjectionTitle = scheduleMode === "daily" ? "Monday, August 31" : scheduleMode === "weekly" ? "Week of August 31" : scheduleMode === "monthly" ? "September 2026" : d.scheduling.season.label;
---

<div class="center-shell" data-center-root data-context={contextKey} data-view={section} data-item={item} data-schedule-base={JSON.stringify(contextSessions)} data-course-base={JSON.stringify(contextCourses.map((course)=>({id:course.id,name:course.name,capacity:course.capacity})))} data-coach-base={JSON.stringify(contextCoaches.map((coach)=>({id:coach.id,name:coach.name,status:coach.status})))}>
  <header class="center-topline">
    <div><strong>{title}</strong><span>Center Operations · Presentation environment</span></div>
    <div class="top-actions">
      <div class="context-control"><span>Operating context</span><a href={switchHref("northfield")} aria-current={contextKey === "northfield" ? "page" : undefined}>Northfield</a><a href={switchHref("harbor")} aria-current={contextKey === "harbor" ? "page" : undefined}>Harbor</a></div>
      <details class="profile-menu"><summary><span>MC</span>Maya Chen</summary><nav><a href={href("support")}>Support</a><a href={href("configuration")}>Settings</a><button type="button" data-center-local-action="Signed out of this presentation session.">Log out</button></nav></details>
    </div>
  </header>
  <nav class="center-nav" aria-label="Center demo sections">{nav.map(([id,label,url]) => <a href={url} aria-current={activeSection === id ? "page" : undefined}>{label}</a>)}</nav>

  {section === "overview" && <>
    <header class="center-hero"><p class="eyebrow">Center operations</p><h1>Run today’s learning operation.</h1><p>Review by exception across schedules, learners, reporting, communication, and operational continuity.</p></header>
    {contextKey === "harbor" ? <section class="empty-state"><span>Harbor Academy Program</span><h2>No Center actions need attention</h2><p>No reports, attendance exceptions, billing items, or Family records are available in this context. Noah’s school-program enrollment remains separate from Northfield.</p><a href={href("students")}>View Harbor learner roster →</a></section> : <>
      <section class="attention-list" aria-label="Center attention queue">
        <article><span>Review</span><div><h2>Sofia’s update needs clarification</h2><p>The referenced sensor trial record is unavailable.</p></div><a href={href("reports","sofia")}>Review report →</a></article>
        <article><span>Publish</span><div><h2>Eli’s Learning Journey is ready</h2><p>The submitted record passed deterministic checks and is ready for Center publication.</p></div><a href={href("reports","eli")}>Review and publish →</a></article>
        <article><span>Reply</span><div><h2>Coach reply requested</h2><p>Priya asked what evidence is needed for Sofia’s update.</p></div><a href={href("communication","coach")}>Open thread →</a></article>
        <article data-unassigned-card><span>Coverage</span><div><h2>Digital Storytelling needs a Coach</h2><p>Saturday · 10:00–11:30 AM · two learners.</p></div><a href={href("scheduling","staffing/storytelling-today")}>Resolve staffing →</a></article>
        <article><span>Attendance</span><div><h2>One attendance record is unresolved</h2><p>Confirm the arrival state without inferring attendance.</p></div><a href={href("classes","creative/attendance")}>Resolve →</a></article>
        <article><span>Billing</span><div><h2>Bounded demo billing view</h2><p>Illustrative account states only; no processor connection.</p></div><a href={href("billing")}>Review →</a></article>
      </section>
      <section class="clear-banner"><span>✓</span><strong>All clear:</strong> authorization boundaries · multi-context isolation · no real payment or delivery actions</section>
    </>}
  </>}

  {section === "classes" && item !== "creative/attendance" && <>
    <header class="page-heading"><p class="eyebrow">Today · {title}</p><h1>Today’s Classes</h1><p>Scheduled, active, completed, and coverage-exception states remain explicit.</p></header>
    {todaySessions.length ? <section class="session-list" data-schedule-projection="today">
      {todaySessions.map((session, index) => { const course = courseById(session.courseId); const coach = coachById(session.coachId); return <article data-schedule-session={session.id} data-session-date={session.date} data-session-start={session.startTime} data-session-end={session.endTime} data-session-room={session.room} data-session-coach={session.coachId || ""} data-session-status={session.status}>
        <div><span>{sessionLabel(session)}</span><h2>{course.name}</h2><p>{session.learningFocus}</p><small><span data-session-roster>{session.studentIds.length}</span> learners · <span data-session-coach-name>{coach?.name || "Coach unassigned"}</span> · <span data-session-room-name>{session.room}</span></small></div>
        <div class="session-actions"><b class={`status ${session.status}`} data-session-status-label>{session.status.replaceAll("_"," ")}</b><a href={index === 0 ? href("classes","creative/attendance") : href("scheduling",`session/${session.id.replace("demo-session-","")}`)}>{index === 0 ? "Open attendance" : "Open session"} →</a></div>
      </article>})}
    </section> : <section class="empty-state"><h2>No classes scheduled in this context</h2><p>Harbor has no sessions on today’s Northfield operating date.</p></section>}
  </>}

  {(section === "attendance" || (section === "classes" && item === "creative/attendance")) && <>
    <header class="page-heading"><p class="eyebrow">Attendance detail</p><h1>Creative App Lab</h1><p>Reported, inferred, and confirmed states are never collapsed into one another.</p></header>
    <section class="attendance-summary"><article><span>Expected</span><strong>4</strong></article><article><span>Present</span><strong data-count-present>1</strong></article><article><span>Late</span><strong data-count-late>1</strong></article><article><span>Reported absent</span><strong>1</strong></article><article><span>Needs review</span><strong data-count-review>1</strong></article></section>
    <section class="attendance-list">
      <article data-attendance-row data-attendance="unresolved"><img {...studentImage("demo-student-lena-grant")} /><div><h2>Lena Grant</h2><p>Expected · no check-in or Family notice recorded</p></div><fieldset><legend>Confirm state</legend><button type="button" data-attendance-action="present">Present</button><button type="button" data-attendance-action="late">Late</button><button type="button" data-attendance-action="absent">Absent</button></fieldset><b data-attendance-label>Needs review</b></article>
      <article><img {...studentImage("demo-student-eli-morgan")} /><div><h2>Eli Morgan</h2><p>Check-in confirmed at 3:58 PM</p></div><b class="confirmed">Present</b></article>
      <article><img {...studentImage("demo-student-sofia-reyes")} /><div><h2>Sofia Reyes</h2><p>Arrival confirmed at 6:02 PM</p></div><b class="late">Late</b></article>
      <article><img {...studentImage("demo-student-mina-park")} /><div><h2>Mina Park</h2><p>Family reported absence before class; confirmation remains distinct.</p></div><b class="reported">Reported absent</b></article>
    </section>
  </>}

  {section === "students" && !item && <>
    <header class="page-heading"><p class="eyebrow">Learner stewardship</p><h1>Students</h1><p>Find the learner, then inspect the authorized Family, Coach, enrollment, and operating relationship for this context.</p></header>
    <section class="filters people-filters"><label>Search<input type="search" placeholder="Search learner" data-student-search /></label><label>Course<select data-student-course><option value="all">All courses</option>{d.courses.map(c => <option value={c.id}>{c.name}</option>)}</select></label><label>Status<select data-student-status><option value="all">All statuses</option><option value="active">Active</option><option value="waitlist">Waitlist</option></select></label></section>
    <p class="results-summary" role="status" aria-live="polite" data-student-results>{contextStudents.length} learners shown</p>
    <section class="people-grid people-grid-operational" data-student-grid>{contextStudents.map((student) => { const enrollments = d.enrollments.filter(e => e.studentId === student.id && e.contextId === contextId && e.status === "active"); const family=d.people.families.find(f=>f.studentIds.includes(student.id)); const sessions=contextSessions.filter(s=>s.studentIds.includes(student.id)); const coaches=[...new Set(sessions.map(s=>coachById(s.coachId)?.name).filter(Boolean))]; return <a href={href("students",student.id.split("-").pop())} data-student-card={student.id} data-name={student.name.toLowerCase()} data-courses={enrollments.map(e=>e.courseId).join(" ")} data-status={student.operatingStatus}><img {...studentImage(student.id)} /><div class="person-card-copy"><div class="person-card-title"><h2>{student.name}</h2><span class={`status-chip ${student.operatingStatus === "active" ? "ready" : "clarification"}`} data-student-roster-status>{student.operatingStatus}</span></div><p>{enrollments.map(e=>courseById(e.courseId)?.name).join(" · ") || "No active course"}</p><dl class="compact-facts"><div><dt>Coach</dt><dd>{coaches.join(" · ") || "Unassigned"}</dd></div><div><dt>Family</dt><dd>{family?.name || "No authorized Family"}</dd></div><div><dt>Enrollment</dt><dd>{enrollments.length} active</dd></div></dl></div></a>})}</section>
  </>}

  {section === "students" && item && <>
    <a class="back-inline" href={href("students")}>← Student roster</a><header class="profile-heading"><img {...studentImage(selectedStudent.id)} /><div><p class="eyebrow">Student profile</p><h1>{selectedStudent.name}</h1><p>Profile fields are limited to this operating relationship · one persistent identity across context-specific enrollments.</p><span class={`status-chip ${scopedStudentEnrollments.some((entry) => entry.status === "active") ? "ready" : "neutral"}`}>{scopedStudentEnrollments.some((entry) => entry.status === "active") ? "Active in this context" : "No active enrollment here"}</span></div></header>
    {scopedStudentEnrollments.length ? <div class="profile-sections">
      <section class="panel"><h2>Identity and relationships</h2><dl class="profile-facts"><div><dt>Operating context</dt><dd>{title}</dd></div><div><dt>Operating status</dt><dd><span class={`status-chip ${selectedStudent.operatingStatus === "active" ? "ready" : "clarification"}`} data-student-detail-status>{selectedStudent.operatingStatus}</span></dd></div><div><dt>Authorized Family relationship</dt><dd>{scopedStudentFamily ? `${scopedStudentFamily.name} · ${scopedStudentFamily.primaryContact.name}` : "None in this context"}</dd></div><div><dt>Primary Coach here</dt><dd>{scopedStudentSessions.length ? coachById(scopedStudentSessions[0].coachId)?.name : "No scheduled Coach"}</dd></div></dl></section>
      <section class="panel"><h2>Enrollments and schedule</h2>{scopedStudentEnrollments.map((entry) => { const course=courseById(entry.courseId); const session=scopedStudentSessions.find((candidate)=>candidate.courseId===entry.courseId); return <article class="profile-record"><div><strong>{course?.name}</strong><p>{entry.status === "active" ? "Active enrollment" : "Historical enrollment"}</p><small>{session ? `${sessionLabel(session)} · ${coachById(session.coachId)?.name || "Coach unassigned"}` : "No scheduled session in this context"}</small></div><div class="record-links"><a href={href("courses",course?.id.replace("demo-course-", ""))}>Course</a>{session && <a href={href("scheduling",`session/${session.id.replace("demo-session-","")}`)}>Schedule</a>}</div></article>})}<p class="record-boundary">Completed courses: none supported by this context.</p></section>
      <section class="panel"><h2>Current learning</h2>{scopedStudentEvent ? <><dl class="profile-facts"><div><dt>Current focus</dt><dd>{scopedStudentEvent.challenge}</dd></div><div><dt>Progress</dt><dd>{scopedStudentEvent.progression.label}</dd></div><div><dt>What comes next</dt><dd>{scopedStudentEvent.next}</dd></div></dl><blockquote>{scopedStudentEvent.observation}</blockquote><p class="record-boundary">This Coach observation is Center-visible. Student and Family visibility still depends on Center publication.</p></> : <p>No learning event is recorded for this learner in {title}.</p>}</section>
      <section class="panel"><h2>Center stewardship</h2><dl class="profile-facts"><div><dt>Attendance</dt><dd>{d.attendance.find((entry)=>entry.studentId===selectedStudent.id)?.status || "No attendance record"}</dd></div><div><dt>Center-authored note</dt><dd data-student-note>{selectedStudent.centerNote}</dd></div><div><dt>Communication</dt><dd>{scopedStudentFamily ? "Authorized Coach and Family relationships are available" : "Coach relationship only"}</dd></div></dl><div class="record-links"><a href={href("communication","compose")}>Open scoped communication</a>{scopedStudentEvent && <a href={href("reports",selectedStudent.id.includes("eli-") ? "eli" : "sofia")}>Open report</a>}</div></section>
      <details class="panel manage-panel"><summary>Manage Student operating relationship</summary><form class="relationship-form" data-student-edit={selectedStudent.id}><label>Operating status<select name="status"><option value="active" selected={selectedStudent.operatingStatus === "active"}>Active</option><option value="waitlist" selected={selectedStudent.operatingStatus === "waitlist"}>Waitlist</option></select></label><label class="span-all">Center-authored note<textarea name="note" rows="4">{selectedStudent.centerNote}</textarea></label><button type="submit">Save Student relationship</button><p class="span-all" role="status" data-student-edit-status></p></form></details>
    </div> : <section class="empty-state"><h2>This learner is outside the selected context</h2><p>{selectedStudent.name} has no enrollment in {title}. No course, Family, schedule, progress, or communication records are disclosed here.</p><a href={href("students")}>Return to the scoped roster →</a></section>}
  </>}

  {section === "families" && !item && <><header class="page-heading"><p class="eyebrow">Authorized relationships</p><h1>Families</h1><p>Operational contacts and learner authorization remain scoped to the selected Center context.</p></header>{contextFamilies.length ? <section class="people-grid people-grid-operational">{contextFamilies.map((family) => { const learners = family.studentIds.map(studentById).filter(Boolean); return <a href={href("families",family.id.split("-").pop())} data-family-card={family.id}><img {...studentImage(learners[0]?.id)} /><div class="person-card-copy"><div class="person-card-title"><h2>{family.name}</h2><span class={`status-chip ${family.accountStatus === "active" ? "ready" : "clarification"}`} data-family-roster-status>{family.accountStatus.replace("_"," ")}</span></div><p><span data-family-roster-primary>{family.primaryContact.name}</span> · {family.primaryContact.relationship}</p><dl class="compact-facts"><div><dt>Preferred</dt><dd data-family-roster-preference>{family.communicationPreference}</dd></div><div><dt>Learners</dt><dd>{learners.map(learner=>learner.name).join(" · ")}</dd></div><div><dt>Billing contact</dt><dd data-family-roster-billing>{family.billingResponsibleContact}</dd></div></dl></div></a>})}</section> : <section class="empty-state"><h2>No Family relationships in this context</h2><p>No contact record is exposed without an authorized learner relationship in {title}.</p></section>}</>}
