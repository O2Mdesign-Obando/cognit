---
const roles = [
  { id: "center", label: "Center", labelEs: "Centro" },
  { id: "coach", label: "Coach", labelEs: "Instructor" },
  { id: "student", label: "Student", labelEs: "Estudiante" },
  { id: "family", label: "Family", labelEs: "Familia" },
  { id: "hq", label: "HQ", labelEs: "Sede central" }
];
---

<section class="demo-choices" aria-labelledby="demo-choices-title" data-pl-landing data-i18n-preserve>
  <header class="demo-choices__intro">
    <span class="eyebrow" data-en="Learning Hub demo" data-es="Demostración del Centro de Aprendizaje">Learning Hub demo</span>
    <h1 id="demo-choices-title" data-en="Two ways to explore Cognit Learning" data-es="Dos formas de explorar Cognit Learning">Two ways to explore Cognit Learning</h1>
  </header>

  <div class="demo-choices__grid">
    <article class="demo-choice demo-choice--roles" aria-labelledby="role-choice-title">
      <div>
        <span class="demo-choice__kicker" data-en="Full workspaces" data-es="Espacios de trabajo completos">Full workspaces</span>
        <h2 id="role-choice-title" data-en="Explore Learning Hub by role" data-es="Explora el Centro de Aprendizaje por rol">Explore Learning Hub by role</h2>
        <p data-en="Explore the everyday experience of running a center, coaching, learning, and following a child’s progress." data-es="Explora la experiencia cotidiana de dirigir un centro, enseñar, aprender y acompañar el progreso de un niño.">Explore the everyday experience of running a center, coaching, learning, and following a child’s progress.</p>
      </div>
      <nav class="demo-choice__roles" aria-label="Learning Hub workspaces" data-en-aria="Learning Hub workspaces" data-es-aria="Espacios de trabajo del Centro de Aprendizaje">
        {roles.map((role) => <a href={`/learninghub/demo/${role.id}`} data-en={`${role.label} →`} data-es={`${role.labelEs} →`}>{role.label} →</a>)}
      </nav>
    </article>

    <article class="demo-choice demo-choice--robert" aria-labelledby="robert-choice-title">
      <div>
        <span class="demo-choice__kicker" data-en="Guided fictional story" data-es="Historia ficticia guiada">Guided fictional story</span>
        <h2 id="robert-choice-title" data-en="See personalized learning in action" data-es="Mira el aprendizaje personalizado en acción">See personalized learning in action</h2>
        <p data-en="Follow Robert from assessment through a tailored lesson to an approved Family report, with supported English and Spanish preferences preserved throughout." data-es="Sigue a Robert desde la evaluación y una lección adaptada hasta un informe familiar aprobado, con las preferencias admitidas de inglés y español conservadas durante todo el recorrido.">Follow Robert from assessment through a tailored lesson to an approved Family report, with supported English and Spanish preferences preserved throughout.</p>
      </div>
      <a class="demo-choice__primary" href="/learninghub/demo/personalized-learning?moment=1&from=hq" data-en="Follow Robert’s story →" data-es="Seguir la historia de Robert →">Follow Robert’s story →</a>
    </article>
  </div>

  <p class="demo-choices__disclosure" data-en="Prepared fictional curriculum, students, evidence, and reports. English and Spanish are supported in this browser-local demo." data-es="Currículo, estudiantes, evidencia e informes ficticios preparados. Esta demostración local en el navegador admite inglés y español.">Prepared fictional curriculum, students, evidence, and reports. English and Spanish are supported in this browser-local demo.</p>
</section>

<script>
  const applyLandingLocale = () => {
    const spanish = document.documentElement.lang.toLowerCase().startsWith("es");
    document.querySelectorAll("[data-pl-landing]").forEach((root) => {
      root.querySelectorAll("[data-en][data-es]").forEach((node) => {
        node.textContent = node.getAttribute(spanish ? "data-es" : "data-en") || node.textContent;
      });
      root.querySelectorAll("[data-en-aria][data-es-aria]").forEach((node) => {
        node.setAttribute("aria-label", node.getAttribute(spanish ? "data-es-aria" : "data-en-aria") || "");
      });
    });
  };
  applyLandingLocale();
  document.addEventListener("cognit:language-changed", applyLandingLocale);
</script>

<style>
  .demo-choices__intro{margin-bottom:clamp(24px,4vw,38px)}
  .demo-choices__intro h1{max-width:900px;margin:14px 0 0}
  .demo-choices__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch;gap:clamp(18px,2.5vw,28px)}
  .demo-choice{display:flex;min-width:0;flex-direction:column;justify-content:space-between;gap:28px;padding:clamp(24px,3vw,36px);border:1px solid #cbd8e1;border-radius:22px;box-shadow:var(--shadow-soft)}
  .demo-choice--roles{background:linear-gradient(145deg,#fff 35%,#edf6f8)}
  .demo-choice--robert{background:linear-gradient(145deg,#fff8e7 20%,#fff 76%)}
  .demo-choice__kicker{color:#536b7d;font-size:.76rem;font-weight:950;letter-spacing:.055em;text-transform:uppercase}
  .demo-choice h2{margin:.6rem 0 .8rem;font-size:clamp(1.65rem,2.8vw,2.45rem);line-height:1.08}
  .demo-choice p{max-width:38rem;margin:0;font-size:1.05rem;line-height:1.6}
  .demo-choice__roles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .demo-choice__roles a,.demo-choice__primary{display:flex;min-height:50px;align-items:center;justify-content:center;padding:11px 16px;border:1px solid #0b4167;border-radius:999px;color:#0b4167;font-weight:900;text-align:center}
  .demo-choice__roles a:last-child{grid-column:1/-1}
  .demo-choice__primary{width:100%;border-color:#0b4167;background:#0b4167;color:#fff}
  .demo-choice :is(a):focus-visible{outline:3px solid #f6ac2c;outline-offset:3px}
  .demo-choices__disclosure{max-width:880px;margin:20px 0 0;color:#526779;font-size:.9rem;line-height:1.5}
  @media(max-width:820px){.demo-choices__grid{grid-template-columns:1fr}.demo-choice{gap:22px}}
  @media(max-width:460px){.demo-choice{padding:22px;border-radius:18px}.demo-choice__roles{grid-template-columns:1fr}.demo-choice__roles a:last-child{grid-column:auto}}
</style>
