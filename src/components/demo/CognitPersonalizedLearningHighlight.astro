---
const loops = [
  { role: "HQ", roleEs: "Sede central", title: "Start with one shared curriculum.", titleEs: "Comienza con un currículo compartido.", body: "Common objectives stay consistent across storyboard, narration, interactive, and written presentations.", bodyEs: "Los objetivos comunes se mantienen en presentaciones ilustradas, narradas, interactivas y escritas.", action: "See where the journey starts", actionEs: "Ver dónde comienza el recorrido", moment: 1, from: "hq" },
  { role: "Center", roleEs: "Centro", title: "Understand each student.", titleEs: "Comprende a cada estudiante.", body: "Assessment combines current knowledge, preferences, interests, support needs, and prepared prior evidence.", bodyEs: "La evaluación combina conocimientos actuales, preferencias, intereses, necesidades de apoyo y evidencia previa preparada.", action: "Explore Robert’s assessment", actionEs: "Explorar la evaluación de Robert", moment: 2, from: "center" },
  { role: "Coach", roleEs: "Instructor", title: "Choose appropriate support.", titleEs: "Elige el apoyo adecuado.", body: "Marcus reviews the assessment, recommendation, evidence, and rationale before retaining the teaching decision.", bodyEs: "Marcus revisa la evaluación, la recomendación, la evidencia y el motivo antes de guardar la decisión de enseñanza.", action: "Review Robert’s learning plan", actionEs: "Revisar el plan de aprendizaje de Robert", moment: 3, from: "coach" },
  { role: "Student", roleEs: "Estudiante", title: "Learn, practice, and use useful help.", titleEs: "Aprende, practica y usa ayuda útil.", body: "A short explanation leads to one meaningful task, with supported and independent evidence kept distinct.", bodyEs: "Una explicación breve conduce a una tarea significativa, separando la evidencia con apoyo de la independiente.", action: "Try your learning activity", actionEs: "Probar tu actividad de aprendizaje", moment: 4, from: "student" },
  { role: "Family", roleEs: "Familia", title: "See progress and what comes next.", titleEs: "Consulta el progreso y lo que sigue.", body: "The reviewed report connects objectives, achievements, support, and next steps, with a fictional browser-local response.", bodyEs: "El informe revisado conecta objetivos, logros, apoyo y próximos pasos, con una respuesta ficticia guardada en este navegador.", action: "View Robert’s progress", actionEs: "Ver el progreso de Robert", moment: 6, from: "family" }
];
---

<section class="pl-highlight" aria-labelledby="pl-highlight-title" data-pl-discovery data-i18n-preserve>
  <div class="pl-highlight__lead">
    <span class="eyebrow" data-en="Personalized learning · Guided synthetic demo" data-es="Aprendizaje personalizado · Demostración sintética guiada">Personalized learning · Guided synthetic demo</span>
    <h2 id="pl-highlight-title" data-en="See personalized learning in action." data-es="Mira el aprendizaje personalizado en acción.">See personalized learning in action.</h2>
    <p data-en="Follow one connected story: understand Robert, choose an approach, learn with the right support, and review specific progress with his family." data-es="Sigue una historia conectada: comprende a Robert, elige un enfoque, aprende con el apoyo adecuado y revisa su progreso específico con su familia.">Follow one connected story: understand Robert, choose an approach, learn with the right support, and review specific progress with his family.</p>
    <a class="pl-highlight__primary" href="/learninghub/demo/personalized-learning?moment=1&from=hq" data-en="Follow the full six-moment journey →" data-es="Seguir el recorrido completo de seis momentos →">Follow the full six-moment journey →</a>
    <small data-en="Prepared fictional curriculum, students, evidence, and reports. Browser-local only." data-es="Currículo, estudiantes, evidencia e informes ficticios preparados. Solo en este navegador.">Prepared fictional curriculum, students, evidence, and reports. Browser-local only.</small>
  </div>
  <ol class="pl-highlight__loops" aria-label="Personalized learning entry points" data-en-aria="Personalized learning entry points" data-es-aria="Entradas al aprendizaje personalizado">
    {loops.map((loop) => <li>
      <span data-en={loop.role} data-es={loop.roleEs}>{loop.role}</span>
      <h3 data-en={loop.title} data-es={loop.titleEs}>{loop.title}</h3>
      <p data-en={loop.body} data-es={loop.bodyEs}>{loop.body}</p>
      <a href={`/learninghub/demo/personalized-learning?moment=${loop.moment}&from=${loop.from}&entry=prepared`} data-en={`${loop.action} →`} data-es={`${loop.actionEs} →`}>{loop.action} →</a>
    </li>)}
  </ol>
</section>

<script>
  const applyPersonalizedDiscoveryLocale = () => {
    const spanish = document.documentElement.lang.toLowerCase().startsWith("es");
    document.querySelectorAll("[data-pl-discovery]").forEach((root) => {
      root.querySelectorAll("[data-en][data-es]").forEach((node) => { node.textContent = node.getAttribute(spanish ? "data-es" : "data-en") || node.textContent; });
      root.querySelectorAll("[data-en-aria][data-es-aria]").forEach((node) => { node.setAttribute("aria-label", node.getAttribute(spanish ? "data-es-aria" : "data-en-aria") || ""); });
    });
  };
  applyPersonalizedDiscoveryLocale();
  document.addEventListener("cognit:language-changed", applyPersonalizedDiscoveryLocale);
</script>

<style>
  .pl-highlight{display:grid;grid-template-columns:minmax(280px,.78fr) minmax(0,1.22fr);gap:clamp(24px,4vw,48px);margin:36px 0 54px;padding:clamp(24px,4vw,42px);border:1px solid #cbd8e1;border-radius:24px;background:linear-gradient(135deg,#fff6dd 0%,#fff 48%,#e8f4f7 100%);box-shadow:var(--shadow-soft)}
  .pl-highlight__lead{display:flex;flex-direction:column;align-items:flex-start}.pl-highlight__lead h2{margin:.55rem 0 1rem;font-size:clamp(2rem,4vw,3.35rem)}.pl-highlight__lead p{font-size:1.08rem;line-height:1.65}.pl-highlight__lead small{margin-top:13px;color:#53697a;line-height:1.5}.pl-highlight__primary{display:inline-flex;min-height:50px;align-items:center;margin-top:12px;padding:12px 19px;border-radius:999px;background:#0b4167;color:#fff;font-weight:900;text-align:center}
  .pl-highlight__loops{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0;padding:0;list-style:none}.pl-highlight__loops li{display:flex;min-width:0;flex-direction:column;padding:18px;border:1px solid #d0dce4;border-radius:15px;background:#fff}.pl-highlight__loops li:first-child{grid-column:1/-1}.pl-highlight__loops span{color:#567083;font-size:.72rem;font-weight:950;letter-spacing:.05em;text-transform:uppercase}.pl-highlight__loops h3{margin:.45rem 0;font-size:1.17rem}.pl-highlight__loops p{margin:0 0 12px;line-height:1.48}.pl-highlight__loops a{margin-top:auto;color:#0b4167;font-weight:900;text-decoration:underline;text-underline-offset:4px}
  .pl-highlight :is(a):focus-visible{outline:3px solid #f6ac2c;outline-offset:3px}@media(max-width:820px){.pl-highlight{grid-template-columns:1fr}.pl-highlight__loops li:first-child{grid-column:auto}}@media(max-width:560px){.pl-highlight{padding:20px;border-radius:18px}.pl-highlight__loops{grid-template-columns:1fr}.pl-highlight__primary{width:100%;justify-content:center}}
</style>
