---
const { section, item = "", contextKey, title, href } = Astro.props;
const isHarbor = contextKey === "harbor";
const migrationCounts = isHarbor
  ? { Students: 18, Families: 14, Coaches: 3, Courses: 4, Enrollments: 22, Schedules: 12 }
  : { Students: 42, Families: 31, Coaches: 6, Courses: 8, Enrollments: 55, Schedules: 28 };
const migrationSteps = [["", "Welcome"], ["source", "Source"], ["select", "Choose data"], ["map", "Match fields"], ["preview", "Check data"], ["processing", "Processing"], ["ready", "Ready"]];
const migrationNext = item === "source" ? "select" : item === "select" ? "map" : item === "map" ? "preview" : item === "preview" ? "processing" : item === "processing" ? "ready" : "source";
const activeTicket = isHarbor
  ? { id: "HBR-2041", title: "Announcement audience review", status: "Waiting for Center", priority: "Normal", created: "Sep 1, 2026", area: "Communication", latest: "Please confirm which Harbor program Families should receive the announcement.", history: ["Support requested the intended audience.", "Harbor submitted the original question."] }
  : { id: "NFS-1837", title: "Recurring room conflict", status: "In review", priority: "Time-sensitive", created: "Aug 31, 2026", area: "Scheduling", latest: "Support is reviewing the recurring Robotics Arena pattern.", history: ["Support confirmed the schedule details.", "Northfield shared the affected recurrence and room."] };
const releases = [
  { id: "module-review", state: "action", label: "Action required", title: "Review optional module choices", date: "Sep 2, 2026", scope: "Center · Configuration", summary: "Confirm which optional capabilities this Center wants enabled.", detail: "Required modules remain managed by HQ. Review only the optional capabilities available to your Center.", action: "Open Configuration" },
  { id: "report-review", state: "no-action", label: "No action needed", title: "Report review is easier to scan", date: "Aug 28, 2026", scope: "Center · Reports", summary: "Publication and clarification states now use clearer language.", detail: "The existing review responsibility is unchanged. Status and next action are now easier to distinguish.", action: "Got it" },
  { id: "mobile-schedule", state: "issue", label: "Known issue", title: "Very narrow schedule drawer", date: "Aug 25, 2026", scope: "Center · Scheduling", summary: "At 320px wide, a schedule drawer can overlap its close control.", detail: "No schedule data is lost. Rotate the device or use a wider browser until the visual correction is released.", action: "Dismiss" },
  { id: "attendance-counts", state: "resolved", label: "Resolved", title: "Attendance totals refresh correctly", date: "Aug 20, 2026", scope: "Center · Attendance", summary: "Session totals now update immediately after attendance confirmation.", detail: "The earlier display delay is resolved. No Center action is needed.", action: "Got it" }
];
const selectedRelease = releases.find((release) => release.id === item.replace("detail/", "")) || releases[0];
---

{section === "migration" && <section class="closeout-shell migration-shell" data-closeout-migration data-context={contextKey}>
  <header class="page-heading"><p class="eyebrow">Bring It Forward · {title}</p><h1>{item === "processing" ? "Bringing your data forward" : item === "ready" ? "Ready" : "Bring It Forward"}</h1><p>Review operating data, decide what belongs in Cognit, and understand every change before anything is created.</p></header>
  <ol class="closeout-steps" aria-label="Bring It Forward progress">{migrationSteps.map(([id, label], index) => <li class={item === id || (!item && !id) ? "active" : ""}><a href={id ? href("migration", id) : href("migration")} aria-current={item === id || (!item && !id) ? "step" : undefined}><span>{index + 1}</span>{label}</a></li>)}</ol>
  {!item && <section class="closeout-hero panel"><div><p class="eyebrow">A reviewed transition</p><h2>Bring the operating records you choose</h2><p>Students, Families, Coaches, Courses, enrollments, and schedules can be reviewed as one understandable sequence.</p></div><div class="closeout-summary"><strong>7 guided steps</strong><span>Source → choose → match → check → process → ready</span><a class="button-link" href={href("migration", "source")}>Start Bring It Forward →</a></div></section>}
  {item === "source" && <section class="panel"><div class="section-heading"><div><p class="eyebrow">Step 2</p><h2>Choose a source</h2></div></div><p>Choose how the Center wants to begin.</p><div class="source-choice-grid">{[["CSV", "Review a spreadsheet export"], ["Start Fresh", "Begin without bringing existing records"], ["iClassPro", "Bring records from iClassPro"], ["Codio", "Bring records from Codio"]].map(([name, copy]) => <button type="button" data-migration-source={name}><strong>{name}</strong><span>{copy}</span></button>)}</div><p role="status" data-migration-status>Choose a source to continue.</p><a class="button-link" href={href("migration", migrationNext)}>Continue to choose data →</a></section>}
  {item === "select" && <section class="panel"><div class="section-heading"><div><p class="eyebrow">Step 3</p><h2>Choose what to bring</h2></div><span>Record counts for {title}</span></div><form class="category-form" data-migration-categories>{Object.entries(migrationCounts).map(([name, count], index) => <label><input type="checkbox" name={name.toLowerCase()} checked={index < 6} /><span><strong>{name}</strong><small>{count} records</small>{["Enrollments", "Schedules"].includes(name) && <em>Requires Students and Courses</em>}</span></label>)}<label><input type="checkbox" name="history" /><span><strong>Historical attendance and progress</strong><small>{isHarbor ? 38 : 126} optional records</small><em>Can be brought forward later</em></span></label><div class="closeout-actions"><button type="button" class="action-secondary" data-migration-save>Save selection</button><a class="button-link" href={href("migration", migrationNext)}>Review field matches →</a></div><p role="status" data-migration-status></p></form></section>}
  {item === "map" && <section class="panel"><div class="section-heading"><div><p class="eyebrow">Step 4</p><h2>Review field matches</h2></div><span>8 fields reviewed</span></div><div class="mapping-table" role="table" aria-label="Field matches"><div class="mapping-row mapping-head" role="row"><strong>Source field</strong><strong>Cognit field</strong><strong>Match</strong></div>{[["student_name", "Student name", "Auto-matched"], ["family_email", "Family email", "Auto-matched"], ["course_title", "Course", "Auto-matched"], ["level", "Learning level", "Needs review"], ["legacy_note", "Do not bring forward", "Ignored"]].map(([source, destination, status]) => <div class="mapping-row" role="row"><code>{source}</code><span>{destination}</span><strong class={`match-${status.toLowerCase().replace(" ", "-")}`}>{status}</strong></div>)}</div><aside class="closeout-warning"><strong>One decision needed</strong><span>Confirm how the source “level” value should appear in Cognit. The legacy note will be intentionally skipped.</span></aside><a class="button-link" href={href("migration", migrationNext)}>Check your data →</a></section>}
  {item === "preview" && <section class="panel"><div class="section-heading"><div><p class="eyebrow">Step 5</p><h2>Check your data</h2></div><span class="status-chip clarification">2 warnings</span></div><div class="preview-metrics"><article><span>Will be created</span><strong>{Object.values(migrationCounts).reduce((a, b) => a + b, 0)}</strong></article><article><span>Will be updated</span><strong>3</strong></article><article><span>Will be skipped</span><strong>2</strong></article><article><span>Possible duplicates</span><strong>1</strong></article></div><div class="integrity-grid"><article><h3>Ready</h3><p>Required Student, Course, enrollment, and schedule relationships are present.</p></article><article><h3>Review before continuing</h3><p>One Family email resembles an existing record. One learning level needs confirmation.</p></article></div><a class="button-link" href={href("migration", migrationNext)}>Start processing →</a></section>}
  {item === "processing" && <section class="panel processing-card"><div class="section-heading"><div><p class="eyebrow">Step 6</p><h2>Bringing your data forward</h2></div><strong data-processing-percent>68%</strong></div><progress max="100" value="68" data-processing-progress>68%</progress><div class="processing-list"><span><strong>Students and Families</strong><small>Complete</small></span><span><strong>Coaches and Courses</strong><small>Complete</small></span><span><strong>Enrollments</strong><small data-processing-current>37 of {migrationCounts.Enrollments}</small></span><span><strong>Schedules</strong><small data-processing-schedules>Waiting</small></span></div><aside class="closeout-warning"><strong>Follow-up retained</strong><span>The possible duplicate is preserved as a warning for Center review; it is not silently merged.</span></aside><button type="button" data-processing-complete>Complete processing</button><a class="button-link" href={href("migration", "ready")} data-processing-ready hidden>View Ready receipt →</a><p role="status" data-migration-status aria-live="polite"></p></section>}
  {item === "ready" && <section class="panel ready-receipt"><div class="ready-mark" aria-hidden="true">✓</div><p class="eyebrow">Bring It Forward receipt</p><h2>Records are ready for Center review</h2><p>Review the completed records and any remaining follow-up.</p><div class="receipt-grid">{Object.entries(migrationCounts).map(([name, count]) => <article><span>{name}</span><strong>{count}</strong><small>Ready for review</small></article>)}</div><aside class="closeout-warning"><strong>1 follow-up warning</strong><span>Review the possible duplicate Family before continuing.</span></aside><div class="closeout-actions"><a href={href("students")}>Review Students →</a><a href={href("courses")}>Review Courses →</a><a href={href("scheduling")}>Review Scheduling →</a></div></section>}
</section>}

{section === "support" && <section class="closeout-shell support-shell" data-closeout-support data-context={contextKey}>
  <header class="page-heading"><p class="eyebrow">Center Support · {title}</p><h1>Get help and follow the issue</h1><p>Find a focused answer, prepare a request, and see what happens next without leaving the Center workflow.</p></header>
  <nav class="closeout-jump" aria-label="Support sections"><a href="#new-request">New request</a><a href="#active-requests">Active requests</a><a href="#system-status">System status</a><a href="#help-topics">Help topics</a></nav>
  <section class="panel" id="new-request"><div class="section-heading"><div><p class="eyebrow">New support request</p><h2>Tell us what is happening</h2></div><span>Context: {title}</span></div><form class="support-request-form" data-support-request><label>Subject<input name="subject" required placeholder="Short summary of the issue" /></label><label>Product area<select name="category"><option>Students & Families</option><option>Scheduling</option><option>Attendance & Make-Ups</option><option>Billing</option><option>Courses</option><option>Communication</option></select></label><label>Priority<select name="priority"><option>Normal</option><option>Time-sensitive</option><option>Blocking today’s operation</option></select></label><label>Attachment note<input name="attachment" placeholder="Optional filename or screenshot note" /></label><label class="span-all">Description<textarea name="description" required rows="5" placeholder="What happened, what you expected, and what you already tried"></textarea></label><div class="closeout-actions span-all"><button type="button" class="action-secondary" data-support-draft>Save draft</button><button type="submit">Submit request</button></div><p class="span-all" role="status" data-support-status aria-live="polite"></p></form><article class="support-receipt" data-support-receipt hidden tabindex="-1"><span class="status-chip ready">Open</span><h3>Request prepared</h3><dl><div><dt>Reference</dt><dd data-ticket-reference>—</dd></div><div><dt>Submitted</dt><dd>Sep 3, 2026 · 12:15 PM</dd></div><div><dt>Category / priority</dt><dd data-ticket-summary>—</dd></div><div><dt>Next</dt><dd>Review the request in Active requests.</dd></div></dl></article></section>
  <section class="panel" id="active-requests"><div class="section-heading"><div><p class="eyebrow">Active requests</p><h2>{activeTicket.title}</h2></div><span class="status-chip clarification">{activeTicket.status}</span></div><dl class="ticket-facts"><div><dt>Reference</dt><dd>{activeTicket.id}</dd></div><div><dt>Priority</dt><dd>{activeTicket.priority}</dd></div><div><dt>Created</dt><dd>{activeTicket.created}</dd></div><div><dt>Product area</dt><dd>{activeTicket.area}</dd></div></dl><p class="ticket-latest"><strong>Latest update</strong>{activeTicket.latest}</p><details><summary>View message history</summary><ol class="ticket-history">{activeTicket.history.map((entry, index) => <li><strong>{index === 0 ? "Latest" : "Earlier"}</strong><span>{entry}</span></li>)}</ol><p><strong>Attachment:</strong> schedule-example.png · 184 KB</p></details><div data-local-support-tickets></div></section>
  <section class="panel" id="system-status"><div class="section-heading"><div><p class="eyebrow">Service availability</p><h2>System status</h2></div><span>Updated 12 minutes ago</span></div><div class="support-status-grid"><article><strong>Core Center workflows</strong><span class="status-chip ready">Operational</span><p>Classes, Attendance, and Reports are available.</p></article><article><strong>Mobile schedule drawer</strong><span class="status-chip clarification">Known issue</span><p>Visual overlap can occur at 320px; no data is lost.</p></article><article><strong>Notification delivery</strong><span class="status-chip neutral">Maintenance scheduled</span><p>Maintenance is scheduled for Sep 8.</p></article></div></section>
  <section class="panel" id="help-topics"><div class="section-heading"><div><p class="eyebrow">FAQs and help topics</p><h2>Find a focused answer</h2></div><label class="support-search">Search<input type="search" placeholder="Search help topics" data-support-search /></label></div><div class="faq-list">{[["Reports", "How do I review a Coach report?", "Open Reports, choose a report marked Needs attention or Ready for publication, review the Coach observation and evidence, then either publish it or send it back for clarification."], ["Attendance & Make-Ups", "How do I confirm attendance?", "Open Today → Attendance & Make-Ups, choose the class, and confirm each Student as Present, Late, or Absent. Qualifying reported absences are checked against Center policy automatically."], ["Communication", "How do I contact a Family?", "Open Communication and choose the Family conversation, or use Message Family / Prepare Family message from a Student, Attendance, or Billing record. Student and Course context carry into the draft automatically."], ["Attendance & Make-Ups", "What happens after a cancellation?", "When a class is cancelled, Cognit identifies the enrolled Students and automatically adds Make-Up Tokens when Center policy qualifies them. Review the result under Today → Attendance & Make-Ups."]].map(([category, question, answer]) => <details data-help-topic={`${category} ${question}`.toLowerCase()}><summary><span>{category}</span>{question}</summary><p>{answer}</p></details>)}</div><p data-support-empty hidden>No help topics match that search.</p></section>
</section>}

{section === "whats-new" && <section class="closeout-shell release-shell" data-closeout-releases>
  <header class="page-heading"><p class="eyebrow">What’s New</p><h1>{item === "archive" ? "Update archive" : "Understand what changed"}</h1><p>See what matters to Center operations, whether action is needed, and what has already been resolved.</p></header>
  {item !== "archive" && <><div class="release-state-grid">{releases.map((release) => <article class={`release-update state-${release.state}`} data-release-card={release.state}><div><span class="release-state">{release.label}</span><small>{release.date} · {release.scope}</small></div><h2>{release.title}</h2><p>{release.summary}</p><button type="button" data-release-open={release.id} data-release-label={release.label} data-release-date={release.date} data-release-scope={release.scope} data-release-title={release.title} data-release-detail={release.detail} data-release-action={release.action}>Read more</button></article>)}</div><a class="button-link" href={href("whats-new", "archive")}>View update archive →</a></>}
  {item === "archive" && <section class="panel"><div class="section-heading"><div><p class="eyebrow">Older and current updates</p><h2>Update archive</h2></div><label>Show<select data-release-filter><option value="all">All updates</option><option value="action">Action required</option><option value="no-action">No action needed</option><option value="issue">Known issues</option><option value="resolved">Resolved</option><option value="no-results">Security updates</option></select></label></div><div class="release-archive">{releases.map((release) => <article data-release-kind={release.state}><span class="release-state">{release.label}</span><div><h3>{release.title}</h3><p>{release.date} · {release.scope}</p></div><button type="button" data-release-open={release.id} data-release-label={release.label} data-release-date={release.date} data-release-scope={release.scope} data-release-title={release.title} data-release-detail={release.detail} data-release-action={release.action}>Read more</button></article>)}</div><section class="empty-state" data-release-empty hidden><h2>No matching updates</h2><p>Choose another filter to review Center product changes.</p></section></section>}
  <dialog class="release-dialog" data-release-dialog data-release-id={selectedRelease.id} aria-labelledby="release-dialog-title"><form method="dialog"><button class="dialog-close" aria-label="Close update" value="close">×</button></form><span class="release-state" data-release-dialog-state>{selectedRelease.label}</span><p class="eyebrow" data-release-dialog-scope>{selectedRelease.date} · {selectedRelease.scope}</p><h2 id="release-dialog-title" data-release-dialog-title>{selectedRelease.title}</h2><p data-release-dialog-summary>{selectedRelease.detail}</p><div class="release-detail-facts"><article><strong>Who it matters to</strong><span data-release-dialog-role>{selectedRelease.scope}</span></article><article><strong>Center action</strong><span data-release-dialog-action>{selectedRelease.label === "Action required" ? "Review the available choice" : "No action needed"}</span></article></div><form method="dialog"><button value="done" data-release-dismiss>{selectedRelease.action}</button></form></dialog>
</section>}

<style>
  .closeout-shell{display:grid;gap:24px;min-width:0}.closeout-shell :is(h2,h3){color:var(--ink)}.closeout-steps{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;margin:0;padding:0;list-style:none}.closeout-steps a{display:grid;justify-items:center;gap:6px;padding:10px 6px;border:1px solid var(--color-border);border-radius:10px;background:#fff;color:var(--ink);font-size:.72rem;font-weight:900;text-align:center}.closeout-steps span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#e9f3fa}.closeout-steps .active a{background:var(--ink);color:#fff}.closeout-steps .active span{background:#fff;color:var(--ink)}.closeout-hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:24px}.closeout-summary{display:grid;align-content:center;gap:8px;padding:18px;border-radius:12px;background:#eef8fb}.closeout-summary strong{font-size:1.35rem}.source-choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:18px 0}.source-choice-grid button{display:grid;gap:6px;padding:18px;border:1px solid var(--color-border);border-radius:12px;background:#fff;color:var(--ink);text-align:left;font:inherit}.source-choice-grid button:hover,.source-choice-grid button:focus-visible,.source-choice-grid button[aria-pressed=true]{border-color:var(--teal);background:#eefaf9;outline:3px solid #bce9e6}.source-choice-grid span{color:#607087}.category-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.category-form>label{display:flex;gap:12px;padding:15px;border:1px solid var(--color-border);border-radius:10px}.category-form input{width:20px;height:20px;accent-color:var(--ink)}.category-form label span{display:grid;gap:4px}.category-form small,.category-form em{color:#607087;font-size:.78rem}.mapping-table{display:grid;margin:18px 0;border:1px solid var(--color-border);border-radius:12px;overflow:hidden}.mapping-row{display:grid;grid-template-columns:1fr 1fr 150px;gap:16px;padding:14px;border-top:1px solid var(--color-border)}.mapping-head{border-top:0;background:#f2f5f8}.mapping-row strong:last-child{font-size:.8rem}.match-needs-review{color:#875700}.match-ignored{color:#596878}.closeout-warning{display:flex;gap:12px;margin:16px 0;padding:15px;border-left:4px solid var(--gold);background:#fff8e9}.preview-metrics,.receipt-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0}.preview-metrics article,.receipt-grid article{display:grid;gap:6px;padding:16px;border:1px solid var(--color-border);border-radius:10px}.preview-metrics strong,.receipt-grid strong{font-size:1.65rem}.integrity-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.processing-card{display:grid;gap:18px}.processing-card progress{width:100%;height:16px;accent-color:var(--teal)}.processing-list{display:grid;gap:8px}.processing-list>span{display:flex;justify-content:space-between;padding:12px;border-radius:8px;background:#f3f6f8}.ready-receipt{text-align:center}.ready-mark{display:grid;place-items:center;width:58px;height:58px;margin:auto;border-radius:50%;background:#dff7ee;color:#08785f;font-size:2rem}.receipt-grid{grid-template-columns:repeat(3,minmax(0,1fr));text-align:left}.closeout-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.closeout-actions :is(a,button),.processing-card>button,.release-update>button,.release-archive button,.release-dialog button{padding:11px 16px;border:0;border-radius:9px;background:var(--ink);color:#fff;font:inherit;font-weight:900}.closeout-actions a{color:var(--ink);background:#e9f3fa}.closeout-actions .action-secondary{border:1px solid var(--ink);background:#fff;color:var(--ink)}.presentation-boundary{display:flex;gap:8px;padding:15px;border-left:4px solid var(--gold);border-radius:8px;background:#fff9eb;color:#536579}.closeout-jump{display:flex;flex-wrap:wrap;gap:8px}.closeout-jump a{padding:10px 13px;border:1px solid var(--color-border);border-radius:999px;background:#fff;color:var(--ink);font-weight:900}.support-request-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.support-request-form label,.support-search{display:grid;gap:6px;color:#647286;font-size:.72rem;font-weight:900;text-transform:uppercase}.support-request-form :is(input,select,textarea),.support-search input,.section-heading select{box-sizing:border-box;width:100%;min-height:44px;padding:10px;border:1px solid var(--color-border);border-radius:8px;background:#fff;font:inherit;text-transform:none}.support-receipt{margin-top:18px;padding:18px;border:1px solid #8ed5c8;border-radius:12px;background:#effaf7}.support-receipt dl,.ticket-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.support-receipt dl div,.ticket-facts div{display:grid;gap:5px}.support-receipt dt,.ticket-facts dt{font-size:.7rem;font-weight:900;text-transform:uppercase}.support-receipt dd,.ticket-facts dd{margin:0}.ticket-latest{display:grid;gap:5px;padding:15px;background:#eef7fb}.ticket-history{display:grid;gap:10px}.ticket-history li{display:grid;gap:4px}.support-status-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.support-status-grid article{padding:16px;border:1px solid var(--color-border);border-radius:10px}.support-status-grid p{color:#607087}.faq-list{display:grid;gap:8px}.faq-list details{padding:14px;border:1px solid var(--color-border);border-radius:9px}.faq-list summary{display:flex;gap:10px;color:var(--ink);font-weight:900;cursor:pointer}.faq-list summary span{color:#597083;font-size:.72rem;text-transform:uppercase}.release-state-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.release-update{display:grid;gap:12px;padding:20px;border:1px solid var(--color-border);border-top:4px solid #8292a2;border-radius:12px;background:#fff}.release-update.state-action{border-top-color:var(--gold)}.release-update.state-issue{border-top-color:#d64d4d}.release-update.state-resolved{border-top-color:var(--teal)}.release-update>div{display:flex;justify-content:space-between;gap:12px}.release-state{font-size:.72rem;font-weight:950;text-transform:uppercase}.release-update small{color:#607087}.release-archive{display:grid}.release-archive article{display:grid;grid-template-columns:140px minmax(0,1fr) auto;align-items:center;gap:14px;padding:15px 0;border-top:1px solid var(--color-border)}.release-archive article:first-child{border-top:0}.release-archive h3,.release-archive p{margin:0}.release-dialog{width:min(620px,calc(100% - 32px));padding:26px;border:0;border-radius:16px;box-shadow:0 25px 70px #0929414d}.release-dialog::backdrop{background:#0b2f4c99}.dialog-close{float:right!important;padding:5px 11px!important;border-radius:50%!important;background:#eef2f5!important;color:var(--ink)!important;font-size:1.4rem!important}.release-detail-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:18px 0}.release-detail-facts article{display:grid;gap:5px;padding:14px;border-radius:9px;background:#f2f6f8}
  @media(max-width:900px){.closeout-steps{grid-template-columns:repeat(4,minmax(0,1fr))}.closeout-hero,.support-status-grid{grid-template-columns:1fr}.preview-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:680px){.closeout-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.source-choice-grid,.category-form,.integrity-grid,.support-request-form,.release-state-grid,.receipt-grid,.support-receipt dl,.ticket-facts,.release-detail-facts{grid-template-columns:1fr}.mapping-row{grid-template-columns:1fr;gap:5px}.mapping-head{display:none}.closeout-warning,.presentation-boundary,.release-update>div{align-items:flex-start;flex-direction:column}.closeout-actions{align-items:stretch;flex-direction:column}.closeout-actions :is(a,button){width:100%;box-sizing:border-box;text-align:center}.release-archive article{grid-template-columns:1fr}.release-dialog{margin:auto 16px 16px;align-self:end;border-radius:16px 16px 0 0}.preview-metrics{grid-template-columns:1fr 1fr}}
</style>
