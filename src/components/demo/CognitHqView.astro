---
import { COGNIT_HQ_DEMO } from "../../demo/cognit-hq-data.js";

const { view = "home" } = Astro.props;
const d = COGNIT_HQ_DEMO;
const nav = [
  ["home", "Home", "/learninghub/demo/hq"], ["network", "Network", "/learninghub/demo/hq/network"], ["centers", "Centers", "/learninghub/demo/hq/centers"],
  ["curriculum", "Curriculum", "/learninghub/demo/hq/curriculum"], ["insights", "Insights", "/learninghub/demo/hq/insights"], ["performance", "Performance", "/learninghub/demo/hq/performance"],
  ["governance", "Governance", "/learninghub/demo/hq/governance"], ["support", "Support", "/learninghub/demo/hq/support"], ["deployment", "Deployment", "/learninghub/demo/hq/deployment"]
];
const activeCenters = d.centers.filter((c) => c.status === "Active");
const totalLearners = d.centers.reduce((n, c) => n + c.learners, 0);
const totalCoaches = d.centers.reduce((n, c) => n + c.coaches, 0);
const attentionCenters = d.centers.filter((c) => c.readiness.toLowerCase().includes("attention") || c.readiness.toLowerCase().includes("decision"));
const escalatedIssues = d.support.filter((issue) => issue.status === "Escalated");
const awaitingCenterIssues = d.support.filter((issue) => issue.status === "Awaiting Center");
const adoptionPercent = (value) => {
  const [adopted = 0, total = 1] = value.match(/\d+/g)?.map(Number) || [];
  return Math.round((adopted / total) * 100);
};
const titleMap = {
  home: ["Network stewardship", "What needs attention across the network?"],
  network: ["Network overview", "Understand network health"],
  centers: ["Center management", "Manage lifecycle and readiness"],
  curriculum: ["Curriculum management", "Distribute templates without taking over local delivery"],
  insights: ["Operational insights", "What is happening across the network?"],
  performance: ["Network performance", "How are Centers trending over time?"],
  governance: ["Governance", "Standards and internal operating configuration"],
  support: ["Support escalation", "Steward Center-impacting issues"],
  deployment: ["Deployment readiness", "Versions, rollout stages, and Center readiness"],
  modules: ["Module governance", "Set module availability across the network"],
  allocation: ["Capability allocation", "Configure modules for one Center"]
};
const [eyebrow, heading] = titleMap[view] || titleMap.home;
const descriptionMap = {
  home: "Review by exception, then leave healthy operations quiet.",
  network: "See current capacity, platform health, and recent activity across the network.",
  centers: "Search Centers, review readiness, and follow each lifecycle stage.",
  curriculum: "Track templates, Center adoption, Learning Journeys, and the latest curriculum push.",
  insights: "Use network totals and operating signals to understand where attention is needed.",
  performance: "Compare Center health, readiness, adoption, and change over time.",
  governance: "Review active standards, program settings, Center status, and recent changes.",
  support: "Follow Center-impacting issues from escalation through resolution.",
  deployment: "Review the current version, planned releases, rollout progress, and Center readiness.",
  modules: "Choose which modules are required, available, or unavailable across the network.",
  allocation: "Apply the permitted module choices for Riverton Learning Studio."
};
---

<div class="hq-shell" data-hq-view={view}>
  <div class="hq-local-topline">
    <div><strong>Cognit HQ</strong><span>Network operations</span></div>
    <details class="hq-profile"><summary aria-label="HQ profile menu"><span class="avatar">AC</span><span>{d.meta.steward}<small>{d.meta.role}</small></span></summary><nav><a href="/learninghub/demo/hq/support">Support</a><a href="/learninghub/demo/hq/governance">Settings</a><button type="button" data-hq-logout>Log out</button></nav></details>
  </div>
  <nav class="hq-nav" aria-label="HQ sections">
    {nav.map(([id, label, href]) => <a href={href} aria-current={view === id ? "page" : undefined}>{label}</a>)}
    <a href="/learninghub/demo/hq/modules" aria-current={view === "modules" || view === "allocation" ? "page" : undefined}>Module governance</a>
  </nav>

  <header class="hq-hero" data-hq-hero={view}>
    <p class="eyebrow">{eyebrow}</p><h1>{heading}</h1>
    <p>{descriptionMap[view] || descriptionMap.home}</p>
  </header>

  {view === "home" && <>
    <section class="metric-grid five hq-kpis" aria-label="Network overview">
      <article><span>Active Centers</span><strong>{activeCenters.length}</strong><small>of {d.centers.length} Centers</small></article>
      <article><span>Active learners</span><strong>{totalLearners}</strong><small>Across the network</small></article>
      <article><span>Active Coaches</span><strong>{totalCoaches}</strong><small>Across current Centers</small></article>
      <article><span>Programs running</span><strong>11</strong><small>Current programs</small></article>
      <article class="metric-attention"><span>Needs attention</span><strong>{attentionCenters.length}</strong><small>Center decisions</small></article>
    </section>
    <div class="split-grid home-status-grid">
      <section class="panel platform-health"><div class="panel-heading"><h2>Platform health</h2><span class="status active">System operational</span></div><div class="health-summary"><span aria-hidden="true">✓</span><div><strong>All current services are available</strong><small>Last updated 12 minutes ago</small></div></div></section>
      <section class="panel"><h2>Attention &amp; activity</h2><ul class="activity activity-compact"><li>Riverton adopted Creative App Foundations 2.4</li><li>Cedar Grove advanced to Coach training</li><li>{escalatedIssues.length} Center-impacting support issue needs an owner</li></ul></section>
    </div>
    <section class="attention-stack" aria-label="Network attention queue">{d.attention.map((item) => <article><span>{item.type}</span><div><h2>{item.title}</h2><p>{item.detail}</p></div><a href={item.href}>Review →</a></article>)}</section>
    <section class="healthy-banner"><span aria-hidden="true">✓</span><strong>All clear:</strong><p>Platform health · internal standards · deployment protection</p></section>
  </>}

  {view === "network" && <>
    <section class="metric-grid five" aria-label="Network metrics">
      <article><span>Active Centers</span><strong>{activeCenters.length}</strong></article><article><span>Active learners</span><strong>{totalLearners}</strong></article><article><span>Active Coaches</span><strong>{totalCoaches}</strong></article><article><span>Programs running</span><strong>11</strong></article><article><span>Needs attention</span><strong>{attentionCenters.length}</strong></article>
    </section>
    <div class="split-grid network-status-grid"><section class="panel platform-health"><div class="panel-heading"><h2>Platform health</h2><span class="status active">System operational</span></div><div class="health-summary"><span aria-hidden="true">✓</span><div><strong>All current services are available</strong><small>Last updated 12 minutes ago</small></div></div></section><section class="panel"><h2>Recent network activity</h2><ul class="activity"><li>Riverton adopted Creative App Foundations 2.4</li><li>Oak Harbor completed its internal standards review</li><li>Cedar Grove advanced to Coach training</li><li>Bluewater entered a lifecycle decision state</li></ul></section></div>
  </>}

  {view === "centers" && <>
    <section class="filter-bar" data-hq-center-filters><label><span>Search Centers</span><input type="search" placeholder="Search name or city" data-hq-center-search /></label><label><span>Status</span><select aria-label="Center status" data-hq-center-status><option value="All">All</option><option value="Active">Active</option><option value="Onboarding">Onboarding</option><option value="Inactive">Inactive</option></select></label><button type="button" data-hq-add-center>Add new Center</button></section>
    <p class="demo-feedback" data-hq-center-feedback role="status" aria-live="polite"></p>
    <section class="table-card"><table><caption>Six Centers and network-management metadata</caption><thead><tr><th>Center</th><th>Status</th><th>Learners</th><th>Coaches</th><th>Last sync</th><th>Action</th></tr></thead><tbody>{d.centers.map((c) => <tr data-center-row data-name={`${c.name} ${c.city}`.toLowerCase()} data-status={c.status}><td><strong>{c.name}</strong><small>{c.city}</small></td><td><span class={`status ${c.status.toLowerCase()}`}>{c.status}</span></td><td>{c.learners}</td><td>{c.coaches}</td><td>{c.sync}</td><td><a href={`/learninghub/demo/hq/allocation?center=${c.id}`}>Manage</a></td></tr>)}</tbody></table></section>
    <section class="panel lifecycle"><h2>Center lifecycle</h2><p>Every Center moves through the same readiness stages.</p><ol>{["Application","Onboarding","Configuration","Training","Activation","Active"].map((stage, index) => <li><span aria-hidden="true">{index + 1}</span>{stage}</li>)}</ol></section>
  </>}

  {view === "curriculum" && <>
    <section class="card-grid four curriculum-cards">{d.curriculum.map((item) => <article><div class="card-top"><span>{item.category}</span><b class={`status ${item.status.toLowerCase()}`}>{item.status}</b></div><h2>{item.name}</h2><p class="version-label">Version {item.version}</p><div class="adoption"><span>Adoption</span><strong>{item.adoption}</strong></div><div class="adoption-bar" aria-hidden="true"><i style={`width:${adoptionPercent(item.adoption)}%`}></i></div></article>)}</section>
    <div class="split-grid curriculum-lower"><section class="panel"><h2>Learning Journey templates</h2>{d.journeyTemplates.map((item) => <div class="list-row"><div><strong>{item.name}</strong><small>{item.duration} · {item.centers} Centers</small></div><span class={`status ${item.status.toLowerCase()}`}>{item.status}</span></div>)}</section><section class="panel curriculum-push"><p class="eyebrow">Current distribution</p><h2>Latest curriculum push</h2><strong>Creative App Foundations 2.4</strong><div class="push-summary"><div><span>Adopted</span><strong>4 Centers</strong></div><div><span>Needs local review</span><strong>2 Centers</strong></div></div><p class="muted">Review is required before rollout.</p></section></div>
  </>}

  {view === "insights" && <>
    <section class="metric-grid four hq-kpis"><article><span>Total enrollment</span><strong>{totalLearners}</strong><small class="trend-chip positive">↗ +8% trend</small></article><article><span>Average attendance</span><strong>88%</strong><small class="trend-chip neutral">Network average</small></article><article><span>Coach activity</span><strong>{totalCoaches}</strong><small class="trend-chip neutral">Active Coaches</small></article><article><span>Journey completion</span><strong>74%</strong><small class="trend-chip positive">↗ +3 points</small></article></section>
    <div class="split-grid insights-grid"><section class="panel enrollment-panel"><div class="panel-heading"><h2>Enrollment by Center</h2><span>Top 5 Centers</span></div>{d.centers.slice(0,5).map((c) => <div class="bar-row"><span>{c.name}</span><div><i style={`width:${Math.max(8,c.learners)}%`}></i></div><strong>{c.learners}</strong></div>)}</section><div class="stack"><section class="panel"><h2>Family engagement</h2><div class="list-row"><span>Published stories viewed</span><strong>86%</strong></div><div class="list-row"><span>Monthly portal visits</span><strong>3.1</strong></div></section><section class="panel"><h2>Evidence capture</h2><div class="list-row"><span>Observations this month</span><strong>318</strong></div><div class="list-row"><span>Photos/videos attached</span><strong>742</strong></div></section><section class="panel operational-issues"><div class="panel-heading"><h2>Operational issues</h2>{escalatedIssues.length > 0 && <span class="status review">Action required</span>}</div><div class="list-row"><span>Open support tickets</span><strong>{d.support.length}</strong></div><div class="list-row"><span>Average resolution time</span><strong>1.6 days</strong></div><div class="list-row"><span>Oldest open issue</span><strong>2 days</strong></div><a href="/learninghub/demo/hq/support">Review support →</a></section></div></div>
  </>}

  {view === "performance" && <>
    <section class="metric-grid four hq-kpis"><article><span>Operational health</span><strong>91/100</strong><small class="trend-chip neutral">Network score</small></article><article><span>Enrollment growth</span><strong>+8%</strong><small class="trend-chip positive">↗ Current period</small></article><article><span>Retention</span><strong>90%</strong><small class="trend-chip neutral">Current rate</small></article><article><span>Average Center health</span><strong>89/100</strong><small class="trend-chip neutral">Across {d.centers.length} Centers</small></article></section>
    <div class="split-grid wide-left performance-grid"><section class="table-card"><table><caption>Center comparison</caption><thead><tr><th>Center</th><th>Adoption</th><th>Readiness</th><th>Health</th></tr></thead><tbody>{d.centers.map((c, i) => <tr><td><strong>{c.name}</strong></td><td>{c.adoption}%</td><td><span class={`status ${c.readiness.toLowerCase().includes("ready") ? "active" : "review"}`}>{c.readiness}</span></td><td><strong>{94-i*4}/100</strong></td></tr>)}</tbody></table></section><section class="panel attention-panel"><h2>Needs attention</h2>{attentionCenters.map((c) => <div class="notice"><strong>{c.name}</strong><span class="status review">{c.readiness}</span><p>A network operations decision is required.</p></div>)}</section></div>
    <figure class="panel trend-chart"><figcaption><h2>Six-month operational trend</h2><p>Health rises from 76 in March to 91 in August.</p></figcaption><svg viewBox="0 0 720 220" aria-hidden="true" focusable="false"><g class="chart-grid"><line x1="40" y1="170" x2="680" y2="170"/><line x1="40" y1="115" x2="680" y2="115"/><line x1="40" y1="60" x2="680" y2="60"/></g><path class="chart-area" d="M40 165 L168 143 L296 120 L424 92 L552 72 L680 42 L680 170 L40 170 Z"/><polyline points="40,165 168,143 296,120 424,92 552,72 680,42"/><g class="chart-points"><circle cx="40" cy="165" r="6"/><circle cx="168" cy="143" r="6"/><circle cx="296" cy="120" r="6"/><circle cx="424" cy="92" r="6"/><circle cx="552" cy="72" r="6"/><circle cx="680" cy="42" r="6"/></g><g class="chart-labels"><text x="40" y="202">Mar · 76</text><text x="168" y="202">Apr · 80</text><text x="296" y="202">May · 83</text><text x="424" y="202">Jun · 86</text><text x="552" y="202">Jul · 88</text><text x="680" y="202">Aug · 91</text></g></svg></figure>
  </>}

  {view === "governance" && <>
    <div class="split-grid wide-left governance-grid"><section class="panel"><h2>Internal network standards</h2>{d.policies.map((p) => <div class="list-row policy-row"><div><strong>{p.name}</strong><small>Version {p.version}</small></div><span class={`status ${p.status === "Active" ? "active" : "review"}`}>{p.status}</span></div>)}</section><section class="panel"><h2>Program configuration</h2><div class="list-row"><span>Coach-to-learner planning ratio</span><strong>1:8</strong></div><div class="list-row"><span>Observation planning target</span><strong>2/month</strong></div><div class="list-row"><span>Family story cadence</span><strong>Monthly</strong></div><div class="list-row"><span>Journey review cycle</span><strong>Quarterly</strong></div></section></div>
    <div class="split-grid governance-lower"><section class="panel"><h2>Center standards review</h2>{d.centers.slice(0,5).map((c,i) => <div class="list-row"><span>{c.name}</span><strong>{96-i*3}%</strong></div>)}</section><section class="panel"><h2>Audit history</h2><ul class="activity"><li>Data handling standard marked active</li><li>Center readiness reviewed</li><li>Module configuration initialized</li></ul></section></div>
  </>}

  {view === "support" && <>
    <section class="metric-grid four hq-kpis"><article><span>Open issues</span><strong>{d.support.length}</strong><small>Needs review</small></article><article class="metric-attention"><span>Escalated</span><strong>{escalatedIssues.length}</strong><small>Requires action</small></article><article><span>Average response</span><strong>3.8h</strong><small>Current support average</small></article><article><span>Average resolution</span><strong>1.6d</strong><small>Current support average</small></article></section>
    <div class="split-grid support-top"><section><h2 class="section-title">Needs immediate attention</h2><div class="support-list immediate-list">{escalatedIssues.map((issue) => <article><div><span>{issue.id} · {issue.center}</span><h2>{issue.summary}</h2><p>{issue.status} · {issue.age} · Assigned to {issue.owner}</p></div><span class="status urgent">{issue.priority} priority</span><button type="button" data-take-case={issue.id}>Take case</button></article>)}</div></section><section class="panel resolution-panel"><h2>Resolution tracking</h2><div class="list-row"><span>Assigned issues</span><strong>{d.support.length}</strong></div><div class="list-row"><span>Escalated</span><strong>{escalatedIssues.length}</strong></div><div class="list-row"><span>Awaiting Center</span><strong>{awaitingCenterIssues.length}</strong></div></section></div>
    <section class="table-card support-table"><table><caption>Open issues</caption><thead><tr><th>Ticket</th><th>Center</th><th>Priority</th><th>Status</th><th>Age</th><th>Assigned to</th><th>Action</th></tr></thead><tbody>{d.support.map((issue) => <tr><td><strong>{issue.id}</strong></td><td>{issue.center}</td><td><span class={`status priority-${issue.priority.toLowerCase()}`}>{issue.priority}</span></td><td><span class={`status ${issue.status === "Escalated" ? "urgent" : issue.status === "In progress" ? "active" : "review"}`}>{issue.status}</span></td><td>{issue.age}</td><td>{issue.owner}</td><td><button type="button" data-take-case={issue.id}>Take case</button></td></tr>)}</tbody></table></section><p class="demo-feedback" data-hq-case-feedback role="status" aria-live="polite"></p>
  </>}

  {view === "deployment" && <>
    <section class="metric-grid three hq-kpis deployment-summary"><article><span>Platform version</span><strong>2.4</strong><small class="status active">Stable</small></article><article><span>Release date</span><strong>Aug 2026</strong><small>Current release</small></article><article><span>Centers on latest</span><strong>4 / 6</strong><small>Current version</small></article></section>
    <div class="split-grid wide-left deployment-grid"><section class="panel"><h2>Upcoming releases</h2>{d.releases.map((r) => <div class="release-row"><div><strong>{r.version} · {r.name}</strong><small>{r.target}</small></div><span class={`status ${r.stage === "In development" ? "review" : "neutral"}`}>{r.stage}</span></div>)}</section><section class="panel"><h2>Feature rollout</h2><div class="rollout"><strong>Family journey refinements</strong><span class="status active">Active</span><i style="width:100%"></i></div><div class="rollout"><strong>AI-assisted observation editing</strong><span class="status review">Beta</span><i style="width:35%"></i></div><div class="rollout"><strong>Mobile Coach capture</strong><span class="status neutral">Alpha</span><i style="width:12%"></i></div></section></div>
    <section class="table-card readiness-table"><table><caption>Center readiness for the current release</caption><thead><tr><th>Center</th><th>Version</th><th>Configuration</th><th>Last sync</th></tr></thead><tbody>{d.centers.map((c) => <tr><td><strong>{c.name}</strong></td><td>{c.version}</td><td><span class={`status ${c.readiness === "Ready" ? "active" : "review"}`}>{c.readiness}</span></td><td>{c.sync}</td></tr>)}</tbody></table></section>
  </>}

  {(view === "modules" || view === "allocation") && <section class="module-workspace" data-hq-modules data-mode={view}>
    {view === "allocation" && <a class="back-inline" href="/learninghub/demo/hq/centers">← Back to Center Management</a>}
    <form data-module-form>
      {d.modules.map((m) => <fieldset data-module={m.id} data-envelope={m.state}><legend>{m.name}<small>{m.detail}</small></legend><div class="segments">
        {["required","available","unavailable"].map((state) => {
          const centerDisabled = view === "allocation" && ((m.state === "required" && state !== "required") || (m.state === "unavailable" && state !== "unavailable"));
          const selected = view === "allocation" ? (m.state === "available" ? state === "available" : state === m.state) : state === m.state;
          return <label class={centerDisabled ? "is-locked" : ""}><input type="radio" name={`${view}-${m.id}`} value={state} checked={selected} disabled={centerDisabled} /><span>{state[0].toUpperCase()+state.slice(1)}</span></label>;
        })}
      </div></fieldset>)}
      <div class="module-actions"><p data-module-status role="status" aria-live="polite">Configuration is up to date.</p><button type="button" class="secondary" data-module-reset>Restore defaults</button><button type="reset" class="secondary" data-module-discard>Discard changes</button><button type="submit">Save configuration</button></div>
    </form>
    <section class="demo-audit" aria-label="Configuration history"><h2>Configuration history</h2><ul data-module-audit><li>Module availability set.</li></ul></section>
  </section>}
</div>

<script src="/src/demo/cognit-hq-interaction.js"></script>

<style>
  .hq-shell{--hq:#123f63;--gold:#f7ad2b;--teal:#18aaa5;display:grid;gap:28px;color:#27364a}.hq-local-topline{display:flex;align-items:center;justify-content:space-between;gap:20px}.hq-local-topline>div{display:grid}.hq-local-topline strong{color:var(--hq);font-size:1.35rem}.hq-local-topline span{color:#617085;font-size:.78rem}.hq-profile{position:relative}.hq-profile summary{display:flex;align-items:center;gap:9px;cursor:pointer;list-style:none}.hq-profile summary>span:not(.avatar){display:grid;color:var(--hq);font-weight:900}.hq-profile small{display:block;color:#617085;font-size:.68rem}.avatar{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--hq);color:#fff!important;font-weight:950}.hq-profile nav{position:absolute;right:0;z-index:5;display:grid;min-width:190px;margin-top:8px;padding:8px;border:1px solid var(--color-border);border-radius:10px;background:white;box-shadow:var(--shadow-soft)}.hq-profile a,.hq-profile button{padding:10px;border:0;background:transparent;color:var(--hq);text-align:left;font:inherit}.hq-profile button{color:#c33}.hq-nav{display:flex;gap:4px;overflow-x:auto;padding:7px;border:1px solid var(--color-border);border-radius:12px;background:#fff}.hq-nav a{flex:0 0 auto;padding:9px 11px;border-radius:8px;color:var(--hq);font-size:.8rem;font-weight:900}.hq-nav a[aria-current=page]{background:var(--hq);color:#fff}.hq-hero{width:100%;max-width:none}.hq-hero h1{max-width:18ch;margin:8px 0 10px;color:var(--hq);font-size:clamp(2.5rem,4.6vw,4.5rem);line-height:.98}.hq-hero>p:last-child{max-width:72ch;margin:0;line-height:1.6}.attention-stack,.support-list{display:grid;gap:12px}.attention-stack article,.support-list article{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:18px;padding:20px 22px;border:1px solid var(--color-border);border-left:4px solid var(--gold);border-radius:12px;background:#fff;box-shadow:var(--shadow-soft)}.attention-stack article>span,.card-top>span{color:#8b5b00;font-size:.7rem;font-weight:950;text-transform:uppercase}.attention-stack h2,.support-list h2{margin:0 0 4px;color:var(--hq);font-size:1.08rem}.attention-stack p,.support-list p{margin:0}.attention-stack a{color:var(--hq);font-weight:950}.healthy-banner{display:flex;align-items:center;gap:12px;padding:18px 20px;border:1px solid #8edbd7;border-radius:12px;background:#ebfbfa}.healthy-banner>span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--teal);color:white}.healthy-banner p{margin:0}.metric-grid,.card-grid{display:grid;gap:14px}.metric-grid.five{grid-template-columns:repeat(5,1fr)}.metric-grid.four,.card-grid.four{grid-template-columns:repeat(4,1fr)}.metric-grid.three{grid-template-columns:repeat(3,1fr)}.metric-grid article,.card-grid article,.panel,.table-card,.filter-bar,.module-workspace form,.demo-audit{padding:22px;border:1px solid var(--color-border);border-radius:16px;background:#fff;box-shadow:var(--shadow-soft)}.metric-grid article{display:grid;align-content:start;gap:8px;min-width:0}.metric-grid strong{color:var(--hq);font-size:2.2rem}.metric-grid span,.metric-grid small{color:#617085;font-size:.76rem;font-weight:850}.metric-grid .metric-attention{border-top:4px solid var(--gold)}.split-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.wide-left{grid-template-columns:minmax(0,1.55fr) minmax(280px,.75fr)}.stack{display:grid;gap:18px}.panel h2{margin:0 0 18px;color:var(--hq);font-size:1.35rem}.panel-heading{display:flex;align-items:center;justify-content:space-between;gap:14px}.panel-heading>span:not(.status){color:#617085;font-size:.72rem;font-weight:900;text-transform:uppercase}.health-summary{display:flex;align-items:center;gap:14px;padding:18px;border-radius:12px;background:#eaf9f8}.health-summary>span{display:grid;flex:0 0 auto;width:34px;height:34px;place-items:center;border-radius:50%;background:var(--teal);color:#fff;font-weight:950}.health-summary>div{display:grid;gap:3px}.hea