---
import { COGNIT_HQ_DEMO } from "../../demo/cognit-hq-data.js";

const { view = "home" } = Astro.props;
const d = COGNIT_HQ_DEMO;
const nav = [
  ["home", "Home", "/learninghub/demo/hq"], ["network", "Network", "/learninghub/demo/hq/network"], ["centers", "Centers", "/learninghub/demo/hq/centers"],
  ["curriculum", "Curriculum", "/learninghub/demo/hq/curriculum"], ["insights", "Insights", "/learninghub/demo/hq/insights"], ["performance", "Performance", "/learninghub/demo/hq/performance"],
  ["governance", "Governance", "/learninghub/demo/hq/governance"], ["support", "Support", "/learninghub/demo/hq/support"], ["deployment", "Deployment", "/learninghub/demo/hq/deployment"]
];
const activeCenters = d.centers.filter((c) => c.status === "Active");
const totalLearners = d.centers.reduce((n, c) => n + c.learners, 0);
const totalCoaches = d.centers.reduce((n, c) => n + c.coaches, 0);
const attentionCenters = d.centers.filter((c) => c.readiness.toLowerCase().includes("attention") || c.readiness.toLowerCase().includes("decision"));
const titleMap = {
  home: ["Network stewardship", "What needs attention across the network?"],
  network: ["Network overview", "A bounded view of network health"],
  centers: ["Center management", "Manage lifecycle and readiness"],
  curriculum: ["Curriculum management", "Distribute templates without taking over local delivery"],
  insights: ["Operational insights", "What is happening across the network?"],
  performance: ["Network performance", "How are Centers trending over time?"],
  governance: ["Governance", "Standards and internal operating configuration"],
  support: ["Support escalation", "Steward Center-impacting issues"],
  deployment: ["Deployment readiness", "Versions, rollout stages, and Center readiness"],
  modules: ["Module governance", "Define the allowed configuration envelope"],
  allocation: ["Capability allocation", "Configure one Center inside the HQ envelope"]
};
const [eyebrow, heading] = titleMap[view] || titleMap.home;
---

<div class="hq-shell" data-hq-view={view}>
  <div class="hq-local-topline">
    <div><strong>Cognit HQ</strong><span>Synthetic network demo</span></div>
    <details class="hq-profile"><summary aria-label="HQ profile menu"><span class="avatar">AC</span><span>{d.meta.steward}<small>{d.meta.role}</small></span></summary><nav><a href="/learninghub/demo/hq/support">Support</a><a href="/learninghub/demo/hq/governance">Settings</a><button type="button" data-hq-logout>Log out</button></nav></details>
  </div>
  <nav class="hq-nav" aria-label="HQ demo sections">
    {nav.map(([id, label, href]) => <a href={href} aria-current={view === id ? "page" : undefined}>{label}</a>)}
    <a href="/learninghub/demo/hq/modules" aria-current={view === "modules" || view === "allocation" ? "page" : undefined}>Module governance</a>
  </nav>

  <header class="hq-hero">
    <p class="eyebrow">{eyebrow}</p><h1>{heading}</h1>
    <p>{view === "home" ? "Review by exception, then leave healthy operations quiet." : "Illustrative Cognit demo data only—no live tenant, learner, Family, or Coach records are queried."}</p>
  </header>

  {view === "home" && <>
    <section class="attention-stack" aria-label="Network attention queue">{d.attention.map((item) => <article><span>{item.type}</span><div><h2>{item.title}</h2><p>{item.detail}</p></div><a href={item.href}>Review →</a></article>)}</section>
    <section class="healthy-banner"><span aria-hidden="true">✓</span><strong>All clear:</strong><p>Demo platform health · internal standards · deployment protection</p></section>
  </>}

  {view === "network" && <>
    <section class="metric-grid five" aria-label="Synthetic network metrics">
      <article><span>Active Centers</span><strong>{activeCenters.length}</strong></article><article><span>Active learners</span><strong>{totalLearners}</strong></article><article><span>Active Coaches</span><strong>{totalCoaches}</strong></article><article><span>Programs running</span><strong>11</strong></article><article><span>Needs attention</span><strong>{attentionCenters.length}</strong></article>
    </section>
    <div class="split-grid"><section class="panel"><h2>Demo platform health</h2><div class="health-state"><strong>System operational</strong><span>Fixture sync: 12 minutes ago</span></div><p>All displayed status values come from the bounded HQ fixture, not production telemetry.</p></section><section class="panel"><h2>Recent network activity</h2><ul class="activity"><li>Riverton adopted Creative App Foundations Demo 2.4</li><li>Oak Harbor completed its internal standards review</li><li>Cedar Grove advanced to Coach training</li><li>Bluewater entered a lifecycle decision state</li></ul></section></div>
  </>}

  {view === "centers" && <>
    <section class="filter-bar" data-hq-center-filters><label><span>Search Centers</span><input type="search" placeholder="Search name or city" data-hq-center-search /></label><label><span>Status</span><select aria-label="Center status" data-hq-center-status><option value="All">All</option><option value="Active">Active</option><option value="Onboarding">Onboarding</option><option value="Inactive">Inactive</option></select></label><button type="button" data-hq-add-center>Add new Center</button></section>
    <p class="demo-feedback" data-hq-center-feedback role="status" aria-live="polite"></p>
    <section class="table-card"><table><caption>Six synthetic Centers and network-management metadata only</caption><thead><tr><th>Center</th><th>Status</th><th>Learners</th><th>Coaches</th><th>Last sync</th><th>Action</th></tr></thead><tbody>{d.centers.map((c) => <tr data-center-row data-name={`${c.name} ${c.city}`.toLowerCase()} data-status={c.status}><td><strong>{c.name}</strong><small>{c.city}</small></td><td><span class={`status ${c.status.toLowerCase()}`}>{c.status}</span></td><td>{c.learners}</td><td>{c.coaches}</td><td>{c.sync}</td><td><a href={`/learninghub/demo/hq/allocation?center=${c.id}`}>Manage</a></td></tr>)}</tbody></table></section>
    <section class="panel lifecycle"><h2>Synthetic Cognit network lifecycle</h2><ol>{["Application","Onboarding","Configuration","Training","Activation","Active"].map((stage) => <li>{stage}</li>)}</ol></section>
  </>}

  {view === "curriculum" && <>
    <section class="boundary-note"><strong>HQ template governance</strong><span>HQ distributes templates and standards. Each Center retains its permitted delivery configuration.</span></section>
    <section class="card-grid four">{d.curriculum.map((item) => <article><div class="card-top"><span>{item.category}</span><b>{item.status}</b></div><h2>{item.name}</h2><p>{item.version}</p><div class="adoption"><span>Adoption</span><strong>{item.adoption}</strong></div></article>)}</section>
    <div class="split-grid"><section class="panel"><h2>Learning Journey templates</h2>{d.journeyTemplates.map((item) => <div class="list-row"><div><strong>{item.name}</strong><small>{item.duration} · {item.centers} Centers</small></div><span>{item.status}</span></div>)}</section><section class="panel"><h2>Latest curriculum push</h2><p>Creative App Foundations Demo 2.4</p><strong>4 adopted · 2 need local review</strong><p class="muted">No real deployment action is performed.</p></section></div>
  </>}

  {view === "insights" && <>
    <section class="metric-grid four"><article><span>Total enrollment</span><strong>{totalLearners}</strong><small>+8% synthetic trend</small></article><article><span>Average attendance</span><strong>88%</strong><small>Aggregate fixture</small></article><article><span>Coach activity</span><strong>{totalCoaches}</strong><small>Active in fixture</small></article><article><span>Journey completion</span><strong>74%</strong><small>+3 points</small></article></section>
    <div class="split-grid"><section class="panel"><h2>Enrollment by Center</h2>{d.centers.slice(0,5).map((c) => <div class="bar-row"><span>{c.name}</span><div><i style={`width:${Math.max(8,c.learners)}%`}></i></div><strong>{c.learners}</strong></div>)}</section><div class="stack"><section class="panel"><h2>Family engagement</h2><div class="list-row"><span>Published stories viewed</span><strong>86%</strong></div><div class="list-row"><span>Monthly portal visits</span><strong>3.1</strong></div></section><section class="panel"><h2>Evidence capture</h2><div class="list-row"><span>Observations this month</span><strong>318</strong></div><div class="list-row"><span>Photos/videos attached</span><strong>742</strong></div></section></div></div>
  </>}

  {view === "performance" && <>
    <section class="metric-grid four"><article><span>Operational health</span><strong>91/100</strong></article><article><span>Enrollment growth</span><strong>+8%</strong></article><article><span>Retention</span><strong>90%</strong></article><article><span>Average Center health</span><strong>89/100</strong></article></section>
    <div class="split-grid wide-left"><section class="table-card"><table><caption>Center comparison using synthetic operating indicators</caption><thead><tr><th>Center</th><th>Adoption</th><th>Readiness</th><th>Health</th></tr></thead><tbody>{d.centers.map((c, i) => <tr><td>{c.name}</td><td>{c.adoption}%</td><td>{c.readiness}</td><td>{94-i*4}/100</td></tr>)}</tbody></table></section><section class="panel"><h2>Needs attention</h2>{attentionCenters.map((c) => <div class="notice"><strong>{c.name}</strong><p>{c.readiness}; network stewardship decision required.</p></div>)}</section></div>
    <section class="panel"><h2>Six-month operational trend</h2><div class="trend" role="img" aria-label="Synthetic health trend rises from 76 in March to 91 in August"><span>Mar 76</span><i></i><span>Apr 80</span><i></i><span>May 83</span><i></i><span>Jun 86</span><i></i><span>Jul 88</span><i></i><span>Aug 91</span></div></section>
  </>}

  {view === "governance" && <>
    <div class="split-grid wide-left"><section class="panel"><h2>Internal network standards</h2>{d.policies.map((p) => <div class="list-row"><div><strong>{p.name}</strong><small>{p.version}</small></div><span>{p.status}</span></div>)}</section><section class="panel"><h2>Synthetic program configuration</h2><div class="list-row"><span>Coach-to-learner planning ratio</span><strong>1:8</strong></div><div class="list-row"><span>Observation planning target</span><strong>2/month</strong></div><div class="list-row"><span>Family story cadence</span><strong>Monthly</strong></div><div class="list-row"><span>Journey review cycle</span><strong>Quarterly</strong></div></section></div>
    <div class="split-grid"><section class="panel"><h2>Center standards review</h2>{d.centers.slice(0,5).map((c,i) => <div class="list-row"><span>{c.name}</span><strong>{96-i*3}% · Internal status</strong></div>)}</section><section class="panel"><h2>Demo audit history</h2><ul class="activity"><li>Data handling standard marked active</li><li>Center readiness fixture reviewed</li><li>Demo module envelope initialized</li></ul><p class="muted">These are local demo events, not signed production audit records.</p></section></div>
  </>}

  {view === "support" && <>
    <section class="metric-grid four"><article><span>Open issues</span><strong>{d.support.length}</strong></article><article><span>Escalated</span><strong>1</strong></article><article><span>Average response</span><strong>3.8h</strong></article><article><span>Average resolution</span><strong>1.6d</strong></article></section>
    <section class="support-list">{d.support.map((issue) => <article><div><span>{issue.id} · {issue.center}</span><h2>{issue.summary}</h2><p>{issue.status} · {issue.age} · Assigned to {issue.owner}</p></div><button type="button" data-take-case={issue.id}>Take case</button></article>)}</section><p class="demo-feedback" data-hq-case-feedback role="status" aria-live="polite"></p>
  </>}

  {view === "deployment" && <>
    <section class="metric-grid three"><article><span>Demo platform version</span><strong>2.4</strong><small>Stable fixture</small></article><article><span>Synthetic release date</span><strong>Aug 2026</strong></article><article><span>Centers on latest</span><strong>4 / 6</strong></article></section>
    <div class="split-grid wide-left"><section class="panel"><h2>Upcoming demo releases</h2>{d.releases.map((r) => <div class="list-row"><div><strong>{r.version} · {r.name}</strong><small>{r.target}</small></div><span>{r.stage}</span></div>)}</section><section class="panel"><h2>Feature rollout</h2><div class="rollout"><strong>Family journey refinements</strong><span>Active fixture</span><i style="width:100%"></i></div><div class="rollout"><strong>AI-assisted observation editing</strong><span>Beta fixture</span><i style="width:35%"></i></div><div class="rollout"><strong>Mobile Coach capture</strong><span>Alpha fixture</span><i style="width:12%"></i></div></section></div>
    <section class="table-card"><table><caption>Center readiness for the synthetic demo release</caption><thead><tr><th>Center</th><th>Version</th><th>Configuration</th><th>Last sync</th></tr></thead><tbody>{d.centers.map((c) => <tr><td>{c.name}</td><td>{c.version}</td><td>{c.readiness}</td><td>{c.sync}</td></tr>)}</tbody></table></section>
  </>}

  {(view === "modules" || view === "allocation") && <section class="module-workspace" data-hq-modules data-mode={view}>
    <div class="boundary-note"><strong>{view === "modules" ? "HQ defines the allowed configuration envelope" : "Center-targeted administrative view"}</strong><span>{view === "modules" ? "Required modules cannot be disabled locally; unavailable modules cannot be enabled locally." : "Configuring Riverton Learning Studio. This does not grant a Center user HQ authority."}</span></div>
    {view === "allocation" && <a class="back-inline" href="/learninghub/demo/hq/centers">← Back to Center Management</a>}
    <form data-module-form>
      {d.modules.map((m) => <fieldset data-module={m.id} data-envelope={m.state}><legend>{m.name}<small>{m.detail}</small></legend><div class="segments">
        {["required","available","unavailable"].map((state) => {
          const centerDisabled = view === "allocation" && ((m.state === "required" && state !== "required") || (m.state === "unavailable" && state !== "unavailable"));
          const selected = view === "allocation" ? (m.state === "available" ? state === "available" : state === m.state) : state === m.state;
          return <label class={centerDisabled ? "is-locked" : ""}><input type="radio" name={`${view}-${m.id}`} value={state} checked={selected} disabled={centerDisabled} /><span>{state[0].toUpperCase()+state.slice(1)}</span></label>;
        })}
      </div></fieldset>)}
      <div class="module-actions"><p data-module-status role="status" aria-live="polite">No unsaved demo changes.</p><button type="button" class="secondary" data-module-reset>Reset</button><button type="reset" class="secondary" data-module-discard>Discard changes</button><button type="submit">Save configuration</button></div>
    </form>
    <section class="demo-audit" aria-label="Demo configuration audit"><h2>Local demo event history</h2><ul data-module-audit><li>Demo module envelope initialized.</li></ul></section>
  </section>}

  <footer class="hq-boundary"><strong>{d.meta.authorizationPrinciple}</strong><span>Network metadata visibility does not imply downstream record access. All interactions on this page are browser-local and resettable.</span></footer>
</div>

<script src="/src/demo/cognit-hq-interaction.js"></script>

<style>
  .hq-shell{--hq:#123f63;--gold:#f7ad2b;--teal:#18aaa5;display:grid;gap:28px;color:#27364a}.hq-local-topline{display:flex;align-items:center;justify-content:space-between;gap:20px}.hq-local-topline>div{display:grid}.hq-local-topline strong{color:var(--hq);font-size:1.35rem}.hq-local-topline span{color:#617085;font-size:.78rem}.hq-profile{position:relative}.hq-profile summary{display:flex;align-items:center;gap:9px;cursor:pointer;list-style:none}.hq-profile summary>span:not(.avatar){display:grid;color:var(--hq);font-weight:900}.hq-profile small{display:block;color:#617085;font-size:.68rem}.avatar{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--hq);color:#fff!important;font-weight:950}.hq-profile nav{position:absolute;right:0;z-index:5;display:grid;min-width:190px;margin-top:8px;padding:8px;border:1px solid var(--color-border);border-radius:10px;background:white;box-shadow:var(--shadow-soft)}.hq-profile a,.hq-profile button{padding:10px;border:0;background:transparent;color:var(--hq);text-align:left;font:inherit}.hq-profile button{color:#c33}.hq-nav{display:flex;gap:4px;overflow-x:auto;padding:7px;border:1px solid var(--color-border);border-radius:12px;background:#fff}.hq-nav a{flex:0 0 auto;padding:9px 11px;border-radius:8px;color:var(--hq);font-size:.8rem;font-weight:900}.hq-nav a[aria-current=page]{background:var(--hq);color:#fff}.hq-hero{max-width:900px}.hq-hero h1{margin:8px 0 10px;color:var(--hq);font-size:clamp(2.5rem,5vw,4.8rem);line-height:.98}.hq-hero>p:last-child{max-width:70ch;margin:0;line-height:1.6}.attention-stack,.support-list{display:grid;gap:12px}.attention-stack article,.support-list article{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:18px;padding:20px 22px;border:1px solid var(--color-border);border-left:4px solid var(--gold);border-radius:10px;background:#fff}.attention-stack article>span,.card-top span{color:#8b5b00;font-size:.7rem;font-weight:950;text-transform:uppercase}.attention-stack h2,.support-list h2{margin:0 0 4px;color:var(--hq);font-size:1.08rem}.attention-stack p,.support-list p{margin:0}.attention-stack a{color:var(--hq);font-weight:950}.healthy-banner,.boundary-note{display:flex;align-items:center;gap:12px;padding:18px 20px;border:1px solid #8edbd7;border-radius:12px;background:#ebfbfa}.healthy-banner>span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--teal);color:white}.healthy-banner p{margin:0}.metric-grid,.card-grid{display:grid;gap:14px}.metric-grid.five{grid-template-columns:repeat(5,1fr)}.metric-grid.four,.card-grid.four{grid-template-columns:repeat(4,1fr)}.metric-grid.three{grid-template-columns:repeat(3,1fr)}.metric-grid article,.card-grid article,.panel,.table-card,.filter-bar,.module-workspace form,.demo-audit{padding:22px;border:1px solid var(--color-border);border-radius:14px;background:#fff;box-shadow:var(--shadow-soft)}.metric-grid article{display:grid;gap:8px}.metric-grid strong{color:var(--hq);font-size:2.2rem}.metric-grid span,.metric-grid small{color:#617085;font-size:.76rem;font-weight:850}.split-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.wide-left{grid-template-columns:minmax(0,1.55fr) minmax(280px,.75fr)}.stack{display:grid;gap:18px}.panel h2{margin:0 0 18px;color:var(--hq);font-size:1.35rem}.health-state{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px;border-radius:10px;background:#eaf9f8}.health-state strong{color:#087c78}.activity{display:grid;gap:12px;margin:0;padding-left:20px}.activity li::marker{color:var(--gold)}.filter-bar{display:flex;align-items:end;gap:14px}.filter-bar label{display:grid;flex:1;gap:5px}.filter-bar label span{font-size:.7rem;font-weight:900;text-transform:uppercase}.filter-bar input,.filter-bar select{min-height:44px;padding:9px 11px;border:1px solid var(--color-border);border-radius:8px;background:white;font:inherit}.filter-bar button,.support-list button,.module-actions button{min-height:44px;padding:9px 16px;border:0;border-radius:999px;background:var(--hq);color:white;font-weight:950}.demo-feedback{min-height:1.2em;margin:0;color:#087c78;font-weight:850}.table-card{padding:0;overflow-x:auto}.table-card table{width:100%;border-collapse:collapse;min-width:680px}.table-card caption{padding:18px 20px;text-align:left;color:#617085;font-size:.78rem}.table-card th,.table-card td{padding:15px 18px;border-top:1px solid var(--color-border);text-align:left}.table-card th{color:#617085;font-size:.7rem;text-transform:uppercase}.table-card td strong,.table-card td small{display:block}.table-card td a{color:var(--hq);font-weight:900}.status{display:inline-flex;padding:4px 8px;border-radius:999px;background:#eef2f7;font-size:.7rem;font-weight:900}.status.active{background:#e4f8f5;color:#087c78}.status.onboarding{background:#fff1d6;color:#8b5b00}.status.inactive{background:#feeaea;color:#a13333}.lifecycle ol{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;list-style:none;padding:0}.lifecycle li{padding:12px 8px;border:1px solid var(--color-border);border-radius:8px;text-align:center;font-size:.78rem;font-weight:850}.card-grid article h2{color:var(--hq);font-size:1.3rem}.card-top{display:flex;justify-content:space-between;gap:8px}.card-top b{color:#087c78;font-size:.7rem;text-transform:uppercase}.adoption{display:flex;justify-content:space-between;gap:12px;padding-top:14px;border-top:1px solid var(--color-border);font-size:.8rem}.list-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 0;border-top:1px solid var(--color-border)}.list-row:first-of-type{border-top:0}.list-row div{display:grid}.list-row small{color:#617085}.list-row>span{color:#617085}.muted{color:#617085;font-size:.82rem}.bar-row{display:grid;grid-template-columns:minmax(150px,1fr) 2fr 40px;align-items:center;gap:12px;margin:15px 0}.bar-row div{height:8px;border-radius:99px;background:#edf1f5}.bar-row i,.rollout i{display:block;height:100%;border-radius:99px;background:var(--gold)}.notice{padding:14px 0;border-top:1px solid var(--color-border)}.notice p{margin:5px 0}.trend{display:flex;align-items:center;gap:8px;overflow-x:auto;color:var(--hq);font-size:.75rem;font-weight:900}.trend i{width:54px;height:3px;background:linear-gradient(90deg,var(--gold),var(--teal));transform:rotate(-8deg)}.support-list article>div>span{color:#617085;font-size:.75rem;font-weight:850}.rollout{display:grid;grid-template-columns:1fr auto;gap:7px;margin:18px 0}.rollout i{grid-column:1/-1;height:7px}.module-workspace{display:grid;gap:18px}.back-inline{color:var(--hq);font-weight:900}.module-workspace form{padding:0;overflow:hidden}.module-workspace fieldset{display:grid;grid-template-columns:minmax(220px,1fr) auto;align-items:center;gap:20px;margin:0;padding:18px 20px;border:0;border-top:1px solid var(--color-border)}.module-workspace fieldset:first-child{border-top:0}.module-workspace legend{display:grid;float:left;width:100%;color:var(--hq);font-weight:950}.module-workspace legend small{margin-top:5px;color:#617085;font-weight:500}.segments{display:flex;padding:4px;border-radius:999px;background:#eef2f5}.segments label{cursor:pointer}.segments input{position:absolute;opacity:0;pointer-events:none}.segments span{display:block;padding:9px 15px;border-radius:999px;color:#59677b;font-size:.75rem;font-weight:850}.segments input:checked+span{background:var(--hq);color:#fff}.segments .is-locked{cursor:not-allowed;opacity:.45}.module-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;padding:18px 20px;border-top:1px solid var(--color-border)}.module-actions p{margin-right:auto}.module-actions .secondary{border:1px solid var(--hq);background:#fff;color:var(--hq)}.demo-audit h2{margin-top:0;color:var(--hq);font-size:1.15rem}.demo-audit ul{margin-bottom:0}.hq-boundary{display:grid;gap:5px;padding:18px 20px;border:1px solid var(--gold);border-radius:12px;background:#fffaf0}.hq-boundary strong{co