---
const { variant = "default", demoPerspective = "" } = Astro.props;
const isDemo = variant === "demo-shell" || variant === "demo-arrival-shell";
const perspectives = ["center", "coach", "student", "family", "hq"];
const names = { center: "Center", coach: "Coach", student: "Student", family: "Family", hq: "HQ" };
const profile = {
  center: ["Marcus R.", "Center"],
  coach: ["Jordan Ellis", "Coach"],
  student: ["Eli Morgan", "Student"],
  family: ["Rachel Morgan", "Morgan Family"],
  hq: ["Avery Chen", "Network operations"]
};
const currentProfile = profile[demoPerspective];
---

<header class:list={["site-header", isDemo && "demo-global-header"]}>
  <a class="brand" href={isDemo ? "/learninghub/demo" : "/"}>
    <img src="/assets/brand/cognit-logo-horizontal.jpg" alt="Cognit" />
    <span><strong>Learning Hub</strong></span>
  </a>
  {isDemo && <nav class="perspectives" aria-label="Switch perspective">
    {perspectives.map((item) => <a href={`/learninghub/demo/${item}`} aria-current={demoPerspective === item ? "page" : undefined}>{names[item]}</a>)}
  </nav>}
  {isDemo && currentProfile && <details class="profile-menu">
    <summary><span class="avatar" aria-hidden="true">{currentProfile[0].slice(0, 1)}</span><span><b>{currentProfile[0]}</b><small>{currentProfile[1]}</small></span></summary>
    <nav aria-label={`${names[demoPerspective]} profile menu`}>
      <a href={`/learninghub/demo/${demoPerspective}`}>Overview</a>
      {demoPerspective !== "student" && <a href={`/learninghub/demo/${demoPerspective}/support`}>Support</a>}
    </nav>
  </details>}
</header>

<style>
  .site-header{min-height:88px;border-bottom:1px solid var(--color-border);background:#fff;display:flex;align-items:center;gap:22px;padding:12px max(24px,calc((100vw - 1360px)/2));position:relative;z-index:20}.brand{display:flex;align-items:center;gap:16px;flex:0 0 auto}.brand img{width:210px;height:58px;object-fit:contain}.brand span{padding-left:16px;border-left:2px solid var(--cognit-brand-progress);color:var(--color-ink)}.perspectives{margin-left:auto;display:flex;align-items:center;gap:4px;padding:6px;border:1px solid var(--color-border);border-radius:999px}.perspectives span{padding:0 10px;color:var(--color-muted);font-size:.72rem;font-weight:900;text-transform:uppercase}.perspectives a{min-height:42px;display:grid;place-items:center;padding:7px 15px;border-radius:999px;color:var(--color-ink);font-weight:900}.perspectives a[aria-current="page"]{background:var(--color-ink);color:#fff}.profile-menu{position:relative}.profile-menu summary{display:flex;align-items:center;gap:9px;cursor:pointer;list-style:none}.profile-menu summary::-webkit-details-marker{display:none}.profile-menu small{display:block;color:var(--color-muted);font-size:.72rem}.avatar{display:grid;width:38px;height:38px;place-items:center;border-radius:50%;background:var(--color-ink);color:#fff;font-weight:900}.profile-menu nav{position:absolute;right:0;top:calc(100% + 12px);display:grid;width:180px;padding:8px;border:1px solid var(--color-border);border-radius:12px;background:#fff;box-shadow:var(--shadow-card)}.profile-menu nav a{padding:10px 12px;border-radius:8px;font-weight:800}.profile-menu nav a:hover{background:var(--color-sky)}@media(max-width:900px){.site-header{min-height:72px;padding:10px 16px;flex-wrap:wrap}.brand img{width:154px;height:44px}.brand span{display:none}.perspectives{order:3;width:100%;overflow-x:auto;border-radius:12px}.perspectives span{display:none}.perspectives a{flex:1;min-width:max-content;padding-inline:12px}.profile-menu{margin-left:auto}}@media(max-width:480px){.perspectives a{font-size:.82rem}.profile-menu summary>span:last-child{display:none}}
</style>
