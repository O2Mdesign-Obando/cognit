---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
---
<BaseLayout title="Cognit Learning Hub">
  <main class="placeholder"><Container><span>Cognit Learning Hub</span><h1>Product page coming soon.</h1><a href="/learninghub/demo">Open the demo →</a></Container></main>
</BaseLayout>
<style>.placeholder{min-height:68vh;display:grid;place-items:center;padding:60px 0}.placeholder :global(.container){text-align:center}.placeholder span{color:var(--cognit-brand-progress);font-weight:950;text-transform:uppercase}.placeholder h1{margin:12px auto 28px}.placeholder a{display:inline-flex;padding:13px 20px;border-radius:999px;background:var(--color-ink);color:#fff;font-weight:900}</style>
