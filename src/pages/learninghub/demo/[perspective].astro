---
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import Container from "../../../components/ui/Container.astro";
import CognitDemoPerspective from "../../../components/demo/CognitDemoPerspective.astro";
import CognitStudentJourneyView from "../../../components/demo/CognitStudentJourneyView.astro";
import CognitFamilyJourneyView from "../../../components/demo/CognitFamilyJourneyView.astro";
import CognitHqView from "../../../components/demo/CognitHqView.astro";
import CognitCenterView from "../../../components/demo/CognitCenterView.astro";
import DemoLoopNav from "../../../components/demo/DemoLoopNav.astro";
import { getCognitDemoPerspectiveModel } from "../../../demo/cognit-demo-model.js";

const perspectives = {
  center: {
    label: "Center",
    title: "Run today’s learning operation.",
    body: "See what needs attention across schedules, learners, reporting, communication, and operational exceptions."
  },
  coach: {
    label: "Coach",
    title: "Move teaching forward.",
    body: "See today’s learners, learning plan, progress, observations, evidence, and reporting responsibilities."
  },
  student: {
    label: "Student",
    title: "Know what you’re working on next.",
    body: "See today’s learning, current progress, completed work, and what comes next."
  },
  family: {
    label: "Family",
    title: "Stay connected to the learning journey.",
    body: "See progress, attendance, messages, and published learning updates for the learner."
  },
  hq: {
    label: "HQ",
    title: "Steward the network by exception.",
    body: "Review network health, Center readiness, curriculum distribution, support, deployment, and module governance."
  }
};

export function getStaticPaths() {
  return ["center", "coach", "student", "family", "hq"].map((perspective) => ({ params: { perspective } }));
}

const selectedKey = Astro.params.perspective;
const selected = perspectives[selectedKey];
const model = selectedKey === "hq" ? null : getCognitDemoPerspectiveModel(selectedKey);
---

<BaseLayout title={`${selected.label} Demo · Cognit Learning Hub`} shellVariant="demo-shell" footerVariant="compact" demoPerspective={selectedKey}>
  <main class="demo-page">
    <Container>
      {selectedKey !== "student" && selectedKey !== "family" && selectedKey !== "hq" && selectedKey !== "center" && <DemoLoopNav role={selectedKey} active="today" />}

      {selectedKey !== "student" && selectedKey !== "family" && selectedKey !== "hq" && selectedKey !== "center" && <section class="demo-hero" aria-labelledby="demo-title" data-coach-arrival-hero={selectedKey === "coach" ? "true" : undefined}>
        <span class="eyebrow">{selected.label} perspective</span>
        <h1 id="demo-title">{selected.title}</h1>
        <p>{selected.body}</p>
      </section>}

      {selectedKey === "student" ? <CognitStudentJourneyView view="today" /> : selectedKey === "family" ? <CognitFamilyJourneyView view="overview" /> : selectedKey === "hq" ? <CognitHqView view="home" /> : selectedKey === "center" ? <CognitCenterView view="overview" /> : <CognitDemoPerspective model={model} />}

      <a class="back-link" href="/learninghub/demo">← All demo perspectives</a>
    </Container>
  </main>

  <style>
    .demo-page { min-height: 72vh; padding: clamp(34px, 6vw, 72px) 0 64px; }
    .demo-page :global(.container) { max-width: 1120px; }
    .demo-hero { max-width: 820px; padding: 10px 0 42px; }
    .demo-hero h1 { margin: 17px 0 14px; font-size: clamp(3rem, 6vw, 5.3rem); }
    .demo-hero > p { max-width: 62ch; font-size: 1.12rem; line-height: 1.65; }
    .demo-hero.is-receded {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .back-link { display: inline-flex; margin-top: 28px; color: var(--color-ink); font-weight: 900; text-decoration: underline; text-underline-offset: 4px; }
    @media (max-width: 560px) {
      .demo-hero { padding-top: 44px; }
    }
  </style>
</BaseLayout>
