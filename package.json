{
  "name": "cognit-learning-hub-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "demo2"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:demo2": "npm run dev --workspace demo2",
    "build:demo2": "npm run build --workspace demo2",
    "build": "npm run build:demo2 && astro build",
    "preview": "astro preview",
    "validate:routes": "node scripts/validate-built-routes.mjs",
    "validate:demo2": "node scripts/validate-demo2.mjs",
    "validate": "npm run build && npm run validate:routes && npm run validate:demo2"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.8",
    "astro": "7.2.3"
  },
  "overrides": {
    "@vercel/routing-utils": "6.5.0",
    "path-to-regexp": "6.3.0"
  }
}
